<Project Sdk="Microsoft.NET.Sdk">

  <!-- THROWAWAY SPIKE (drawers look and placement, plan task 0). Not in Sanduhr.slnx, not in CI, no
       reference to Sanduhr.*. Q1: blur behind a Desk-style layered window. Q2: reading desktop icon
       positions through IShellWindows / IFolderView. Run: the exe with blur, icons, windows or monitors -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PlatformTarget>x64</PlatformTarget>
    <NoWarn>$(NoWarn);WFO0003;CA1416</NoWarn>
  </PropertyGroup>

</Project>
