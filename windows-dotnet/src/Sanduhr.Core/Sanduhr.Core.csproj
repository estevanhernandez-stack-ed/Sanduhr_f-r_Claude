<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Shared internal parsing (ClaudeApiParsing) is consumed by the WebView2
       transport in the App assembly (AssemblyName=Sanduhr) and unit-tested
       directly by Sanduhr.Tests. -->
