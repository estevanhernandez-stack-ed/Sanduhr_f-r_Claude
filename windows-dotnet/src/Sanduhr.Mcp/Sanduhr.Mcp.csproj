<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>sanduhr-mcp</AssemblyName>
    <RootNamespace>Sanduhr.Mcp</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Rides the app's release train — bump with the widget so ping's
         server_version means something (the writer_version lesson from #53). -->
    <Version>3.6.0</Version>
  </PropertyGroup>

  <!-- How the server ships. Any publish with a runtime identifier (the App's
       PublishMcpServer target, or a direct dotnet publish -r) produces one
       self-contained, trimmed, single-file sanduhr-mcp.exe: the Store and
       Velopack app is self-contained, so the user's machine has no .NET runtime
       for a framework-dependent server. Declared here, not passed in, so the
       App's own restore already carries the ILLink pack. A RID-less build
       (dotnet build, the test projects) stays framework-dependent.
       Linker warnings are errors here: the trimmer removes System.Text.Json's
       reflection metadata, so any code path the analysis flags (the generic
       JsonArray.Add<T>, collection initializers on JsonArray) is a crash in the
       shipped exe, not a style note. See ToolCatalog for the rule the sources
       follow. The release runbook still runs the published exe cold. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Trust boundary BY CONSTRUCTION (WS-E design review must-fix #11): this
       project deliberately has NO reference to Sanduhr.Core. It source-links
       an allowlisted slice of Core files (TrustBoundaryTests pins the list), so CredentialStore /
       WindowsCredentialManager / the WebView2 transport are not merely unused —
       they are not part of the compilation. The cert letter's "cannot touch
       credentials" claim is structural. A test pins this file's link list to
       the allowlist; widening it is a design decision, not a convenience. -->
  <ItemGroup>
    <Compile Include="..\Sanduhr.Core\SnapshotContract.cs" Link="Core\SnapshotContract.cs" />
    <Compile Include="..\Sanduhr.Core\Pacing.cs" Link="Core\Pacing.cs" />
    <Compile Include="..\Sanduhr.Core\TierModel.cs" Link="Core\TierModel.cs" />
    <Compile Include="..\Sanduhr.Core\CcLogReader.cs" Link="Core\CcLogReader.cs" />
    <!-- Root discovery (2026-10-11 ruling, decision 6h5YrnXr0YVjPqlqqi8i): folder names
         under the profile matching .claude / .claude-*. BCL IO + System.Text.Json, no
         credentials, no network. A root still counts only when mcp_roots consents to it. -->
    <Compile Include="..\Sanduhr.Core\ClaudeCodeHomes.cs" Link="Core\ClaudeCodeHomes.cs" />
    <!-- propose_theme: the lint (pure) and the theme model it builds. No IO, no
         credentials; the widget still owns every write under the themes folder. -->
    <Compile Include="..\Sanduhr.Core\ThemeModel.cs" Link="Core\ThemeModel.cs" />
    <Compile Include="..\Sanduhr.Core\ThemeLint.cs" Link="Core\ThemeLint.cs" />
    <!-- Vault slice (abilities wave): READ-ONLY by tool construction. The design
         review's drift watchlist bans MCP-side vault WRITES; VaultStore's write
         methods ride along with the type but have zero call sites in this
         project — the tool surface exposes reads only, proven by cold verify. -->
    <Compile Include="..\Sanduhr.Core\VaultModels.cs" Link="Core\VaultModels.cs" />
    <Compile Include="..\Sanduhr.Core\VaultStore.cs" Link="Core\VaultStore.cs" />
    <Compile Include="..\Sanduhr.Core\VaultJson.cs" Link="Core\VaultJson.cs" />
    <Compile Include="..\Sanduhr.Core\VaultReader.cs" Link="Core\VaultReader.cs" />
    <!-- Watchers and Desk messages (3.6.0, Este's ruling 2026-10-21): the five tools
         watch_start, watch_update, watch_end, propose_desk_messages and get_desk_messages
         validate with the widget's own code so server and widget agree byte for byte. Six
         files, all pure (text, JSON, regex; no IO, no network, no credentials, no process):
         Watchers + WatcherRequest (the limits, the commands, the request and switch file
         shapes), MessageProposal + DeskMessages + MessageEffects + LetterMap (the line
         checks, the request decode, the "today" pick). The widget owns every write that
         matters (messages.txt, the board); the server queues request files only, as
         propose_theme does. -->
    <Compile Include="..\Sanduhr.Core\Watchers.cs" Link="Core\Watchers.cs" />
    <Compile Include="..\Sanduhr.Core\WatcherRequest.cs" Link="Core\WatcherRequest.cs" />
    <Compile Include="..\Sanduhr.Core\MessageProposal.cs" Link="Core\MessageProposal.cs" />
    <Compile Include="..\Sanduhr.Core\DeskMessages.cs" Link="Core\DeskMessages.cs" />
    <Compile Include="..\Sanduhr.Core\MessageEffects.cs" Link="Core\MessageEffects.cs" />
    <Compile Include="..\Sanduhr.Core\LetterMap.cs" Link="Core\LetterMap.cs" />
  </ItemGroup>

</Project>
