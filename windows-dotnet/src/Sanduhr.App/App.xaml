<Application x:Class="Sanduhr.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Sanduhr.App"
             xmlns:vm="clr-namespace:Sanduhr.App.ViewModels"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Theme brushes are injected at startup by ThemePalette.Apply so the
             palette stays swappable (item 8). DynamicResource lookups resolve
             against these at render time. -->

        <!-- Shared theme swatch tile — used by BOTH the widget's quick-switch grid
             (below the title bar) and Settings → Themes, so the two render
             identically and bind to the SAME Themes collection (switching in one
             reflects the active highlight in the other). Each tile previews its
             theme in the theme's OWN colors: a glass fill, an accent stripe + chip,
             and the name in the theme's text color. The active tile gets an accent
             ring; hover previews the ring. Click → ApplyCommand (live re-tint +
             persist + soft chime via the widget VM). -->
        <DataTemplate x:Key="ThemeSwatchTemplate" DataType="{x:Type vm:ThemeStripItemViewModel}">
            <Button Command="{Binding ApplyCommand}" Cursor="Hand" ToolTip="{Binding Name}"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <!-- ring: the accent highlight (transparent at rest, accent on
                             hover + active). -->
                        <Border x:Name="ring" CornerRadius="9" Margin="3" Padding="2"
                                BorderThickness="2" BorderBrush="Transparent" Background="Transparent">
                            <!-- tile: the theme's glass surface in its own colors. -->
                            <Border x:Name="tile" CornerRadius="6" Width="172" Height="38"
                                    Background="{Binding GlassBrush}"
                                    BorderBrush="{Binding PreviewBorder}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- accent stripe down the left edge -->
                                    <Border Grid.Column="0" Background="{Binding AccentBrush}"
                                            CornerRadius="6,0,0,6" />
                                    <!-- name in the theme's own text color -->
                                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                                               Foreground="{Binding TextBrush}"
                                               VerticalAlignment="Center" Margin="9,0,6,0"
                                               FontSize="12" FontWeight="Medium"
                                               TextTrimming="CharacterEllipsis" />
                                    <!-- accent chip -->
                                    <Border Grid.Column="2" Width="11" Height="11" CornerRadius="6"
                                            Background="{Binding AccentBrush}"
                                            VerticalAlignment="Center" Margin="0,0,9,0" />
                                </Grid>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ring" Property="BorderBrush" Value="{Binding AccentBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="ring" Property="BorderBrush" Value="{Binding AccentBrush}" />
                                <Setter TargetName="tile" Property="BorderBrush" Value="{Binding AccentBrush}" />
                                <Setter TargetName="tile" Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
    </Application.Resources>
</Application>
