<Window x:Class="Sanduhr.App.Views.IntegrationConsentDialog"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sanduhr" Width="480" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        AutomationProperties.Name="Confirm a change in a Claude Code folder">
    <Window.Resources>
        <Style x:Key="ConsentRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Sanduhr.Brush.Text}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="box" Width="16" Height="16" CornerRadius="8"
                                    VerticalAlignment="Center" Margin="0,0,8,0"
                                    Background="{DynamicResource Sanduhr.Brush.Bg}"
                                    BorderBrush="{DynamicResource Sanduhr.Brush.Border}" BorderThickness="1">
                                <Ellipse x:Name="dot" Width="8" Height="8" Visibility="Collapsed"
                                         Fill="{DynamicResource Sanduhr.Brush.Accent}" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="dot" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush"
                                        Value="{DynamicResource Sanduhr.Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ConsentCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Sanduhr.Brush.Text}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="box" Width="16" Height="16" CornerRadius="3"
                                    VerticalAlignment="Center" Margin="0,0,8,0"
                                    Background="{DynamicResource Sanduhr.Brush.Bg}"
                                    BorderBrush="{DynamicResource Sanduhr.Brush.Border}" BorderThickness="1">
                                <Path x:Name="check" Stretch="Uniform" Margin="2"
                                      Data="M0,5 L4,9 L11,0" Visibility="Collapsed"
                                      Stroke="{DynamicResource Sanduhr.Brush.Accent}" StrokeThickness="2" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush"
                                        Value="{DynamicResource Sanduhr.Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border CornerRadius="10" Background="{DynamicResource Sanduhr.Brush.Bg}"
            BorderBrush="{DynamicResource Sanduhr.Brush.Border}" BorderThickness="1" Padding="20">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Border Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center"
                        Margin="0,0,10,0" Background="{DynamicResource Sanduhr.Brush.Accent}" />
                <TextBlock x:Name="TitleText" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                           Foreground="{DynamicResource Sanduhr.Brush.Text}" />
            </StackPanel>
            <TextBlock x:Name="IntroText" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"
                       Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
            <TextBlock x:Name="FolderText" TextWrapping="Wrap" FontSize="11.5" Margin="0,0,0,10"
                       FontFamily="Cascadia Code, Consolas"
                       Foreground="{DynamicResource Sanduhr.Brush.Text}" />
            <StackPanel x:Name="ExistingPanel" Margin="0,0,0,10" Visibility="Collapsed">
                <TextBlock x:Name="ExistingText" TextWrapping="Wrap" FontSize="11.5" Margin="0,0,0,8"
                           FontFamily="Cascadia Code, Consolas"
                           Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                <RadioButton x:Name="ReplaceRadio" GroupName="mode" Style="{StaticResource ConsentRadio}" IsChecked="True"
                             Content="Replace it with Sanduhr's meters."
                             AutomationProperties.Name="Replace the existing statusline"
                             Checked="OnModeChanged" />
                <RadioButton x:Name="CombineRadio" GroupName="mode" Style="{StaticResource ConsentRadio}"
                             Content="Keep it and add Sanduhr's meters."
                             AutomationProperties.Name="Combine with the existing statusline"
                             Checked="OnModeChanged" />
            </StackPanel>
            <StackPanel x:Name="SegmentsPanel" Margin="0,0,0,10" Visibility="Collapsed">
                <TextBlock Text="Meters to show" FontSize="11" Margin="0,0,0,6"
                           Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                <StackPanel Orientation="Horizontal">
                    <CheckBox x:Name="SessionBox" Content="Session" IsChecked="True" Style="{StaticResource ConsentCheckBox}"
                              Margin="0,0,16,6" AutomationProperties.Name="Show the session meter" />
                    <CheckBox x:Name="WeeklyBox" Content="Weekly" IsChecked="True" Style="{StaticResource ConsentCheckBox}"
                              Margin="0,0,16,6" AutomationProperties.Name="Show the weekly meter" />
                    <CheckBox x:Name="ResetsBox" Content="Weekly reset" IsChecked="True" Style="{StaticResource ConsentCheckBox}"
                              Margin="0,0,0,6" AutomationProperties.Name="Show the weekly reset time" />
                </StackPanel>
                <StackPanel x:Name="JoinPanel" Visibility="Collapsed" Margin="0,4,0,0">
                    <TextBlock Text="Where Sanduhr's meters go" FontSize="11" Margin="0,0,0,6"
                               Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                    <RadioButton x:Name="LineRadio" GroupName="join" Style="{StaticResource ConsentRadio}" IsChecked="True"
                                 Content="On its own line" AutomationProperties.Name="Put Sanduhr's meters on their own line" />
                    <RadioButton x:Name="SameRadio" GroupName="join" Style="{StaticResource ConsentRadio}"
                                 Content="On the same line" AutomationProperties.Name="Put Sanduhr's meters on the same line" />
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="DetailsText" TextWrapping="Wrap" FontSize="10.5" Margin="0,0,0,14"
                       Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="NotNowButton" Content="Not now" MinWidth="80" Height="30"
                        Margin="0,0,8,0" Cursor="Hand"
                        Foreground="{DynamicResource Sanduhr.Brush.Text}"
                        Background="{DynamicResource Sanduhr.Brush.Glass}"
                        BorderBrush="{DynamicResource Sanduhr.Brush.Border}"
                        AutomationProperties.Name="Cancel, change nothing"
                        Click="OnNotNowClick" />
                <Button x:Name="ConfirmButton" Content="Install" MinWidth="100" Height="30" Cursor="Hand"
                        Foreground="{DynamicResource Sanduhr.Brush.Bg}"
                        Background="{DynamicResource Sanduhr.Brush.Accent}"
                        BorderThickness="0"
                        Click="OnConfirmClick" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
