<Window x:Class="Sanduhr.App.Views.ThemedDialog"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Width="430"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        UseLayoutRounding="True">
    <Border CornerRadius="10"
            Background="{DynamicResource Sanduhr.Brush.GlassChrome}"
            BorderBrush="{DynamicResource Sanduhr.Brush.Border}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="2" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Accent strip, matching the widget's title bar. -->
            <Border Grid.Row="0" CornerRadius="10,10,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="{DynamicResource Sanduhr.Color.Accent}" />
                        <GradientStop Offset="1" Color="{DynamicResource Sanduhr.Color.AccentFade}" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20,18,20,0">
                <Border x:Name="KindDot" Width="10" Height="10" CornerRadius="5"
                        Margin="0,0,10,0" VerticalAlignment="Center"
                        Background="{DynamicResource Sanduhr.Brush.Accent}" />
                <TextBlock x:Name="TitleText" Text="" FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Sanduhr.Brush.Text}" />
            </StackPanel>

            <TextBlock Grid.Row="2" x:Name="MessageText" Text="" TextWrapping="Wrap"
                       Margin="20,12,20,4" FontSize="12" LineHeight="18"
                       Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="20,18,20,18">
                <Button x:Name="SecondaryButton" Content="No" Click="OnSecondaryClick"
                        IsCancel="True" Visibility="Collapsed" Cursor="Hand"
                        Padding="18,7" Margin="0,0,8,0" BorderThickness="1"
                        Background="#1c1c1c"
                        Foreground="{DynamicResource Sanduhr.Brush.Text}"
                        BorderBrush="{DynamicResource Sanduhr.Brush.Border}" />
                <Button x:Name="PrimaryButton" Content="OK" Click="OnPrimaryClick"
                        IsDefault="True" Cursor="Hand" Padding="22,7" BorderThickness="0"
                        FontWeight="SemiBold" Foreground="#0d0d0d"
                        Background="{DynamicResource Sanduhr.Brush.Accent}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
