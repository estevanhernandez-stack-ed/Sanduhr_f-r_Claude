<Window x:Class="Sanduhr.App.Views.ThemedDialog"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Width="430"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        UseLayoutRounding="True">
    <Window.Resources>
        <!-- The dialog's secondary and tertiary buttons: the look they had inline at rest, plus hover and press in GlassHover (press also
             rings 1 px in Accent), a keyboard ring, and a disabled look. The primary keeps its own look. -->
        <Style x:Key="DialogFlatButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Sanduhr.Brush.Text}" />
            <Setter Property="Background" Value="{DynamicResource Sanduhr.Brush.Glass}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Sanduhr.Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource Sanduhr.Brush.GlassHover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource Sanduhr.Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource Sanduhr.Brush.GlassHover}" />
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource Sanduhr.Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border CornerRadius="10"
            Background="{DynamicResource Sanduhr.Brush.GlassChrome}"
            BorderBrush="{DynamicResource Sanduhr.Brush.Border}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="2" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Accent strip, matching the widget's title bar. -->
            <Border Grid.Row="0" CornerRadius="10,10,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="{DynamicResource Sanduhr.Color.Accent}" />
                        <GradientStop Offset="1" Color="{DynamicResource Sanduhr.Color.AccentFade}" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20,18,20,0">
                <Border x:Name="KindDot" Width="10" Height="10" CornerRadius="5"
                        Margin="0,0,10,0" VerticalAlignment="Center"
                        Background="{DynamicResource Sanduhr.Brush.Accent}" />
                <TextBlock x:Name="TitleText" Text="" FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Sanduhr.Brush.Text}" />
            </StackPanel>

            <TextBlock Grid.Row="2" x:Name="MessageText" Text="" TextWrapping="Wrap"
                       Margin="20,12,20,4" FontSize="12" LineHeight="18"
                       Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="20,18,20,18">
                <Button x:Name="TertiaryButton" Content="Cancel" Click="OnTertiaryClick"
                        Visibility="Collapsed" Cursor="Hand"
                        Style="{StaticResource DialogFlatButton}" Margin="0,0,8,0" />
                <Button x:Name="SecondaryButton" Content="No" Click="OnSecondaryClick"
                        IsCancel="True" Visibility="Collapsed" Cursor="Hand"
                        Style="{StaticResource DialogFlatButton}" Margin="0,0,8,0" />
                <Button x:Name="PrimaryButton" Content="OK" Click="OnPrimaryClick"
                        IsDefault="True" Cursor="Hand" Padding="22,7" BorderThickness="0"
                        FontWeight="SemiBold" Foreground="#0d0d0d"
                        Background="{DynamicResource Sanduhr.Brush.Accent}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
