<Window x:Class="Sanduhr.App.Views.SignInWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Sign in to Claude"
        Height="720" Width="1040"
        WindowStartupLocation="CenterScreen"
        Background="#0d0d0d"
        Icon="/Assets/Sanduhr.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: branded reassurance copy. The 626 cyan->magenta pairing. -->
        <Border Grid.Row="0" Background="#161616" Padding="16,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="10" Height="10" CornerRadius="5" Margin="0,0,8,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="#17d4fa" />
                                <GradientStop Offset="1" Color="#f22f89" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <TextBlock Text="Sign in to Claude"
                               FontSize="14" FontWeight="Bold"
                               Foreground="#17d4fa" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock FontSize="11"
                           Foreground="#e8e4dc"
                           Opacity="0.9"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap">
                    <Run Text="Your password goes only to " />
                    <Run Text="claude.ai" FontWeight="Bold" />
                    <Run Text=" over HTTPS, inside this embedded browser. Sanduhr never sees it." />
                </TextBlock>
                <TextBlock FontSize="11"
                           Foreground="#e8e4dc"
                           Opacity="0.65"
                           Margin="0,2,0,0"
                           TextWrapping="Wrap">
                    <Run Text="Once you're signed in, Sanduhr reads only the session cookie Claude sets, stores it in the Windows Credential Manager, and starts tracking your usage. This window closes itself." />
                </TextBlock>
                <TextBlock FontSize="11"
                           Foreground="#e8e4dc"
                           Opacity="0.65"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap"
                           Text="Signed up with Google? Use email login instead — choose &quot;Continue with email&quot; and enter the sign-in code Anthropic emails you. It works right here." />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Google-OAuth notice docks ABOVE the browser in its own row. A WPF
                 overlay can't paint on top of the native WebView2 control (airspace),
                 so the banner must occupy real layout space rather than overlap —
                 otherwise it renders behind the page and is invisible. -->
            <Border x:Name="GoogleNotice" Grid.Row="0" Background="#241a00"
                    BorderBrush="#7a5b00" BorderThickness="0,0,0,1" Padding="14,10"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Google sign-in won't load here — use email login instead"
                               Foreground="#ffcf4d" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#e8e4dc" Opacity="0.85"
                               Margin="0,4,0,8"
                               Text="Google blocks sign-in inside embedded windows. Instead, go back and choose &quot;Continue with email&quot; with your Gmail address — Anthropic emails you a sign-in code. Type that code right here and you're in. Same account, nothing changes." />
                    <Button Content="Back to Claude sign-in" Click="OnGoogleNoticeBackClick"
                            HorizontalAlignment="Left" Cursor="Hand" Padding="12,6" FontWeight="SemiBold"
                            Background="#17d4fa" Foreground="#0d0d0d" BorderThickness="0" />
                    <!-- Demoted last-resort link — same underlined-TextBlock-in-a-Button
                         template used for the secondary auth action in MainWindow.xaml,
                         just kept on this file's own literal dark palette since this
                         window isn't wired into the app's DynamicResource theme brushes. -->
                    <Button Content="paste a session key by hand instead" Click="OnGoogleNoticePasteClick"
                            HorizontalAlignment="Left" Cursor="Hand" Margin="0,8,0,0"
                            Background="Transparent" BorderThickness="0" Padding="0"
                            Foreground="#e8e4dc" FontSize="11">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <TextBlock Text="{TemplateBinding Content}"
                                           TextDecorations="Underline"
                                           Opacity="0.65"
                                           Foreground="{TemplateBinding Foreground}" />
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1">
                <wv:WebView2 x:Name="WebView" />

                <!-- Loading overlay; hidden once claude.ai first paints. Covers the
                     slow CoreWebView2Environment.CreateAsync + EnsureCoreWebView2Async
                     + first Navigate window. -->
                <Border x:Name="LoadingOverlay" Background="#0d0d0d">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Loading claude.ai…"
                                   Foreground="#17d4fa"
                                   FontSize="14" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,12" />
                        <ProgressBar IsIndeterminate="True"
                                     Width="220" Height="4"
                                     Foreground="#17d4fa"
                                     Background="#1c1c1c"
                                     BorderThickness="0" />
                        <TextBlock Text="First open can take a few seconds on a fresh WebView2 install."
                                   Foreground="#e8e4dc"
                                   Opacity="0.55"
                                   FontSize="11"
                                   Margin="0,12,0,0"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="320" />
                    </StackPanel>
                </Border>

                <!-- Error panel: shown when the first load fails or times out. The WebView
                     is collapsed when this shows (airspace), so the panel is visible. -->
                <Border x:Name="ErrorPanel" Background="#0d0d0d" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                        <TextBlock Text="Couldn't load the sign-in page"
                                   Foreground="#f22f89" FontSize="14" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock x:Name="ErrorMessage"
                                   Text="Check your connection and try again."
                                   Foreground="#e8e4dc" Opacity="0.8" FontSize="12"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   HorizontalAlignment="Center" Margin="0,0,0,16" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="Try again" Click="OnTryAgainClick"
                                    Cursor="Hand" Padding="18,8" Margin="0,0,8,0"
                                    Foreground="#0d0d0d" Background="#17d4fa" BorderThickness="0" />
                            <Button Content="Paste a key instead" Click="OnPasteInsteadClick"
                                    Cursor="Hand" Padding="18,8"
                                    Foreground="#e8e4dc" Background="#1c1c1c" BorderThickness="0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
