<UserControl x:Class="Sanduhr.App.Views.DrawersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Sanduhr.App.Views"
             xmlns:core="clr-namespace:Sanduhr.Core;assembly=Sanduhr.Core"
             Focusable="False">
    <!-- Settings, Drawers (5.0 drawers spec): on and off, where files live, Sort my desktop now, the rules, the drawers and the recent moves.
         Hosted in SettingsWindow. DataContext: the DrawersSettingsViewModel. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />
    </UserControl.Resources>
    <Border Background="{DynamicResource Sanduhr.Brush.Glass}" CornerRadius="8">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimThemeScrollBar}" />
            </ScrollViewer.Resources>
            <StackPanel x:Name="PageBody" Margin="20">
                <TextBlock Text="{x:Static core:SettingsNames.DrawersTitle}" FontSize="14" FontWeight="SemiBold"
                           AutomationProperties.HeadingLevel="Level1"
                           Foreground="{DynamicResource Sanduhr.Brush.Text}" Margin="0,0,0,12" />
                <views:StreamerBanner />
                <TextBlock Text="{x:Static core:SettingsNames.DrawersLine}" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" Margin="0,-8,0,12" />

                <!-- On and off. -->
                <StackPanel views:SettingsAnchor.Id="drawers">
                    <CheckBox Style="{DynamicResource ThemedCheckBox}" Content="{x:Static core:SettingsNames.DrawersSwitch}"
                              IsChecked="{Binding Enabled, Mode=TwoWay}"
                              AutomationProperties.Name="{x:Static core:SettingsNames.DrawersSwitch}" />
                    <TextBlock Text="{x:Static core:SettingsNames.DrawersSwitchCaption}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                               Foreground="{DynamicResource Sanduhr.Brush.TextDim}" />
                    <TextBlock Text="{Binding Status}" FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0"
                               Foreground="{DynamicResource Sanduhr.Brush.Text}" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="{x:Static core:SettingsNames.DrawersStoreNote}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                               Foreground="{DynamicResource Sanduhr.Brush.TextDim}"
                               Visibility="{Binding StoreNoteVisible, Converter={StaticResource BoolVis}}" />
                </StackPanel>

                <Border Height="1" Background="{DynamicResource Sanduhr.Brush.Border}" Margin="0,16,0,16" />

                <!-- Where drawer files live. -->
                <StackPanel views:SettingsAnchor.Id="drawers-folder">
                    <TextBlock Text="{x:Static core:SettingsNames.DrawersFolder}" FontSize="13" FontWeight="SemiBold"
                               AutomationProperties.HeadingLevel="Level2"
                               Foreground="{DynamicResource Sanduhr.Brush.Text}" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding RootText}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                    <TextBlock Text="{x:Static core:SettingsNames.DrawersFolderLocked}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                               Foreground="{DynamicResource Sanduhr.Brush.TextDim}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanChangeRoot}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Style="{DynamicResource FlatButton}" Padding="12,6" Margin="0,8,0,0" HorizontalAlignment="Left"
                            Content="{x:Static core:SettingsNames.DrawersChangeFolder}"
                            Command="{Binding ChangeRootCommand}" IsEnabled="{Binding CanChangeRoot}"
                            AutomationProperties.Name="{x:Static core:SettingsNames.DrawersChangeFolder}" />
                </StackPanel>

                <Border Height="1" Background="{DynamicResource Sanduhr.Brush.Border}" Margin="0,16,0,16" />

                <!-- Sort my desktop now. -->
                <StackPanel views:SettingsAnchor.Id="drawers-sort">
                    <TextBlock Text="{x:Static core:SettingsNames.DrawersSort}" FontSize="13" FontWeight="SemiBold"
                               AutomationProperties.HeadingLevel="Level2"
                               Foreground="{DynamicResource Sanduhr.Brush.Text}" Margin="0,0,0,8" />
                    <TextBlock Text="{x:Static core:SettingsNames.DrawersSortCaption}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                    <Button Style="{DynamicResource FlatButton}" Padding="12,6" Margin="0,8,0,0" HorizontalAlignment="Left"
                            Content="{x:Static core:SettingsNames.DrawersSortButton}"
                            Command="{Binding SortNowCommand}" IsEnabled="{Binding Enabled}"
                            AutomationProperties.Name="{x:Static core:SettingsNames.DrawersSortButton}" />
                </StackPanel>

                <Border Height="1" Background="{DynamicResource Sanduhr.Brush.Border}" Margin="0,16,0,16" />

                <!-- The drawers' look, snapping, keeping clear of desktop icons and Tidy. -->
                <StackPanel views:SettingsAnchor.Id="drawers-look">
                    <TextBlock Text="{x:Static core:SettingsNames.DrawersLook}" FontSize="13" FontWeight="SemiBold"
                               AutomationProperties.HeadingLevel="Level2"
                               Foreground="{DynamicResource Sanduhr.Brush.Text}" Margin="0,0,0,8" />
                    <ComboBox Style="{DynamicResource ThemedComboBox}" Width="200" HorizontalAlignment="Left"
                              ItemsSource="{x:Static core:SettingsNames.DrawersLookWords}" SelectedIndex="{Binding LookIndex, Mode=TwoWay}"
                              AutomationProperties.Name="{x:Static core:SettingsNames.DrawersLook}" />
                    <Grid Margin="0,10,0,0" Visibility="{Binding ShowOpacity, Converter={StaticResource BoolVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static core:SettingsNames.DrawersOpacity}" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                        <Slider Grid.Column="1" Style="{DynamicResource ThemedSlider}"
                                Minimum="20" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                SmallChange="1" LargeChange="10" Value="{Binding Opacity, Mode=TwoWay}"
                                AutomationProperties.Name="{x:Static core:SettingsNames.DrawersOpacity}" />
                        <TextBlock Grid.Column="2" Text="{Binding OpacityText}"
                                   FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource Sanduhr.Brush.TextDim}" FontFamily="Cascadia Code, Consolas" />
                    </Grid>
                    <CheckBox Style="{DynamicResource ThemedCheckBox}" Margin="0,12,0,0" Content="{x:Static core:SettingsNames.DrawersSnap}"
                              IsChecked="{Binding Snap, Mode=TwoWay}"
                              AutomationProperties.Name="{x:Static core:SettingsNames.DrawersSnap}" />
                    <TextBlock Text="{x:Static core:SettingsNames.DrawersSnapHint}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                               Foreground="{DynamicResource Sanduhr.Brush.TextDim}" />
                    <CheckBox Style="{DynamicResource ThemedCheckBox}" Margin="0,10,0,0" Content="{x:Static core:SettingsNames.DrawersKeepClear}"
                              IsChecked="{Binding KeepClear, Mode=TwoWay}"
                              AutomationProperties.Name="{x:Static core:SettingsNames.DrawersKeepClear}" />
                    <WrapPanel Margin="0,12,0,0">
                        <TextBlock Text="{x:Static core:SettingsNames.DrawersTidyCorner}" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" Margin="0,0,6,4" />
                        <ComboBox Style="{DynamicResource ThemedComboBox}" Width="130" Margin="0,0,12,4"
                                  ItemsSource="{x:Static core:SettingsNames.DrawersTidyCornerWords}" SelectedIndex="{Binding TidyCornerIndex, Mode=TwoWay}"
                                  AutomationProperties.Name="{x:Static core:SettingsNames.DrawersTidyCorner}" />
                        <TextBlock Text="{x:Static core:SettingsNames.DrawersTidyFlow}" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" Margin="0,0,6,4" />
                        <ComboBox Style="{DynamicResource ThemedComboBox}" Width="100" Margin="0,0,12,4"
                                  ItemsSource="{x:Static core:SettingsNames.DrawersTidyFlowWords}" SelectedIndex="{Binding TidyFlowIndex, Mode=TwoWay}"
                                  AutomationProperties.Name="{x:Static core:SettingsNames.DrawersTidyFlow}" />
                        <Button Style="{DynamicResource FlatButton}" Padding="12,6" Margin="0,0,0,4"
                                Content="{x:Static core:SettingsNames.DrawersTidy}" Command="{Binding TidyCommand}"
                                AutomationProperties.Name="{x:Static core:SettingsNames.DrawersTidy}" />
                    </WrapPanel>
                </StackPanel>

                <Border Height="1" Background="{DynamicResource Sanduhr.Brush.Border}" Margin="0,16,0,16" />

                <!-- The rules. -->
                <StackPanel views:SettingsAnchor.Id="drawers-rules">
                    <TextBlock Text="{x:Static core:SettingsNames.DrawersRules}" FontSize="13" FontWeight="SemiBold"
                               AutomationProperties.HeadingLevel="Level2"
                               Foreground="{DynamicResource Sanduhr.Brush.Text}" Margin="0,0,0,8" />
                    <TextBlock Text="{x:Static core:SettingsNames.DrawersRulesCaption}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                               Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                    <ItemsControl ItemsSource="{Binding Rules}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <Button DockPanel.Dock="Right" Style="{DynamicResource FlatButton}" Padding="8,4" Margin="4,0,0,0"
                                            Content="{x:Static core:SettingsNames.DrawersDelete}" Command="{Binding DeleteCommand}" AutomationProperties.Name="{Binding DeleteName}" />
                                    <Button DockPanel.Dock="Right" Style="{DynamicResource FlatButton}" Padding="8,4" Margin="4,0,0,0"
                                            Content="{x:Static core:SettingsNames.DrawersDown}" Command="{Binding MoveDownCommand}" AutomationProperties.Name="{Binding DownName}" />
                                    <Button DockPanel.Dock="Right" Style="{DynamicResource FlatButton}" Padding="8,4" Margin="4,0,0,0"
                                            Content="{x:Static core:SettingsNames.DrawersUp}" Command="{Binding MoveUpCommand}" AutomationProperties.Name="{Binding UpName}" />
                                    <TextBox DockPanel.Dock="Right" Style="{DynamicResource Input}" Width="48" Margin="4,0,0,0" MaxLength="4"
                                             Text="{Binding Days, UpdateSourceTrigger=LostFocus}"
                                             Visibility="{Binding HasDays, Converter={StaticResource BoolVis}}"
                                             AutomationProperties.Name="{Binding DaysName}" />
                                    <CheckBox Style="{DynamicResource ThemedCheckBox}" Content="{Binding Label}"
                                              IsChecked="{Binding On, Mode=TwoWay}" AutomationProperties.Name="{Binding Label}"
                                              VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DockPanel Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right" Style="{DynamicResource FlatButton}" Padding="12,6" Margin="6,0,0,0"
                                Content="{x:Static core:SettingsNames.DrawersAddRule}" Command="{Binding AddNameRuleCommand}"
                                AutomationProperties.Name="{x:Static core:SettingsNames.DrawersAddRule}" />
                        <TextBox DockPanel.Dock="Right" Style="{DynamicResource Input}" Width="120" Margin="6,0,0,0" MaxLength="40"
                                 Text="{Binding NewRuleDrawer, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Drawer for the new rule" />
                        <TextBox Style="{DynamicResource Input}" Text="{Binding NewRuleText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Name contains" />
                    </DockPanel>
                </StackPanel>

                <Border Height="1" Background="{DynamicResource Sanduhr.Brush.Border}" Margin="0,16,0,16" />

                <!-- The drawers. -->
                <StackPanel views:SettingsAnchor.Id="drawers-list">
                    <TextBlock Text="{x:Static core:SettingsNames.DrawersList}" FontSize="13" FontWeight="SemiBold"
                               AutomationProperties.HeadingLevel="Level2"
                               Foreground="{DynamicResource Sanduhr.Brush.Text}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding DrawerRows}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,3">
                                    <Button DockPanel.Dock="Right" Style="{DynamicResource FlatButton}" Padding="8,4" Margin="4,0,0,0"
                                            Content="{x:Static core:SettingsNames.DrawersRemove}" Command="{Binding RemoveCommand}" AutomationProperties.Name="{Binding RemoveName}" />
                                    <Button DockPanel.Dock="Right" Style="{DynamicResource FlatButton}" Padding="8,4" Margin="4,0,0,0"
                                            Content="{x:Static core:SettingsNames.DrawersRename}" Command="{Binding RenameCommand}" AutomationProperties.Name="{Binding RenameName}" />
                                    <TextBox DockPanel.Dock="Right" Style="{DynamicResource Input}" Width="140" Margin="4,0,0,0" MaxLength="40"
                                             Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="{Binding NewNameName}" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{DynamicResource Sanduhr.Brush.Text}" />
                                        <TextBlock Text="{Binding Kind}" FontSize="11" Foreground="{DynamicResource Sanduhr.Brush.TextDim}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel Margin="0,8,0,0">
                        <Button Style="{DynamicResource FlatButton}" Padding="12,6" Margin="0,0,8,4"
                                Content="{x:Static core:SettingsNames.DrawersShow}" Command="{Binding ShowDrawersCommand}"
                                AutomationProperties.Name="{x:Static core:SettingsNames.DrawersShow}" />
                        <Button Style="{DynamicResource FlatButton}" Padding="12,6" Margin="0,0,0,4"
                                Content="{x:Static core:SettingsNames.DrawersAddFolder}" Command="{Binding AddFolderCommand}"
                                AutomationProperties.Name="Show a folder as a drawer" />
                    </WrapPanel>
                </StackPanel>

                <Border Height="1" Background="{DynamicResource Sanduhr.Brush.Border}" Margin="0,16,0,16" />

                <!-- The last ten moves, with Undo. -->
                <StackPanel views:SettingsAnchor.Id="drawers-recent">
                    <TextBlock Text="{x:Static core:SettingsNames.DrawersRecent}" FontSize="13" FontWeight="SemiBold"
                               AutomationProperties.HeadingLevel="Level2"
                               Foreground="{DynamicResource Sanduhr.Brush.Text}" Margin="0,0,0,8" />
                    <TextBlock Text="{x:Static core:SettingsNames.DrawersNothingRecent}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource Sanduhr.Brush.TextDim}"
                               Visibility="{Binding NothingRecent, Converter={StaticResource BoolVis}}" />
                    <ItemsControl ItemsSource="{Binding Recent}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <Button DockPanel.Dock="Right" Style="{DynamicResource FlatButton}" Padding="8,4"
                                            Content="{x:Static core:SettingsNames.DrawersUndo}" Command="{Binding UndoCommand}" AutomationProperties.Name="{Binding UndoName}" />
                                    <TextBlock Text="{Binding Line}" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Sanduhr.Brush.Text}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
