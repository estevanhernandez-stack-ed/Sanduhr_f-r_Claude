<Window x:Class="Sanduhr.App.Views.WhatsNewWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ctl="clr-namespace:Sanduhr.App.Controls"
        xmlns:core="clr-namespace:Sanduhr.Core;assembly=Sanduhr.Core"
        Title="{Binding WindowTitle}"
        Width="640" Height="620"
        MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        Background="{DynamicResource Sanduhr.Brush.Bg}"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        UseLayoutRounding="True"
        Icon="/Assets/Sanduhr.ico">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />

        <!-- Same flat button and check box as Settings (those live in SettingsWindow's own resources). -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Sanduhr.Brush.Text}" />
            <Setter Property="Background" Value="{DynamicResource Sanduhr.Brush.Glass}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Sanduhr.Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource Sanduhr.Brush.GlassHover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource Sanduhr.Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemedCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Sanduhr.Brush.Text}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="box" Width="16" Height="16" CornerRadius="3"
                                    VerticalAlignment="Center" Margin="0,0,8,0"
                                    Background="{DynamicResource Sanduhr.Brush.Bg}"
                                    BorderBrush="{DynamicResource Sanduhr.Brush.Border}" BorderThickness="1">
                                <Path x:Name="check" Stretch="Uniform" Margin="2"
                                      Data="M0,5 L4,9 L11,0" Visibility="Collapsed"
                                      Stroke="{DynamicResource Sanduhr.Brush.Accent}" StrokeThickness="2" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Sanduhr.Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Sanduhr.Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The tour's choice: a themed radio, legible on the window's own surface in either Windows mode. -->
        <Style x:Key="ThemedRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Sanduhr.Brush.Text}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="ring" Width="14" Height="14" CornerRadius="7" Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource Sanduhr.Brush.Bg}"
                                    BorderBrush="{DynamicResource Sanduhr.Brush.Border}" BorderThickness="1">
                                <Ellipse x:Name="dot" Width="6" Height="6" Visibility="Collapsed"
                                         Fill="{DynamicResource Sanduhr.Brush.Accent}" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="dot" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource Sanduhr.Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource Sanduhr.Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ring" Property="BorderThickness" Value="2" />
                                <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource Sanduhr.Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KeyCap" TargetType="Border">
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="BorderThickness" Value="1,1,1,2" />
            <Setter Property="BorderBrush" Value="{DynamicResource Sanduhr.Brush.Border}" />
            <Setter Property="Background" Value="{DynamicResource Sanduhr.Brush.Glass}" />
        </Style>

        <DataTemplate x:Key="CardTemplate">
            <Border Margin="7" Padding="12" CornerRadius="10" BorderThickness="1"
                    Background="{DynamicResource Sanduhr.Brush.CardGlass}"
                    BorderBrush="{DynamicResource Sanduhr.Brush.Border}"
                    AutomationProperties.Name="{Binding AutomationName}">
                <DockPanel LastChildFill="True">
                    <!-- Art: decorative, never focusable, hidden from assistive tech. -->
                    <Border DockPanel.Dock="Top" Height="96" CornerRadius="8" Margin="0,0,0,10"
                            Background="{DynamicResource Sanduhr.Brush.Bg}"
                            Focusable="False" IsHitTestVisible="False"
                            AutomationProperties.IsOffscreenBehavior="Offscreen">
                        <Grid>
                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Sanduhr.Brush.Accent}"
                                       Visibility="{Binding IsGlyph, Converter={StaticResource BoolVis}}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding IsTray, Converter={StaticResource BoolVis}}">
                                <Image Source="{Binding TrayImage}" Width="32" Height="32" Margin="0,0,10,0"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="Session 12%" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Sanduhr.Brush.Text}" />
                            </StackPanel>
                            <ctl:SparklineControl Width="160" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  SparklineStyle="Horizon"
                                                  Values="{Binding SparkValues}"
                                                  LineColor="{DynamicResource Sanduhr.Color.Sparkline}"
                                                  Visibility="{Binding IsSparkline, Converter={StaticResource BoolVis}}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding IsShortcut, Converter={StaticResource BoolVis}}">
                                <Border Style="{StaticResource KeyCap}">
                                    <TextBlock Text="Ctrl" FontSize="13" Foreground="{DynamicResource Sanduhr.Brush.Text}" />
                                </Border>
                                <Border Style="{StaticResource KeyCap}">
                                    <TextBlock Text="Alt" FontSize="13" Foreground="{DynamicResource Sanduhr.Brush.Text}" />
                                </Border>
                                <Border Style="{StaticResource KeyCap}">
                                    <TextBlock Text="S" FontSize="13" Foreground="{DynamicResource Sanduhr.Brush.Text}" />
                                </Border>
                            </StackPanel>
                            <!-- Meters: the widget's own bars as they read now (demo mode's samples in demo). -->
                            <ItemsControl ItemsSource="{Binding Meters}" Margin="16,18,16,6" VerticalAlignment="Center"
                                          Focusable="False" IsTabStop="False"
                                          Visibility="{Binding IsMeters, Converter={StaticResource BoolVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="40" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                                            <Border Grid.Column="1" Height="6" CornerRadius="3" VerticalAlignment="Center"
                                                    Background="{DynamicResource Sanduhr.Brush.Border}">
                                                <Border CornerRadius="3" RenderTransformOrigin="0,0.5">
                                                    <Border.RenderTransform>
                                                        <ScaleTransform ScaleX="{Binding Fraction}" ScaleY="1" />
                                                    </Border.RenderTransform>
                                                    <Border.Background>
                                                        <SolidColorBrush Color="{Binding BarColor}" />
                                                    </Border.Background>
                                                </Border>
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding PercentText}" FontSize="11"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource Sanduhr.Brush.Text}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Your meters show here once you sign in." FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}"
                                       Visibility="{Binding IsMetersEmpty, Converter={StaticResource BoolVis}}" />
                            <TextBlock Text="Demo: sample data" FontSize="10" FontWeight="SemiBold"
                                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,10,0"
                                       Foreground="{DynamicResource Sanduhr.Brush.Accent}"
                                       Visibility="{Binding IsSample, Converter={StaticResource BoolVis}}" />
                            <!-- Account chip: the name the widget shows (a demo sample in demo mode). -->
                            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="12,5" CornerRadius="12"
                                    BorderThickness="1" BorderBrush="{DynamicResource Sanduhr.Brush.Border}"
                                    Background="{DynamicResource Sanduhr.Brush.Glass}"
                                    Visibility="{Binding IsAccountChip, Converter={StaticResource BoolVis}}">
                                <TextBlock FontSize="13" Foreground="{DynamicResource Sanduhr.Brush.Accent}">
                                    <Run Text="⇆ " /><Run Text="{Binding ChipText, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                        </Grid>
                    </Border>

                    <Button DockPanel.Dock="Bottom" Style="{StaticResource FlatButton}" Content="{Binding ShowMeTitle}"
                            HorizontalAlignment="Left" Margin="0,10,0,0" Padding="12,5"
                            ToolTip="{Binding ShowMeToolTip}"
                            AutomationProperties.Name="{Binding ShowMeName}"
                            AutomationProperties.HelpText="{Binding Body}"
                            Click="ShowMe_Click" />

                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Sanduhr.Brush.Text}" />
                        <TextBlock Text="{Binding Body}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                        <!-- A tour card's in-place choice: the real setting, written when chosen. -->
                        <StackPanel Margin="0,10,0,0"
                                    Visibility="{Binding HasChoices, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="The tray shows" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"
                                       Foreground="{DynamicResource Sanduhr.Brush.Text}" />
                            <!-- ItemsControl has an automation peer (a StackPanel does not): the group's name. -->
                            <ItemsControl ItemsSource="{Binding Choices}" IsTabStop="False" Focusable="False"
                                          AutomationProperties.Name="The tray shows">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton Style="{StaticResource ThemedRadio}" GroupName="TourTrayShows"
                                                     Content="{Binding Title}" Margin="0,2"
                                                     IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                     AutomationProperties.Name="{Binding Title}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border CornerRadius="10"
            Background="{DynamicResource Sanduhr.Brush.Bg}"
            BorderBrush="{DynamicResource Sanduhr.Brush.Border}"
            BorderThickness="1"
            MouseLeftButtonDown="Background_MouseLeftButtonDown">
        <DockPanel LastChildFill="True">

            <Border DockPanel.Dock="Top" Height="2" CornerRadius="10,10,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="{DynamicResource Sanduhr.Color.Accent}" />
                        <GradientStop Offset="1" Color="{DynamicResource Sanduhr.Color.AccentFade}" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Header -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,16,20,10">
                <Image Source="/Assets/Sanduhr.ico" Width="36" Height="36" Margin="0,0,12,0"
                       Focusable="False" AutomationProperties.IsOffscreenBehavior="Offscreen"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding WindowTitle}" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource Sanduhr.Brush.Text}" />
                    <TextBlock Text="{Binding Header}" FontSize="12" Margin="0,2,0,0"
                               AutomationProperties.Name="{Binding HeaderName}"
                               Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                </StackPanel>
            </StackPanel>

            <!-- Footer -->
            <StackPanel DockPanel.Dock="Bottom" Margin="20,10,20,16">
                <TextBlock FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource Sanduhr.Brush.TextDim}"
                           AutomationProperties.Name="{x:Static core:SettingsNames.TrademarkNotice}"
                           Text="{x:Static core:SettingsNames.TrademarkNotice}" />
                <DockPanel Margin="0,12,0,0" LastChildFill="False"
                           Visibility="{Binding IsWhatsNew, Converter={StaticResource BoolVis}}">
                    <CheckBox DockPanel.Dock="Left" Style="{StaticResource ThemedCheckBox}"
                              Content="Don't show after updates"
                              IsChecked="{Binding HideAfterUpdates, Mode=TwoWay}"
                              ToolTip="What's New stays in the tray menu and Settings either way."
                              AutomationProperties.Name="Don't show after updates" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Done"
                            IsDefault="{Binding IsWhatsNew}" IsCancel="{Binding IsWhatsNew}" Padding="22,7"
                            AutomationProperties.Name="Done" Click="Done_Click" />
                </DockPanel>

                <!-- Step mode (the welcome tour): Skip always there, Back, Next / Finish. -->
                <DockPanel Margin="0,12,0,0" LastChildFill="True"
                           Visibility="{Binding IsTour, Converter={StaticResource BoolVis}}">
                    <Button DockPanel.Dock="Left" Style="{StaticResource FlatButton}" Content="{Binding SkipTitle}"
                            IsCancel="{Binding IsTour}" Padding="14,7"
                            ToolTip="Close the tour; every setting stays as it is"
                            AutomationProperties.Name="Skip the tour" Click="Skip_Click" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="{Binding NextTitle}"
                            IsDefault="{Binding IsTour}" Padding="22,7" Margin="8,0,0,0"
                            AutomationProperties.Name="{Binding NextTitle}" Click="Next_Click" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Back"
                            IsEnabled="{Binding CanGoBack}" Padding="14,7"
                            AutomationProperties.Name="Back" Click="Back_Click" />
                    <TextBlock Text="{Binding AgainLine}" FontSize="11" TextWrapping="Wrap" Margin="12,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}"
                               Visibility="{Binding IsLast, Converter={StaticResource BoolVis}}" />
                </DockPanel>
            </StackPanel>

            <!-- Body -->
            <Grid>
                <TextBlock Text="Nothing new to show for this version." FontSize="12"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Focusable="False" Margin="13,0,13,0">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimThemeScrollBar}" />
                    </ScrollViewer.Resources>
                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource CardTemplate}"
                                  Focusable="False" IsTabStop="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid VerticalAlignment="Top"
                                             Columns="{Binding DataContext.Columns, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Border>
</Window>
