<Window x:Class="Sanduhr.App.Views.WhatsNewWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ctl="clr-namespace:Sanduhr.App.Controls"
        Title="What's New in Sanduhr"
        Width="640" Height="620"
        MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        Background="{DynamicResource Sanduhr.Brush.Bg}"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        UseLayoutRounding="True"
        Icon="/Assets/Sanduhr.ico">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />

        <!-- Same flat button and check box as Settings (those live in SettingsWindow's own resources). -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Sanduhr.Brush.Text}" />
            <Setter Property="Background" Value="{DynamicResource Sanduhr.Brush.Glass}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Sanduhr.Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource Sanduhr.Brush.GlassHover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource Sanduhr.Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemedCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Sanduhr.Brush.Text}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="box" Width="16" Height="16" CornerRadius="3"
                                    VerticalAlignment="Center" Margin="0,0,8,0"
                                    Background="{DynamicResource Sanduhr.Brush.Bg}"
                                    BorderBrush="{DynamicResource Sanduhr.Brush.Border}" BorderThickness="1">
                                <Path x:Name="check" Stretch="Uniform" Margin="2"
                                      Data="M0,5 L4,9 L11,0" Visibility="Collapsed"
                                      Stroke="{DynamicResource Sanduhr.Brush.Accent}" StrokeThickness="2" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Sanduhr.Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Sanduhr.Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KeyCap" TargetType="Border">
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="BorderThickness" Value="1,1,1,2" />
            <Setter Property="BorderBrush" Value="{DynamicResource Sanduhr.Brush.Border}" />
            <Setter Property="Background" Value="{DynamicResource Sanduhr.Brush.Glass}" />
        </Style>

        <DataTemplate x:Key="CardTemplate">
            <Border Margin="7" Padding="12" CornerRadius="10" BorderThickness="1"
                    Background="{DynamicResource Sanduhr.Brush.CardGlass}"
                    BorderBrush="{DynamicResource Sanduhr.Brush.Border}"
                    AutomationProperties.Name="{Binding AutomationName}">
                <DockPanel LastChildFill="True">
                    <!-- Art: decorative, never focusable, hidden from assistive tech. -->
                    <Border DockPanel.Dock="Top" Height="96" CornerRadius="8" Margin="0,0,0,10"
                            Background="{DynamicResource Sanduhr.Brush.Bg}"
                            Focusable="False" IsHitTestVisible="False"
                            AutomationProperties.IsOffscreenBehavior="Offscreen">
                        <Grid>
                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Sanduhr.Brush.Accent}"
                                       Visibility="{Binding IsGlyph, Converter={StaticResource BoolVis}}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding IsTray, Converter={StaticResource BoolVis}}">
                                <Image Source="{Binding TrayImage}" Width="32" Height="32" Margin="0,0,10,0"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="Session 12%" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Sanduhr.Brush.Text}" />
                            </StackPanel>
                            <ctl:SparklineControl Width="160" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  SparklineStyle="Horizon"
                                                  Values="{Binding SparkValues}"
                                                  LineColor="{DynamicResource Sanduhr.Color.Sparkline}"
                                                  Visibility="{Binding IsSparkline, Converter={StaticResource BoolVis}}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding IsShortcut, Converter={StaticResource BoolVis}}">
                                <Border Style="{StaticResource KeyCap}">
                                    <TextBlock Text="Ctrl" FontSize="13" Foreground="{DynamicResource Sanduhr.Brush.Text}" />
                                </Border>
                                <Border Style="{StaticResource KeyCap}">
                                    <TextBlock Text="Alt" FontSize="13" Foreground="{DynamicResource Sanduhr.Brush.Text}" />
                                </Border>
                                <Border Style="{StaticResource KeyCap}">
                                    <TextBlock Text="S" FontSize="13" Foreground="{DynamicResource Sanduhr.Brush.Text}" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Button DockPanel.Dock="Bottom" Style="{StaticResource FlatButton}" Content="Show me"
                            HorizontalAlignment="Left" Margin="0,10,0,0" Padding="12,5"
                            ToolTip="{Binding ShowMeToolTip}"
                            AutomationProperties.Name="{Binding ShowMeName}"
                            AutomationProperties.HelpText="{Binding Body}"
                            Click="ShowMe_Click" />

                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Sanduhr.Brush.Text}" />
                        <TextBlock Text="{Binding Body}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border CornerRadius="10"
            Background="{DynamicResource Sanduhr.Brush.Bg}"
            BorderBrush="{DynamicResource Sanduhr.Brush.Border}"
            BorderThickness="1"
            MouseLeftButtonDown="Background_MouseLeftButtonDown">
        <DockPanel LastChildFill="True">

            <Border DockPanel.Dock="Top" Height="2" CornerRadius="10,10,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="{DynamicResource Sanduhr.Color.Accent}" />
                        <GradientStop Offset="1" Color="{DynamicResource Sanduhr.Color.AccentFade}" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Header -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,16,20,10">
                <Image Source="/Assets/Sanduhr.ico" Width="36" Height="36" Margin="0,0,12,0"
                       Focusable="False" AutomationProperties.IsOffscreenBehavior="Offscreen"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="What's New in Sanduhr" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource Sanduhr.Brush.Text}" />
                    <TextBlock Text="{Binding Header}" FontSize="12" Margin="0,2,0,0"
                               Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                </StackPanel>
            </StackPanel>

            <!-- Footer -->
            <StackPanel DockPanel.Dock="Bottom" Margin="20,10,20,16">
                <TextBlock FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource Sanduhr.Brush.TextDim}"
                           Text="“Claude” and “claude.ai” are trademarks of Anthropic PBC, used nominatively; Sanduhr für Claude is an independent third-party tool." />
                <DockPanel Margin="0,12,0,0" LastChildFill="False">
                    <CheckBox DockPanel.Dock="Left" Style="{StaticResource ThemedCheckBox}"
                              Content="Don't show after updates"
                              IsChecked="{Binding HideAfterUpdates, Mode=TwoWay}"
                              ToolTip="What's New stays in the tray menu and Settings either way."
                              AutomationProperties.Name="Don't show after updates" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Done"
                            IsDefault="True" IsCancel="True" Padding="22,7"
                            AutomationProperties.Name="Done" Click="Done_Click" />
                </DockPanel>
            </StackPanel>

            <!-- Body -->
            <Grid>
                <TextBlock Text="Nothing new to show for this version." FontSize="12"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Focusable="False" Margin="13,0,13,0">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimThemeScrollBar}" />
                    </ScrollViewer.Resources>
                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource CardTemplate}"
                                  Focusable="False" IsTabStop="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Border>
</Window>
