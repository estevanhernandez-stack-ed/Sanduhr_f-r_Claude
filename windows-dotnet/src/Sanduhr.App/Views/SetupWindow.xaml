<Window x:Class="Sanduhr.App.Views.SetupWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Sanduhr.Core;assembly=Sanduhr.Core"
        xmlns:views="clr-namespace:Sanduhr.App.Views"
        Title="{x:Static core:SetupCopy.Title}"
        SizeToContent="Height" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource Sanduhr.Brush.Bg}"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Icon="/Assets/Sanduhr.ico">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />

        <!-- The same flat button and check box as the other small windows, which keep theirs in their own resources. -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Sanduhr.Brush.Text}" />
            <Setter Property="Background" Value="{DynamicResource Sanduhr.Brush.Glass}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Sanduhr.Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource Sanduhr.Brush.Accent}" />
                                <Setter TargetName="bg" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="{DynamicResource Sanduhr.Brush.Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource Sanduhr.Brush.Bg}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="22,7" />
        </Style>

        <!-- A tick tile: the box, then a title and a sentence that wrap. -->
        <Style x:Key="TickTile" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Sanduhr.Brush.Text}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="box" Width="18" Height="18" CornerRadius="3" VerticalAlignment="Top" Margin="0,1,10,0"
                                    Background="{DynamicResource Sanduhr.Brush.Bg}"
                                    BorderBrush="{DynamicResource Sanduhr.Brush.Border}" BorderThickness="1">
                                <Path x:Name="check" Stretch="Uniform" Margin="3"
                                      Data="M0,5 L4,9 L11,0" Visibility="Collapsed"
                                      Stroke="{DynamicResource Sanduhr.Brush.Accent}" StrokeThickness="2" />
                            </Border>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Top" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Sanduhr.Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Sanduhr.Brush.Accent}" />
                                <Setter TargetName="box" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A look to start with: a small card that can be picked. The accent ring is the pick; the text-ink ring is the keyboard. -->
        <Style x:Key="LookPick" TargetType="ToggleButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ring" CornerRadius="7" Padding="4" BorderThickness="2" BorderBrush="Transparent"
                                Background="{DynamicResource Sanduhr.Brush.Glass}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource Sanduhr.Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource Sanduhr.Brush.Text}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Two rows: the tiles scroll when the screen is short (MaxHeight is the work area), and Continue never leaves the window. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer x:Name="SetupScroller" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimThemeScrollBar}" />
            </ScrollViewer.Resources>
    <StackPanel Margin="26,24,26,0">
        <TextBlock Text="{x:Static core:SetupCopy.Title}" FontSize="18" FontWeight="SemiBold"
                   Foreground="{DynamicResource Sanduhr.Brush.Accent}"
                   AutomationProperties.HeadingLevel="Level1" />
        <TextBlock Text="{x:Static core:SetupCopy.Intro}" TextWrapping="Wrap" Margin="0,6,0,18" FontSize="12"
                   Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />

        <!-- A nicer desktop, and the way into Design it with an AI chat. -->
        <CheckBox x:Name="DesktopBox" Style="{StaticResource TickTile}" IsChecked="{Binding Desktop}"
                  AutomationProperties.Name="{x:Static core:SetupCopy.DesktopTitle}"
                  AutomationProperties.HelpText="{x:Static core:SetupCopy.DesktopBody}">
            <StackPanel>
                <TextBlock Text="{x:Static core:SetupCopy.DesktopTitle}" FontWeight="SemiBold" />
                <TextBlock Text="{x:Static core:SetupCopy.DesktopBody}" TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0"
                           Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
            </StackPanel>
        </CheckBox>
        <Button x:Name="DesignWithChatButton" Style="{StaticResource FlatButton}" HorizontalAlignment="Left" Margin="28,10,0,0" Padding="12,6"
                Content="{x:Static core:SetupCopy.DesignWithChat}" Command="{Binding DesignWithChatCommand}"
                AutomationProperties.Name="{x:Static core:SetupCopy.DesignWithChat}"
                AutomationProperties.HelpText="{x:Static core:SetupCopy.DesignWithChatCaption}" />
        <TextBlock x:Name="DesignWithChatCaption" Text="{x:Static core:SetupCopy.DesignWithChatCaption}" TextWrapping="Wrap" FontSize="11"
                   Margin="28,4,0,0" Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
        <!-- Start with a look (5.0 spec 5): the ready-made looks, small. A pick is a choice for Continue, like the ticks. -->
        <StackPanel x:Name="StartWithALookRow" Margin="28,12,0,0" IsEnabled="{Binding LooksEnabled}"
                    Visibility="{Binding HasLooks, Converter={StaticResource BoolVis}}">
            <TextBlock Text="{x:Static core:SetupCopy.StartWithALook}" FontSize="12" FontWeight="SemiBold"
                       AutomationProperties.HeadingLevel="Level2"
                       Foreground="{DynamicResource Sanduhr.Brush.Text}" />
            <TextBlock Text="{x:Static core:SetupCopy.StartWithALookCaption}" TextWrapping="Wrap" FontSize="11" Margin="0,2,0,8"
                       Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
            <ScrollViewer x:Name="LooksStrip" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False"
                          PreviewMouseWheel="LooksStrip_PreviewMouseWheel">
            <ItemsControl ItemsSource="{Binding Looks}" Focusable="False" Margin="0,0,0,6"
                          KeyboardNavigation.DirectionalNavigation="Contained">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ToggleButton Style="{StaticResource LookPick}" Command="{Binding PickCommand}"
                                      IsChecked="{Binding Picked, Mode=OneWay}"
                                      AutomationProperties.Name="{Binding AccessibleName}">
                            <StackPanel Width="139">
                                <Viewbox Width="139" Height="78" HorizontalAlignment="Left">
                                    <views:DeskLookCard Design="{Binding Card.Fitted}" Wallpaper="{Binding Card.Wallpaper}"
                                                        BackdropHex="{Binding Card.BackdropHex}" Brightness="{Binding Card.Brightness}"
                                                        LookName="{Binding Card.Name}" />
                                </Viewbox>
                                <TextBlock Text="{Binding Card.Name}" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0"
                                           Foreground="{DynamicResource Sanduhr.Brush.Text}" />
                                <TextBlock Text="{Binding Card.Blurb}" FontSize="10" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                            </StackPanel>
                        </ToggleButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>
        </StackPanel>

        <CheckBox x:Name="DrawersBox" Style="{StaticResource TickTile}" Margin="0,16,0,0" IsChecked="{Binding Drawers}"
                  AutomationProperties.Name="{x:Static core:SetupCopy.DrawersTitle}"
                  AutomationProperties.HelpText="{x:Static core:SetupCopy.DrawersBody}">
            <StackPanel>
                <TextBlock Text="{x:Static core:SetupCopy.DrawersTitle}" FontWeight="SemiBold" />
                <TextBlock Text="{x:Static core:SetupCopy.DrawersBody}" TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0"
                           Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
            </StackPanel>
        </CheckBox>

        <StackPanel Margin="0,16,0,0">
            <TextBlock Text="{x:Static core:SetupCopy.UsageTitle}" FontSize="13" FontWeight="SemiBold"
                       AutomationProperties.HeadingLevel="Level2"
                       Foreground="{DynamicResource Sanduhr.Brush.Text}" />
            <TextBlock Text="{x:Static core:SetupCopy.UsageBody}" TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0"
                       Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
        </StackPanel>
        <!-- The usage choice lists Claude and Codex as ticks. Codex never asks to sign in (it is read from its own logs on this PC), and
             is greyed with a line when it is not installed. The trademark line shows wherever Claude is named: usage ticked, or a change
             line that says Claude (Claude Code) with usage unticked. -->
        <StackPanel Margin="0,10,0,0">
            <CheckBox x:Name="UsageBox" Style="{StaticResource TickTile}" IsChecked="{Binding ClaudeUsage}"
                      AutomationProperties.Name="{x:Static core:SetupCopy.ClaudeSource}">
                <TextBlock Text="{x:Static core:SetupCopy.ClaudeSource}" FontSize="12" FontWeight="SemiBold" />
            </CheckBox>
            <TextBlock Text="{x:Static core:SetupCopy.ClaudeTrademark}" TextWrapping="Wrap" FontSize="10" Margin="28,2,0,6"
                       Visibility="{Binding ShowTrademark, Converter={StaticResource BoolVis}}"
                       Foreground="{DynamicResource Sanduhr.Brush.TextDim}" />
            <CheckBox x:Name="CodexUsageBox" Style="{StaticResource TickTile}" Margin="0,6,0,0" IsChecked="{Binding CodexUsage}"
                      IsEnabled="{Binding CodexEnabled}"
                      AutomationProperties.Name="{x:Static core:SetupCopy.CodexSource}">
                <TextBlock Text="{x:Static core:SetupCopy.CodexSource}" FontSize="12" FontWeight="SemiBold" />
            </CheckBox>
            <TextBlock Text="{Binding CodexNotInstalledText}" TextWrapping="Wrap" FontSize="10" Margin="28,2,0,0"
                       Visibility="{Binding HasCodexNotInstalledText, Converter={StaticResource BoolVis}}"
                       Foreground="{DynamicResource Sanduhr.Brush.TextDim}" />
            <TextBlock Text="{x:Static core:SetupCopy.CodexTrademark}" TextWrapping="Wrap" FontSize="10" Margin="28,4,0,0"
                       Foreground="{DynamicResource Sanduhr.Brush.TextDim}" />
        </StackPanel>

        <!-- What unticking does, said before Continue applies it (reopened later only). -->
        <TextBlock Text="{Binding ChangeText}" Margin="0,18,0,0" TextWrapping="Wrap" FontSize="11" LineHeight="18"
                   AutomationProperties.HelpText="{x:Static core:SetupCopy.WhatChanges}"
                   AutomationProperties.LiveSetting="Polite"
                   Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}"
                   Visibility="{Binding HasChangeLines, Converter={StaticResource BoolVis}}" />
    </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Margin="26,0,26,22">
        <!-- Why Continue is off. -->
        <TextBlock Text="{Binding Blocked}" TextWrapping="Wrap" FontSize="11" Margin="0,14,0,0"
                   Foreground="{DynamicResource Sanduhr.Brush.PaceMarker}"
                   AutomationProperties.LiveSetting="Assertive">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CanContinue}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- What Continue said when it could not finish; the window stays open. -->
        <ItemsControl ItemsSource="{Binding ResultLines}" Margin="0,14,0,0" Focusable="False"
                      AutomationProperties.Name="{x:Static core:SetupCopy.WhatHappened}"
                      Visibility="{Binding HasResultLines, Converter={StaticResource BoolVis}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,4"
                               Foreground="{DynamicResource Sanduhr.Brush.PaceMarker}"
                               AutomationProperties.LiveSetting="Assertive" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="DismissButton" Style="{StaticResource FlatButton}" Margin="0,0,8,0"
                    Content="{Binding DismissLabel}" Command="{Binding DismissCommand}" IsCancel="True"
                    AutomationProperties.Name="{Binding DismissLabel}" />
            <Button x:Name="ContinueButton" Style="{StaticResource AccentButton}"
                    Content="{x:Static core:SetupCopy.Continue}" Command="{Binding ContinueCommand}" IsDefault="True"
                    AutomationProperties.Name="{x:Static core:SetupCopy.Continue}" />
        </StackPanel>
        </StackPanel>
    </Grid>
</Window>
