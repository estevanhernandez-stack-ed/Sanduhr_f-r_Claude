<UserControl x:Class="Sanduhr.App.Views.LauncherPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Sanduhr.App.Views"
             xmlns:vm="clr-namespace:Sanduhr.App.ViewModels"
             xmlns:core="clr-namespace:Sanduhr.Core;assembly=Sanduhr.Core"
             Focusable="False">
    <!-- Settings, Launcher (spec, Launcher): up to eight buttons on the Desk, and where the piece shows (WF22). Hosted in SettingsWindow. DataContext: the DeskSettingsViewModel. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />
    </UserControl.Resources>
    <Border Background="{DynamicResource Sanduhr.Brush.Glass}" CornerRadius="8">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimThemeScrollBar}" />
            </ScrollViewer.Resources>
            <StackPanel x:Name="PageBody" Margin="20">
                <TextBlock Text="{x:Static core:SettingsNames.LauncherTitle}" FontSize="14" FontWeight="SemiBold"
                           AutomationProperties.HeadingLevel="Level1"
                           Foreground="{DynamicResource Sanduhr.Brush.Text}" Margin="0,0,0,12" />

                <!-- Where it shows: the Launcher piece's line (Principle 1). -->
                <StackPanel views:SettingsAnchor.Id="launcher">
                    <TextBlock Text="{x:Static core:SettingsNames.LauncherPlace}" FontSize="13" FontWeight="SemiBold"
                               AutomationProperties.HeadingLevel="Level2"
                               Foreground="{DynamicResource Sanduhr.Brush.Text}" Margin="0,0,0,8" />
                    <views:DeskPieceStatusPanel DataContext="{Binding LauncherPiece}" />
                </StackPanel>

                <Border Height="1" Background="{DynamicResource Sanduhr.Brush.Border}" Margin="0,16,0,16" />

                <StackPanel views:SettingsAnchor.Id="launcher-buttons" DataContext="{Binding Launcher}">
                    <TextBlock Text="{x:Static core:SettingsNames.LauncherButtons}" FontSize="13" FontWeight="SemiBold"
                               AutomationProperties.HeadingLevel="Level2"
                               Foreground="{DynamicResource Sanduhr.Brush.Text}" Margin="0,0,0,8" />
                    <TextBlock FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource Sanduhr.Brush.TextDim}"
                               Text="Up to eight buttons on the Desk, each opening an app from your Start menu or an https link. The Desk sits below your windows, so a button works where the Desk shows, or after Show desktop." />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{DynamicResource FlatButton}" Padding="12,6"
                                Content="{x:Static core:SettingsNames.LauncherAddApp}"
                                Command="{Binding AddAppCommand}"
                                AutomationProperties.Name="{x:Static core:SettingsNames.LauncherAddApp}" />
                        <Button Style="{DynamicResource FlatButton}" Padding="12,6"
                                Content="{x:Static core:SettingsNames.LauncherAddLink}"
                                Command="{Binding AddLinkCommand}"
                                AutomationProperties.Name="{x:Static core:SettingsNames.LauncherAddLink}" />
                        <TextBlock Text="{Binding CountText}" FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0"
                                   Foreground="{DynamicResource Sanduhr.Brush.TextDim}" />
                    </StackPanel>
                    <Grid Margin="0,10,0,0" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Buttons in a" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                        <ComboBox Grid.Column="1" Style="{DynamicResource ThemedComboBox}"
                                  ItemsSource="{x:Static vm:LauncherSettingsViewModel.OrientationChoices}"
                                  SelectedItem="{Binding SelectedOrientation, Mode=TwoWay}"
                                  AutomationProperties.Name="Buttons in a row or a column" />
                    </Grid>
                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                               AutomationProperties.LiveSetting="Polite"
                               Foreground="{DynamicResource Sanduhr.Brush.PaceMarker}"
                               Text="{Binding Problem}"
                               Visibility="{Binding HasProblem, Converter={StaticResource BoolVis}}" />
                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                               AutomationProperties.LiveSetting="Polite"
                               Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}"
                               Text="{Binding PlacementNote}"
                               Visibility="{Binding HasPlacementNote, Converter={StaticResource BoolVis}}" />
                    <TextBlock FontSize="11" Margin="0,10,0,0"
                               Foreground="{DynamicResource Sanduhr.Brush.TextDim}"
                               Text="No buttons yet. Add an app or a link."
                               Visibility="{Binding HasNoButtons, Converter={StaticResource BoolVis}}" />

                    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" Margin="0,10,0,0"
                                  AutomationProperties.Name="Launcher buttons">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="6" Padding="10" Margin="0,0,0,8" BorderThickness="1"
                                        Background="{DynamicResource Sanduhr.Brush.Bg}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Sanduhr.Brush.Border}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Sanduhr.Brush.Accent}" />
                                                    <Setter Property="BorderThickness" Value="2" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="46" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="38" Height="38" HorizontalAlignment="Left">
                                                <Border CornerRadius="6" BorderThickness="1"
                                                        BorderBrush="{DynamicResource Sanduhr.Brush.Border}">
                                                    <TextBlock Text="{Binding Initial}" FontSize="16" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource Sanduhr.Brush.TextDim}" />
                                                </Border>
                                                <Image Source="{Binding Preview}" Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Grid>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource Sanduhr.Brush.Text}" />
                                                <TextBlock Text="{Binding Detail}" FontSize="10.5" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource Sanduhr.Brush.TextDim}" />
                                                <TextBlock FontSize="10.5" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource Sanduhr.Brush.PaceMarker}"
                                                           Text="Not installed any more. Remove this button or add the app back."
                                                           Visibility="{Binding IsMissing, Converter={StaticResource BoolVis}}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                                <Button Style="{DynamicResource FlatButton}" Padding="8,4" Margin="0,0,4,0"
                                                        Content="Move up"
                                                        Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" IsEnabled="{Binding CanMoveUp}"
                                                        AutomationProperties.Name="{Binding Subject, StringFormat='Move {0} up'}" />
                                                <Button Style="{DynamicResource FlatButton}" Padding="8,4" Margin="0,0,4,0"
                                                        Content="Move down"
                                                        Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" IsEnabled="{Binding CanMoveDown}"
                                                        AutomationProperties.Name="{Binding Subject, StringFormat='Move {0} down'}" />
                                                <Button Style="{DynamicResource FlatButton}" Padding="8,4" Margin="0"
                                                        Content="Remove"
                                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        AutomationProperties.Name="{Binding Subject, StringFormat='Remove {0}'}" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="86" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Label" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"
                                                       Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                                            <TextBox Grid.Column="1" Style="{DynamicResource Input}" MaxLength="24"
                                                     Text="{Binding Label, UpdateSourceTrigger=LostFocus}"
                                                     AutomationProperties.Name="{Binding Subject, StringFormat='Label for {0}'}" />
                                            <TextBlock Grid.Column="2" Text="Glow color" FontSize="12" VerticalAlignment="Center" Margin="14,0,8,0"
                                                       Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                                            <TextBox Grid.Column="3" Style="{DynamicResource Input}" FontFamily="Cascadia Code, Consolas" MaxLength="7"
                                                     Text="{Binding Glow, UpdateSourceTrigger=LostFocus}"
                                                     AutomationProperties.Name="{Binding Subject, StringFormat='Glow color for {0}, a hex color like #ff8800, empty for the Desk ink'}" />
                                        </Grid>
                                        <TextBlock FontSize="10.5" Margin="0,4,0,0"
                                                   AutomationProperties.LiveSetting="Polite"
                                                   Foreground="{DynamicResource Sanduhr.Brush.PaceMarker}"
                                                   Text="{Binding GlowProblem}"
                                                   Visibility="{Binding HasGlowProblem, Converter={StaticResource BoolVis}}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Style="{DynamicResource FlatButton}" Padding="10,5"
                                                    Content="Change image…"
                                                    Command="{Binding DataContext.ChangeImageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    AutomationProperties.Name="{Binding Subject, StringFormat='Change image for {0}'}" />
                                            <Button Style="{DynamicResource FlatButton}" Padding="10,5" Margin="0"
                                                    Content="{Binding UseDefaultImageText}"
                                                    Command="{Binding DataContext.UseDefaultImageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" IsEnabled="{Binding CanUseDefaultImage}"
                                                    AutomationProperties.Name="{Binding UseDefaultImageName}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                               Foreground="{DynamicResource Sanduhr.Brush.TextDim}"
                               Text="Images are PNG files up to 1 MB, kept in Sanduhr's own folder at 256 pixels. Nothing is downloaded: a link button shows a link icon until you choose an image." />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
