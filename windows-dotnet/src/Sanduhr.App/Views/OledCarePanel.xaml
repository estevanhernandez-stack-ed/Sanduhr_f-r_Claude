<UserControl x:Class="Sanduhr.App.Views.OledCarePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Sanduhr.Core;assembly=Sanduhr.Core"
             Focusable="False">
    <!-- Settings, Desk, OLED care (spec 3.7.0): the one switch and its caption. Its own control so the name Narrator reads can be
         tested. The Settings window supplies the ThemedCheckBox style (found at run time) and the theme brushes. -->
    <StackPanel>
        <CheckBox Style="{DynamicResource ThemedCheckBox}"
                  Content="{x:Static core:SettingsNames.OledCareSwitch}"
                  IsChecked="{Binding OledCare, Mode=TwoWay}"
                  AutomationProperties.Name="{x:Static core:SettingsNames.OledCareSwitch}"
                  AutomationProperties.HelpText="{x:Static core:OledCare.Caption}" />
        <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                   Foreground="{DynamicResource Sanduhr.Brush.TextDim}"
                   Text="{x:Static core:OledCare.Caption}" />
    </StackPanel>
</UserControl>
