<UserControl x:Class="Sanduhr.App.Views.SourcesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Sanduhr.App.Views"
             xmlns:controls="clr-namespace:Sanduhr.App.Controls"
             xmlns:core="clr-namespace:Sanduhr.Core;assembly=Sanduhr.Core"
             Focusable="False">
    <!-- Settings, Usage, Sources (agent layer): one row per source, with on, primary, color and alerts.
         Hosted in SettingsWindow. DataContext: the SourcesViewModel. Tab order within a row: On, Primary, Color, Reset, Alerts. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />

        <!-- The primary choice: a themed radio, legible on the window's own surface in either Windows mode. -->
        <Style x:Key="SourcesRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Sanduhr.Brush.Text}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="ring" Width="14" Height="14" CornerRadius="7" Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource Sanduhr.Brush.Bg}"
                                    BorderBrush="{DynamicResource Sanduhr.Brush.Border}" BorderThickness="1">
                                <Ellipse x:Name="dot" Width="6" Height="6" Visibility="Collapsed"
                                         Fill="{DynamicResource Sanduhr.Brush.Accent}" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="dot" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource Sanduhr.Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource Sanduhr.Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ring" Property="BorderThickness" Value="2" />
                                <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource Sanduhr.Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border Background="{DynamicResource Sanduhr.Brush.Glass}" CornerRadius="8">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimThemeScrollBar}" />
            </ScrollViewer.Resources>
            <StackPanel x:Name="PageBody" Margin="20">
                <TextBlock Text="{x:Static core:SettingsNames.SourcesTitle}" FontSize="14" FontWeight="SemiBold"
                           AutomationProperties.HeadingLevel="Level1"
                           Foreground="{DynamicResource Sanduhr.Brush.Text}" Margin="0,0,0,6" />
                <TextBlock Text="{x:Static core:SettingsNames.SourcesIntro}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"
                           Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />

                <StackPanel views:SettingsAnchor.Id="sources">
                    <controls:RadioGroupPanel AutomationProperties.Name="{x:Static core:SettingsNames.SourcesPrimaryGroup}">
                    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False"
                                  AutomationProperties.Name="{x:Static core:SettingsNames.SourcesTitle}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,16">
                                    <!-- On, with the source's name; a source that is not installed is greyed and says why. -->
                                    <CheckBox Style="{DynamicResource ThemedCheckBox}" Content="{Binding Name}"
                                              IsChecked="{Binding On, Mode=TwoWay}" IsEnabled="{Binding CanToggle}"
                                              AutomationProperties.Name="{Binding OnName}" />
                                    <TextBlock Text="{Binding NotInstalledText}" FontSize="11" TextWrapping="Wrap" Margin="24,4,0,0"
                                               Foreground="{DynamicResource Sanduhr.Brush.TextDim}"
                                               Visibility="{Binding HasNotInstalledText, Converter={StaticResource BoolVis}}" />
                                    <TextBlock Text="{Binding ArchiveCaption}" FontSize="11" TextWrapping="Wrap" Margin="24,4,0,0"
                                               Foreground="{DynamicResource Sanduhr.Brush.TextDim}"
                                               Visibility="{Binding HasArchiveCaption, Converter={StaticResource BoolVis}}" />

                                    <StackPanel Orientation="Horizontal" Margin="24,8,0,0">
                                        <RadioButton Style="{StaticResource SourcesRadio}" GroupName="sources-primary"
                                                     Content="{x:Static core:SettingsNames.SourcesPrimary}"
                                                     IsChecked="{Binding IsPrimary, Mode=TwoWay}" IsEnabled="{Binding CanBePrimary}"
                                                     AutomationProperties.Name="{Binding PrimaryName}"
                                                     PreviewKeyDown="OnPrimaryKeyDown"
                                                     VerticalAlignment="Center" Margin="0,0,20,0" />
                                        <TextBlock Text="{x:Static core:SettingsNames.SourcesColor}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                                        <Border Width="14" Height="14" CornerRadius="3" VerticalAlignment="Center" Margin="0,0,6,0"
                                                Background="{Binding Swatch}"
                                                BorderBrush="{DynamicResource Sanduhr.Brush.Border}" BorderThickness="1" />
                                        <TextBox Style="{DynamicResource Input}" Width="86" MaxLength="7"
                                                 Text="{Binding Color, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 PreviewKeyDown="OnColorKeyDown"
                                                 AutomationProperties.Name="{Binding ColorName}" />
                                        <Button Style="{DynamicResource FlatButton}" Padding="10,4" Margin="6,0,20,0"
                                                Content="{x:Static core:SettingsNames.SourcesReset}"
                                                Command="{Binding ResetColor}"
                                                AutomationProperties.Name="{Binding ResetName}" />
                                        <CheckBox Style="{DynamicResource ThemedCheckBox}" VerticalAlignment="Center"
                                                  Content="{x:Static core:SettingsNames.SourcesAlerts}"
                                                  IsChecked="{Binding AlertsOn, Mode=TwoWay}"
                                                  AutomationProperties.Name="{Binding AlertsName}" />
                                    </StackPanel>
                                    <!-- Collapsed while empty, so Narrator never stops on a blank "text" at the end of the list (4.8.0 hand pass);
                                         LiveRegion.Announces speaks it once layout shows it. Assertive after Announces, which sets Polite. -->
                                    <TextBlock Text="{Binding ColorMessage}" FontSize="11" TextWrapping="Wrap" Margin="24,4,0,0"
                                               Foreground="{DynamicResource Sanduhr.Brush.PaceMarker}"
                                               Visibility="{Binding HasColorMessage, Converter={StaticResource BoolVis}}"
                                               views:LiveRegion.Announces="True"
                                               AutomationProperties.LiveSetting="Assertive" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </controls:RadioGroupPanel>
                    <TextBlock Text="{x:Static core:SettingsNames.SourcesPrimaryCaption}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource Sanduhr.Brush.TextDim}" />
                    <TextBlock Text="{Binding Message}" FontSize="11.5" TextWrapping="Wrap" Margin="0,8,0,0"
                               Foreground="{DynamicResource Sanduhr.Brush.PaceMarker}"
                               Visibility="{Binding HasMessage, Converter={StaticResource BoolVis}}"
                               views:LiveRegion.Announces="True"
                               AutomationProperties.LiveSetting="Assertive" />
                </StackPanel>

                <TextBlock Text="{x:Static core:SettingsNames.ActivityOnlyHeader}" FontWeight="SemiBold" Margin="0,16,0,6"
                           AutomationProperties.HeadingLevel="Level2" Foreground="{DynamicResource Sanduhr.Brush.Text}" />
                <ItemsControl ItemsSource="{Binding ActivityRows}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,8">
                                <CheckBox Style="{DynamicResource ThemedCheckBox}" Content="{Binding Name}"
                                          IsChecked="{Binding On, Mode=TwoWay}" IsEnabled="{Binding CanToggle}"
                                          AutomationProperties.Name="{Binding Name}"
                                          AutomationProperties.HelpText="{Binding HelpText}" />
                                <TextBlock Text="{Binding Caption}" FontSize="11" TextWrapping="Wrap" Margin="24,2,0,0"
                                           Foreground="{DynamicResource Sanduhr.Brush.TextDim}" />
                                <TextBlock Text="{Binding ArchiveCaption}" FontSize="11" TextWrapping="Wrap" Margin="24,2,0,0"
                                           Foreground="{DynamicResource Sanduhr.Brush.TextDim}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Height="1" Background="{DynamicResource Sanduhr.Brush.Border}" Margin="0,16,0,16" />
                <!-- Store test 10.1.4.4: the page names Claude and Codex, so both disclaimers show. -->
                <views:TrademarkFooter />
                <TextBlock Text="{x:Static core:SettingsNames.CodexNotice}" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"
                           Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                <TextBlock Text="{x:Static core:SettingsNames.AntigravityNotice}" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"
                           Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
