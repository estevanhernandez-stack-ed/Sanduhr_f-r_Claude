<UserControl x:Class="Sanduhr.App.Views.DesignsSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Sanduhr.Core;assembly=Sanduhr.Core"
             Focusable="False">
    <!-- Settings, Desk, Designs (spec, the agent-designed Desk): the saved designs, Put my Desk back and a live line for what the last
         action did. Its own control so the names Narrator reads can be tested. The Settings window supplies the FlatButton style
         (found at run time) and the theme brushes. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />
    </UserControl.Resources>
        <StackPanel>
            <TextBlock Text="{x:Static core:SettingsNames.DeskDesigns}" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource Sanduhr.Brush.Text}" Margin="0,0,0,8" />
            <TextBlock FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource Sanduhr.Brush.TextDim}">
                <Run Text="{Binding CountText, Mode=OneWay}" /><Run Text="Every design Claude applies is kept here, with the Desk it replaced. Ten are kept; the oldest goes first, and a pinned design is never dropped." />
            </TextBlock>
            <Button Style="{DynamicResource FlatButton}" HorizontalAlignment="Left" Padding="12,6" Margin="0,10,0,0"
                    Content="{x:Static core:SettingsNames.PutMyDeskBack}"
                    Command="{Binding PutBackCommand}"
                    AutomationProperties.Name="{x:Static core:SettingsNames.PutMyDeskBack}"
                    AutomationProperties.HelpText="Switches to the design saved before the last change" />
            <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                       AutomationProperties.LiveSetting="Polite"
                       Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}"
                       Text="{Binding Status}"
                       Visibility="{Binding HasStatus, Converter={StaticResource BoolVis}}" />
            <TextBlock FontSize="11" Margin="0,10,0,0"
                       Foreground="{DynamicResource Sanduhr.Brush.TextDim}"
                       Text="No designs yet. The first one is kept when Claude changes your Desk."
                       Visibility="{Binding HasNoDesigns, Converter={StaticResource BoolVis}}" />
            <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" Margin="0,10,0,0"
                          AutomationProperties.Name="Saved designs">
                <ItemsControl.ItemContainerStyle>
                    <!-- The row reads as its summary, "Orbital, pinned, applied Oct 21 8:15 PM", not as the type of the item behind it. -->
                    <Style TargetType="ContentPresenter">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Summary}" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="6" Padding="10" Margin="0,0,0,8" BorderThickness="1"
                                Background="{DynamicResource Sanduhr.Brush.Bg}"
                                BorderBrush="{DynamicResource Sanduhr.Brush.Border}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource Sanduhr.Brush.Text}" />
                                    <TextBlock Text="{Binding Date, StringFormat='Applied {0}'}" FontSize="10.5"
                                               Foreground="{DynamicResource Sanduhr.Brush.TextDim}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{DynamicResource FlatButton}" Padding="8,4" Margin="0,0,4,0"
                                            Content="Switch to"
                                            Command="{Binding DataContext.SwitchToCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="{Binding SwitchName}" />
                                    <Button Style="{DynamicResource FlatButton}" Padding="8,4" Margin="0,0,4,0"
                                            Content="Rename"
                                            Command="{Binding DataContext.RenameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="{Binding RenameName}" />
                                    <Button Style="{DynamicResource FlatButton}" Padding="8,4" Margin="0,0,4,0"
                                            Content="{Binding PinText}"
                                            Command="{Binding DataContext.PinCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="{Binding PinName}" />
                                    <Button Style="{DynamicResource FlatButton}" Padding="8,4" Margin="0"
                                            Content="Delete"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="{Binding DeleteName}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
</UserControl>
