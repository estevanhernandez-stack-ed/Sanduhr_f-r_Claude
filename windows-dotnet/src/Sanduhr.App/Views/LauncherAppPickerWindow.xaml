<Window x:Class="Sanduhr.App.Views.LauncherAppPickerWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add app"
        Width="480" Height="580" MinWidth="380" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Sanduhr.Brush.GlassChrome}"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        UseLayoutRounding="True"
        AutomationProperties.Name="Add app">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="LauncherDialogStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolVis" />
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Add app" FontSize="15" FontWeight="SemiBold"
                   Foreground="{DynamicResource Sanduhr.Brush.Text}" />
        <TextBox Grid.Row="1" x:Name="SearchBox" Style="{StaticResource DialogInput}" Margin="0,12,0,10"
                 AutomationProperties.Name="Search apps"
                 TextChanged="OnSearchChanged" PreviewKeyDown="OnSearchKeyDown" />

        <Border Grid.Row="2" CornerRadius="6" BorderThickness="1"
                BorderBrush="{DynamicResource Sanduhr.Brush.Border}"
                Background="{DynamicResource Sanduhr.Brush.Bg}">
            <Grid>
                <ListBox x:Name="AppList" Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource Sanduhr.Brush.Text}"
                         AutomationProperties.Name="Apps"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         MouseDoubleClick="OnListDoubleClick"
                         SelectionChanged="OnSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="6" HorizontalAlignment="Left">
                                    <Image Source="{Binding Icon}" Width="36" Height="36" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource Sanduhr.Brush.Text}" />
                                    <TextBlock Text="{Binding Aumid}" FontSize="10.5" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource Sanduhr.Brush.TextDim}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="StatusText" Text="Reading your Start menu…" FontSize="12"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite"
                           Foreground="{DynamicResource Sanduhr.Brush.TextDim}" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="3" Margin="0,10,0,0" FontSize="11" TextWrapping="Wrap"
                   Foreground="{DynamicResource Sanduhr.Brush.TextDim}"
                   Text="The apps in your Start menu: programs, Store apps and Chrome or Edge web apps. Sanduhr opens the one you pick through Windows; it never runs a command." />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Style="{StaticResource DialogButton}" IsCancel="True" Click="OnCancelClick"
                    AutomationProperties.Name="Cancel" />
            <Button x:Name="AddButton" Content="Add" Style="{StaticResource DialogAccentButton}" IsDefault="True"
                    IsEnabled="False" Click="OnAddClick" AutomationProperties.Name="Add the selected app" />
        </StackPanel>
    </Grid>
</Window>
