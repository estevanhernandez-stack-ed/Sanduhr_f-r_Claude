<Window x:Class="Sanduhr.App.Views.ResetWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reset Sanduhr"
        AutomationProperties.Name="Reset Sanduhr"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Width="470"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Same flat button and check box as Settings and What's New (those live in their own resources). -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Sanduhr.Brush.Text}" />
            <Setter Property="Background" Value="{DynamicResource Sanduhr.Brush.Glass}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Sanduhr.Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource Sanduhr.Brush.GlassHover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource Sanduhr.Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The one destructive button: a fixed deep red with white text, legible on dark and light themes alike. -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#B3261E" />
            <Setter Property="BorderBrush" Value="#B3261E" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#CC3A31" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource Sanduhr.Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemedCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Sanduhr.Brush.Text}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="box" Width="16" Height="16" CornerRadius="3"
                                    VerticalAlignment="Center" Margin="0,0,8,0"
                                    Background="{DynamicResource Sanduhr.Brush.Bg}"
                                    BorderBrush="{DynamicResource Sanduhr.Brush.Border}" BorderThickness="1">
                                <Path x:Name="check" Stretch="Uniform" Margin="2"
                                      Data="M0,5 L4,9 L11,0" Visibility="Collapsed"
                                      Stroke="{DynamicResource Sanduhr.Brush.Accent}" StrokeThickness="2" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Sanduhr.Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Sanduhr.Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Frame" CornerRadius="10"
            Background="{DynamicResource Sanduhr.Brush.GlassChrome}"
            BorderBrush="{DynamicResource Sanduhr.Brush.Border}"
            BorderThickness="1"
            MouseLeftButtonDown="Frame_MouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="2" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Accent strip, matching the widget's title bar and the themed dialogs. -->
            <Border Grid.Row="0" CornerRadius="10,10,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="{DynamicResource Sanduhr.Color.Accent}" />
                        <GradientStop Offset="1" Color="{DynamicResource Sanduhr.Color.AccentFade}" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <TextBlock Grid.Row="1" Text="Reset Sanduhr" FontSize="14" FontWeight="SemiBold" Margin="20,18,20,0"
                       AutomationProperties.Name="Reset Sanduhr"
                       Foreground="{DynamicResource Sanduhr.Brush.Text}" />

            <!-- Choose. -->
            <StackPanel x:Name="ChoosePanel" Grid.Row="2" Margin="20,12,20,0">
                <TextBlock Text="Choose what Sanduhr removes from this PC."
                           TextWrapping="Wrap" FontSize="12" LineHeight="18" Margin="0,0,0,12"
                           AutomationProperties.Name="What this does"
                           Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />

                <CheckBox x:Name="ClaudeCodeBox" Style="{StaticResource ThemedCheckBox}" IsChecked="True"
                          Content="Sanduhr's entries in Claude Code (statusline, MCP server, meters mod, glow hook)"
                          AutomationProperties.Name="Sanduhr's entries in Claude Code (statusline, MCP server, meters mod, glow hook)"
                          Margin="0,0,0,4" Checked="Choice_Changed" Unchecked="Choice_Changed" />
                <TextBlock x:Name="ClaudeCodeWarning" Margin="24,0,0,10" TextWrapping="Wrap" FontSize="11"
                           Text="An entry you leave unchecked can't be removed from Sanduhr later."
                           AutomationProperties.Name="Warning about leaving the Claude Code entries unchecked"
                           Foreground="{DynamicResource Sanduhr.Brush.PaceMarker}" />
                <CheckBox x:Name="AccountsBox" Style="{StaticResource ThemedCheckBox}" IsChecked="True"
                          Content="Accounts and sign-in keys"
                          AutomationProperties.Name="Accounts and sign-in keys"
                          Margin="0,0,0,10" Checked="Choice_Changed" Unchecked="Choice_Changed" />
                <CheckBox x:Name="HistoryBox" Style="{StaticResource ThemedCheckBox}" IsChecked="True"
                          Content="Meter history and the session archive"
                          AutomationProperties.Name="Meter history and the session archive"
                          Margin="0,0,0,10" Checked="Choice_Changed" Unchecked="Choice_Changed" />
                <CheckBox x:Name="ThemesBox" Style="{StaticResource ThemedCheckBox}" IsChecked="True"
                          Content="Your themes and widgets"
                          AutomationProperties.Name="Your themes and widgets"
                          Margin="0,0,0,10" Checked="Choice_Changed" Unchecked="Choice_Changed" />
                <CheckBox x:Name="SettingsBox" Style="{StaticResource ThemedCheckBox}" IsChecked="True"
                          Content="Settings"
                          AutomationProperties.Name="Settings"
                          Margin="0,0,0,12" Checked="Choice_Changed" Unchecked="Choice_Changed" />

                <TextBlock Text="Sanduhr quits when the reset is done. Backups of Claude Code files stay in the backups folder."
                           TextWrapping="Wrap" FontSize="11" LineHeight="16"
                           AutomationProperties.Name="What happens after the reset"
                           Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
            </StackPanel>

            <!-- Running, then results. -->
            <StackPanel x:Name="ResultPanel" Grid.Row="2" Margin="20,12,20,0" Visibility="Collapsed">
                <TextBlock x:Name="ProgressText" TextWrapping="Wrap" FontSize="12" LineHeight="18" Margin="0,0,0,8"
                           AutomationProperties.Name="Reset progress"
                           Foreground="{DynamicResource Sanduhr.Brush.Text}" />
                <ItemsControl x:Name="ResultsList" Focusable="False"
                              AutomationProperties.Name="Reset results">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontSize="12" TextWrapping="Wrap"
                                               AutomationProperties.Name="{Binding Name}"
                                               Foreground="{DynamicResource Sanduhr.Brush.Text}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="12" FontWeight="SemiBold"
                                               Margin="12,0,0,0" VerticalAlignment="Top"
                                               AutomationProperties.Name="{Binding Status}"
                                               Foreground="{Binding StatusBrush}" />
                                </Grid>
                                <TextBlock Text="{Binding Detail}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Visibility="{Binding DetailVisibility}"
                                           AutomationProperties.Name="{Binding Detail}"
                                           Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="AfterText" TextWrapping="Wrap" FontSize="11" LineHeight="16" Margin="0,4,0,0"
                           Visibility="Collapsed"
                           AutomationProperties.Name="After the reset"
                           Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
            </StackPanel>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,18,20,18">
                <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Click="Cancel_Click"
                        Style="{StaticResource FlatButton}" Margin="0,0,8,0"
                        AutomationProperties.Name="Cancel, keep everything" />
                <Button x:Name="ResetButton" Content="Reset" Click="Reset_Click"
                        Style="{StaticResource DangerButton}"
                        AutomationProperties.Name="Reset Sanduhr with the checked parts" />
                <Button x:Name="QuitButton" Content="Quit" Click="Quit_Click" Visibility="Collapsed"
                        Style="{StaticResource FlatButton}"
                        AutomationProperties.Name="Quit Sanduhr" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
