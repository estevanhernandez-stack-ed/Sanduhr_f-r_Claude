<UserControl x:Class="Sanduhr.App.Views.WidgetsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Sanduhr.App.Views"
             xmlns:core="clr-namespace:Sanduhr.Core;assembly=Sanduhr.Core"
             xmlns:vm="clr-namespace:Sanduhr.App.ViewModels">
    <!-- Settings, Widgets (spec 3.8, sections 2 and 3). Hosted inside SettingsWindow: FlatButton, AccentButton and
         SlimThemeScrollBar come from that window's resources (DynamicResource), and every color is a theme brush, so
         the page reads in light and dark alike. The page is its own scroll area. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />

        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Foreground" Value="{DynamicResource Sanduhr.Brush.Text}" />
        </Style>

        <Style x:Key="Dim" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource Sanduhr.Brush.TextDim}" />
        </Style>

        <!-- A pack's preview: pixel art, so nearest-neighbour, never smoothed. -->
        <Style x:Key="Preview" TargetType="Image">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="RenderOptions.BitmapScalingMode" Value="NearestNeighbor" />
        </Style>

        <DataTemplate DataType="{x:Type vm:WidgetCatalogRowViewModel}">
            <Border Background="{DynamicResource Sanduhr.Brush.Bg}" BorderBrush="{DynamicResource Sanduhr.Brush.Border}"
                    BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8"
                    AutomationProperties.Name="{Binding RowName}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Style="{StaticResource Preview}" Source="{Binding Preview}"
                           Visibility="{Binding HasPreview, Converter={StaticResource BoolVis}}"
                           AutomationProperties.Name="{Binding Name, StringFormat='Preview of {0}'}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Sanduhr.Brush.Text}" />
                        <TextBlock Text="{Binding Detail}" FontSize="11" Margin="0,2,0,0"
                                   Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                        <TextBlock Text="{Binding Description}" Style="{StaticResource Dim}" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding State}" Style="{StaticResource Dim}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{DynamicResource FlatButton}" VerticalAlignment="Center" Margin="8,0,0,0"
                            Content="{Binding ActionLabel}" Command="{Binding ActCommand}"
                            Visibility="{Binding HasAction, Converter={StaticResource BoolVis}}"
                            IsEnabled="{Binding DataContext.Busy, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static views:WidgetsPage.Not}}"
                            AutomationProperties.Name="{Binding ActionName}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:InstalledWidgetRowViewModel}">
            <Border Background="{DynamicResource Sanduhr.Brush.Bg}" BorderBrush="{DynamicResource Sanduhr.Brush.Border}"
                    BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8"
                    AutomationProperties.Name="{Binding RowName}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Style="{StaticResource Preview}" Source="{Binding Preview}"
                           Visibility="{Binding HasPreview, Converter={StaticResource BoolVis}}"
                           AutomationProperties.Name="{Binding Name, StringFormat='Preview of {0}'}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Sanduhr.Brush.Text}" />
                        <TextBlock Text="{Binding Detail}" FontSize="11" Margin="0,2,0,0"
                                   Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                        <TextBlock Text="{Binding Description}" Style="{StaticResource Dim}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{DynamicResource FlatButton}" VerticalAlignment="Center" Margin="8,0,0,0"
                            Content="{x:Static core:SettingsNames.WidgetUninstall}" Command="{Binding UninstallCommand}"
                            IsEnabled="{Binding DataContext.Busy, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static views:WidgetsPage.Not}}"
                            AutomationProperties.Name="{Binding UninstallName}" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="{DynamicResource Sanduhr.Brush.Glass}" CornerRadius="8">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimThemeScrollBar}" />
            </ScrollViewer.Resources>
            <StackPanel Margin="20">
                <TextBlock Text="Widgets" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource Sanduhr.Brush.Text}" Margin="0,0,0,12" />

                <!-- The Desk companion (spec 3.8 section 4): one sprite at a time, shown or hidden, roaming or sitting. -->
                <StackPanel views:SettingsAnchor.Id="widgets-companion">
                    <TextBlock Text="Desk companion" Style="{StaticResource Heading}" />
                    <TextBlock Style="{StaticResource Dim}" Margin="0,0,0,8"
                               Visibility="{Binding HasCompanions, Converter={x:Static views:WidgetsPage.NotVisible}}"
                               Text="Install a sprite from the catalog below and it can live on your Desk." />
                    <StackPanel Visibility="{Binding HasCompanions, Converter={StaticResource BoolVis}}">
                        <TextBlock Style="{StaticResource Dim}" Margin="0,0,0,8"
                                   Text="A sprite that lives on your Desk. It grows with the days you code, never with the usage you spend, and its mood follows your pace. It never dies; time away only pauses it." />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="{x:Static core:SettingsNames.WidgetCompanionPick}" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" Margin="0,0,8,0" />
                            <ComboBox x:Name="CompanionPicker" Style="{DynamicResource ThemedComboBox}" Width="230"
                                      ItemsSource="{Binding Companions}" DisplayMemberPath="Name"
                                      SelectedItem="{Binding SelectedCompanion, Mode=TwoWay}"
                                      AutomationProperties.Name="{x:Static core:SettingsNames.WidgetCompanionPick}" />
                        </StackPanel>
                        <CheckBox x:Name="CompanionShowSwitch" Style="{DynamicResource ThemedCheckBox}" Margin="0,0,0,6"
                                  Content="{x:Static core:SettingsNames.WidgetCompanionShow}"
                                  IsChecked="{Binding CompanionShown, Mode=TwoWay}"
                                  AutomationProperties.Name="{x:Static core:SettingsNames.WidgetCompanionShow}" />
                        <CheckBox x:Name="CompanionRoamSwitch" Style="{DynamicResource ThemedCheckBox}"
                                  Content="{x:Static core:SettingsNames.WidgetCompanionRoam}"
                                  IsChecked="{Binding CompanionRoams, Mode=TwoWay}"
                                  AutomationProperties.Name="{x:Static core:SettingsNames.WidgetCompanionRoam}"
                                  AutomationProperties.HelpText="It walks the edges of its monitor. With Windows' animations off it stays put." />
                        <TextBlock Style="{StaticResource Dim}" Margin="0,4,0,0"
                                   Text="It walks the edges of its monitor and stops now and then. With Windows' animations off it stays put and moves at one frame a second. Where it sits is in Settings, Desk." />
                        <TextBlock x:Name="CompanionStatusLine" Text="{Binding CompanionStatus}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}"
                                   AutomationProperties.Name="Companion status" />
                    </StackPanel>
                </StackPanel>

                <Border Height="1" Background="{DynamicResource Sanduhr.Brush.Border}" Margin="0,8,0,16" />

                <StackPanel views:SettingsAnchor.Id="widgets-catalog">
                    <TextBlock Text="Widget catalog" Style="{StaticResource Heading}" />
                    <TextBlock Style="{StaticResource Dim}" Margin="0,0,0,8"
                               Text="Sprites, themes, palettes, effects and fonts from the 626 Labs widget catalog. Packs are data only, no code. Sanduhr checks the catalog's signature, then each pack's size, hash and every file before it installs one." />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusLine" Text="{Binding Status}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}"
                                   AutomationProperties.Name="Widget catalog status"
                                   AutomationProperties.LiveSetting="Polite" />
                        <Button Grid.Column="1" Style="{DynamicResource FlatButton}" Margin="8,0,0,0"
                                Content="{x:Static core:SettingsNames.WidgetCatalogCheck}" Command="{Binding CheckAgainCommand}"
                                IsEnabled="{Binding Busy, Converter={x:Static views:WidgetsPage.Not}}"
                                AutomationProperties.Name="{x:Static core:SettingsNames.WidgetCatalogCheck}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Catalog}" Focusable="False"
                                  AutomationProperties.Name="Widgets in the catalog" />
                </StackPanel>

                <Border Height="1" Background="{DynamicResource Sanduhr.Brush.Border}" Margin="0,8,0,16" />

                <StackPanel views:SettingsAnchor.Id="widgets-installed">
                    <TextBlock Text="Installed widgets" Style="{StaticResource Heading}" />
                    <TextBlock Style="{StaticResource Dim}" Margin="0,0,0,8"
                               Visibility="{Binding HasInstalled, Converter={x:Static views:WidgetsPage.NotVisible}}"
                               Text="Nothing installed yet. Widgets you make with Claude will show here too, marked made here." />
                    <ItemsControl ItemsSource="{Binding Installed}" Focusable="False"
                                  AutomationProperties.Name="Installed widgets" />
                    <TextBlock Style="{StaticResource Dim}" Margin="0,4,0,0"
                               Text="Installed packs live in Sanduhr's own widgets folder on this PC. Opening this page asks GitHub for the catalog, and Install downloads the pack from GitHub; nothing else is sent. Reset Sanduhr removes the folder." />
                </StackPanel>

                <Border Height="1" Background="{DynamicResource Sanduhr.Brush.Border}" Margin="0,16,0,16" />
                <TextBlock Text="{x:Static core:SettingsNames.TrademarkNotice}"
                           TextWrapping="Wrap" FontSize="11"
                           Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
