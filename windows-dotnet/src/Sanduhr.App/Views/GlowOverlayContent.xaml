<UserControl x:Class="Sanduhr.App.Views.GlowOverlayContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False" Focusable="False">
    <!-- An edge light: a bright 2 px line along the top and a wash falling about 24 px below it. The
         horizontal OpacityMask fades both to nothing at the ends so the band reads as light coming
         from the window's top edge rather than a bar. Colors are set in code from the live theme. -->
    <Grid x:Name="Root" SnapsToDevicePixels="False">
        <Grid.OpacityMask>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#00000000" Offset="0" />
                <GradientStop Color="#FF000000" Offset="0.22" />
                <GradientStop Color="#FF000000" Offset="0.78" />
                <GradientStop Color="#00000000" Offset="1" />
            </LinearGradientBrush>
        </Grid.OpacityMask>
        <Rectangle x:Name="Wash" />
        <Rectangle x:Name="Line" Height="2" VerticalAlignment="Top" />
    </Grid>
</UserControl>
