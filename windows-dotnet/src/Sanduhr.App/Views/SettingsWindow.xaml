<Window x:Class="Sanduhr.App.Views.SettingsWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Sanduhr.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
        Title="Sanduhr — Settings"
        Height="540" Width="520"
        MinHeight="440" MinWidth="460"
        WindowStartupLocation="CenterScreen"
        Background="#0d0d0d"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        Icon="/Assets/Sanduhr.ico">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />

        <!-- Obsidian-themed primitives matching the widget. -->
        <SolidColorBrush x:Key="Bg" Color="#0d0d0d" />
        <SolidColorBrush x:Key="Panel" Color="#161616" />
        <SolidColorBrush x:Key="PanelHover" Color="#1f1f1f" />
        <SolidColorBrush x:Key="Field" Color="#1c1c1c" />
        <SolidColorBrush x:Key="Border" Color="#333333" />
        <SolidColorBrush x:Key="Text" Color="#e8e4dc" />
        <SolidColorBrush x:Key="TextSecondary" Color="#b8b4ac" />
        <SolidColorBrush x:Key="TextDim" Color="#777777" />
        <SolidColorBrush x:Key="Accent" Color="#17d4fa" />
        <SolidColorBrush x:Key="Danger" Color="#f87171" />

        <!-- Flat dark button. -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="{StaticResource Field}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource PanelHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary accent button. -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Foreground" Value="#0d0d0d" />
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab strip styled dark. -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" Padding="16,8" Margin="0,0,4,0" CornerRadius="6,6,0,0"
                                Background="Transparent">
                            <ContentPresenter ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Panel}" />
                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PanelHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="2" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Accent gradient strip (626 cyan -> magenta), mirrors the widget. -->
        <Border Grid.Row="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Offset="0" Color="#17d4fa" />
                    <GradientStop Offset="1" Color="#f22f89" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <TabControl Grid.Row="1" Margin="16,12,16,16" Background="Transparent">

            <!-- Accounts tab — the feature. -->
            <TabItem Header="Accounts">
                <Border Background="{StaticResource Panel}" CornerRadius="0,8,8,8" Padding="16">
                    <Grid DataContext="{Binding Accounts}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" TextWrapping="Wrap" FontSize="11"
                                   Foreground="{StaticResource TextSecondary}" Margin="0,0,0,12"
                                   Text="Track multiple Claude accounts in one install. Switch which one is active to send fetches and history to that account. Each account's history is stored in its own file." />

                        <!-- Account list -->
                        <Border Grid.Row="1" Background="{StaticResource Bg}" CornerRadius="6"
                                BorderBrush="{StaticResource Border}" BorderThickness="1">
                            <Grid>
                                <ListBox x:Name="AccountsList"
                                         ItemsSource="{Binding Accounts}"
                                         SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                                         Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         HorizontalContentAlignment="Stretch">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="10,8" />
                                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="row" Background="Transparent"
                                                                Padding="{TemplateBinding Padding}" CornerRadius="4">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="row" Property="Background" Value="{StaticResource PanelHover}" />
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="row" Property="Background" Value="#2A2A2E" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Marker}"
                                                           Foreground="{StaticResource Accent}" FontSize="12"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Label}"
                                                           Foreground="{StaticResource Text}" FontSize="13"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="active" FontSize="10"
                                                           Foreground="{StaticResource Accent}"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding IsActive, Converter={StaticResource BoolVis}}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Empty hint -->
                                <TextBlock Text="No accounts yet. Click &quot;Add account…&quot; to sign in."
                                           Foreground="{StaticResource TextDim}" FontSize="11"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding HasNoAccounts, Converter={StaticResource BoolVis}}" />
                            </Grid>
                        </Border>

                        <!-- Per-selection actions -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Style="{StaticResource FlatButton}" Content="Switch to"
                                    Command="{Binding SwitchToCommand}" />
                            <Button Style="{StaticResource FlatButton}" Content="Rename…"
                                    Command="{Binding RenameCommand}" />
                            <Button Style="{StaticResource FlatButton}" Content="Sign out"
                                    Command="{Binding SignOutCommand}" Foreground="{StaticResource Danger}" />
                        </StackPanel>

                        <!-- Add -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Style="{StaticResource AccentButton}" Content="Add account…"
                                    Command="{Binding AddCommand}" Margin="0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>

            <!-- General tab — thin; room for items 8/9/10. -->
            <TabItem Header="General">
                <Border Background="{StaticResource Panel}" CornerRadius="0,8,8,8" Padding="20">
                    <StackPanel>
                        <TextBlock Text="General" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource Text}" Margin="0,0,0,8" />

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="Active account: " FontSize="12" Foreground="{StaticResource TextSecondary}" />
                            <TextBlock Text="{Binding Accounts.ActiveLabel}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource Accent}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="Version: " FontSize="12" Foreground="{StaticResource TextSecondary}" />
                            <TextBlock Text="{Binding Version}" FontSize="12" Foreground="{StaticResource Text}" />
                        </StackPanel>

                        <Border Height="1" Background="{StaticResource Border}" Margin="0,16,0,16" />

                        <TextBlock Text="Coming in later builds" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextDim}" Margin="0,0,0,6" />
                        <TextBlock FontSize="11" Foreground="{StaticResource TextDim}" TextWrapping="Wrap"
                                   Text="• Themes — 5 palettes + custom JSON drop-ins&#x0a;• History charts + CSV export + local Claude Code reader&#x0a;• Focus timer (hourglass), cooldown game, and auto-start" />
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
