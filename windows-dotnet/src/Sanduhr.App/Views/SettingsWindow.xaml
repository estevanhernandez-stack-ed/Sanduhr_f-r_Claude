<Window x:Class="Sanduhr.App.Views.SettingsWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:Sanduhr.App.ViewModels"
        xmlns:views="clr-namespace:Sanduhr.App.Views"
        xmlns:conv="clr-namespace:Sanduhr.App.Converters"
        xmlns:controls="clr-namespace:Sanduhr.App.Controls"
        xmlns:core="clr-namespace:Sanduhr.Core;assembly=Sanduhr.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
        Title="Sanduhr — Settings"
        Height="800" Width="780"
        MinHeight="520" MinWidth="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        Background="{DynamicResource Sanduhr.Brush.Bg}"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        UseLayoutRounding="True"
        Icon="/Assets/Sanduhr.ico">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome x:Name="Chrome"
                            CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />
        <conv:StringToVisibilityConverter x:Key="StrVis" />

        <!-- Flat themed button (re-tints with the active theme). -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource Sanduhr.Brush.Text}" />
            <Setter Property="Background" Value="{DynamicResource Sanduhr.Brush.Glass}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Sanduhr.Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource Sanduhr.Brush.GlassHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                            <!-- WF38: a ring in the text ink, which reads on glass and on an accent-filled pill alike. -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource Sanduhr.Brush.Text}" />
                                <Setter TargetName="bg" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The sidebar foot's Quit: a FlatButton that shows keyboard focus. -->
        <Style x:Key="SidebarQuitButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Sanduhr.Brush.Text}" />
            <Setter Property="Background" Value="{DynamicResource Sanduhr.Brush.Glass}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Sanduhr.Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource Sanduhr.Brush.GlassHover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource Sanduhr.Brush.Accent}" />
                                <Setter TargetName="bg" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary accent button — accent fill, theme-bg ink. -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Foreground" Value="{DynamicResource Sanduhr.Brush.Bg}" />
            <Setter Property="Background" Value="{DynamicResource Sanduhr.Brush.Accent}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource Sanduhr.Brush.Text}" />
                                <Setter TargetName="bg" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A lint finding: the field in the accent, the sentence after it; errors take
             the pace-marker ink for the field so the two levels read apart. -->
        <DataTemplate x:Key="ThemeFindingTemplate">
            <TextBlock FontSize="10.5" TextWrapping="Wrap" Margin="0,1"
                       Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}">
                <Run Text="{Binding Field, Mode=OneWay}" FontFamily="Cascadia Code, Consolas">
                    <Run.Style>
                        <Style TargetType="Run">
                            <Setter Property="Foreground" Value="{DynamicResource Sanduhr.Brush.Accent}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Sanduhr.Brush.PaceMarker}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Run.Style>
                </Run><Run Text=" " /><Run Text="{Binding Message, Mode=OneWay}" />
            </TextBlock>
        </DataTemplate>

        <!-- Themed text input (Themes tab paste box + filename). -->
        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Sanduhr.Brush.Bg}" />
            <Setter Property="Foreground" Value="{DynamicResource Sanduhr.Brush.Text}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Sanduhr.Brush.Text}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Sanduhr.Brush.Accent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Sanduhr.Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="FontSize" Value="12" />
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Sanduhr.Brush.Accent}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Themed slider (Theme Studio dials): a 4 px track in the border ink with the
             filled part in the accent, and a round thumb. -->
        <Style x:Key="ThemedSlider" TargetType="Slider">
            <Setter Property="Height" Value="18" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource Sanduhr.Brush.Border}" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{DynamicResource Sanduhr.Brush.Accent}" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{DynamicResource Sanduhr.Brush.Text}"
                                                         Stroke="{DynamicResource Sanduhr.Brush.Accent}" StrokeThickness="2" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar (Settings v2): each page is a TabItem drawn as a sidebar row, with its
             group's heading above the first page of a group (SettingsSidebar.GroupHeader).
             Arrow keys move between pages; the selected row carries the accent. -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource Sanduhr.Brush.TextSecondary}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <StackPanel>
                            <TextBlock x:Name="group" IsHitTestVisible="False"
                                       Text="{Binding (views:SettingsSidebar.GroupHeader), RelativeSource={RelativeSource TemplatedParent}}"
                                       FontSize="10.5" FontWeight="SemiBold" Margin="10,14,0,4"
                                       Foreground="{DynamicResource Sanduhr.Brush.TextDim}" />
                            <Border x:Name="bd" Padding="10,7" Margin="0,1" CornerRadius="6"
                                    Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                                <ContentPresenter ContentSource="Header" />
                            </Border>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="views:SettingsSidebar.GroupHeader" Value="{x:Null}">
                                <Setter TargetName="group" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Sanduhr.Brush.GlassHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Sanduhr.Brush.Glass}" />
                                <Setter Property="Foreground" Value="{DynamicResource Sanduhr.Brush.Accent}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Sanduhr.Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A search result row: a page in SemiBold, its sections indented under it. -->
        <Style x:Key="SearchResultItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Sanduhr.Brush.Text}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="row" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="5" Padding="8,5">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="row" Property="Background" Value="{DynamicResource Sanduhr.Brush.GlassHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="row" Property="Background" Value="{DynamicResource Sanduhr.Brush.Glass}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="row" Property="BorderBrush" Value="{DynamicResource Sanduhr.Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Themed dropdown item (History account selector). -->
        <Style x:Key="ThemedComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Sanduhr.Brush.Text}" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ib" Background="Transparent" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ib" Property="Background" Value="{DynamicResource Sanduhr.Brush.GlassHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ib" Property="Background" Value="{DynamicResource Sanduhr.Brush.GlassHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Themed combo box (History account selector). Flat glass field, accent
             focus, themed popup — no white OS chrome. -->
        <Style x:Key="ThemedComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource Sanduhr.Brush.Text}" />
            <Setter Property="Background" Value="{DynamicResource Sanduhr.Brush.Bg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Sanduhr.Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="30" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ThemedComboItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="bd" CornerRadius="6"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="22" />
                                    </Grid.ColumnDefinitions>
                                    <!-- DisplayMemberPath never produces a SelectionBoxItemTemplate; WPF
                                         routes it through ItemTemplateSelector, so the closed box must bind
                                         that selector too or it falls back to the item's ToString. -->
                                    <ContentPresenter Grid.Column="0" Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center" HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                                    <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Data="M0,0 L8,0 L4,5 Z"
                                          Fill="{DynamicResource Sanduhr.Brush.TextDim}" />
                                </Grid>
                            </Border>
                            <ToggleButton Focusable="False" Background="Transparent" BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Slide"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Background="{DynamicResource Sanduhr.Brush.Bg}"
                                        BorderBrush="{DynamicResource Sanduhr.Brush.Border}" BorderThickness="1"
                                        CornerRadius="6" Margin="0,2,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="220">
                                        <ScrollViewer.Resources>
                                            <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimThemeScrollBar}" />
                                        </ScrollViewer.Resources>
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Sanduhr.Brush.Accent}" />
                            </Trigger>
                            <!-- WF38: a disabled combo (demo mode's Linked account) looks disabled. -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Themed check box (Local CC "show breakdowns"). -->
        <Style x:Key="ThemedCheckBox" TargetType="CheckBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource Sanduhr.Brush.Text}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="box" Width="16" Height="16" CornerRadius="3"
                                    VerticalAlignment="Center" Margin="0,0,8,0"
                                    Background="{DynamicResource Sanduhr.Brush.Bg}"
                                    BorderBrush="{DynamicResource Sanduhr.Brush.Border}" BorderThickness="1">
                                <Path x:Name="check" Stretch="Uniform" Margin="2"
                                      Data="M0,5 L4,9 L11,0" Visibility="Collapsed"
                                      Stroke="{DynamicResource Sanduhr.Brush.Accent}" StrokeThickness="2" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Sanduhr.Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Sanduhr.Brush.Accent}" />
                                <Setter TargetName="box" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Shortcut keys button: FlatButton whose border turns accent while recording. -->
        <Style x:Key="ShortcutKeysButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Shortcuts.IsRecording}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Sanduhr.Brush.Accent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Window-range pill (History Week / Month): FlatButton that fills with
             accent when active (the bound DataTrigger sets Button.Background, which
             the FlatButton template surfaces via TemplateBinding). -->
        <Style x:Key="RangePillWeek" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding WeekMode}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Sanduhr.Brush.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Sanduhr.Brush.Bg}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RangePillMonth" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding WeekMode}" Value="False">
                    <Setter Property="Background" Value="{DynamicResource Sanduhr.Brush.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Sanduhr.Brush.Bg}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Claude Usage sub-nav pills (Overview / Trends / Sessions) — same
             accent-fill-when-active grammar as the History RangePills. -->
        <Style x:Key="CcNavMeters" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Section}" Value="Meters">
                    <Setter Property="Background" Value="{DynamicResource Sanduhr.Brush.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Sanduhr.Brush.Bg}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CcNavOverview" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Section}" Value="Overview">
                    <Setter Property="Background" Value="{DynamicResource Sanduhr.Brush.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Sanduhr.Brush.Bg}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CcNavTrends" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Section}" Value="Trends">
                    <Setter Property="Background" Value="{DynamicResource Sanduhr.Brush.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Sanduhr.Brush.Bg}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CcNavSessions" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Section}" Value="Sessions">
                    <Setter Property="Background" Value="{DynamicResource Sanduhr.Brush.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Sanduhr.Brush.Bg}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Trends range pills — the section Grid's DataContext IS the
             CcTrendsViewModel (unlike CcSectionTrends above), so a plain
             {Binding WeeksBack} DataTrigger resolves directly. -->
        <Style x:Key="TrendsPill4" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding WeeksBack}" Value="4">
                    <Setter Property="Background" Value="{DynamicResource Sanduhr.Brush.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Sanduhr.Brush.Bg}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TrendsPill12" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding WeeksBack}" Value="12">
                    <Setter Property="Background" Value="{DynamicResource Sanduhr.Brush.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Sanduhr.Brush.Bg}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TrendsPill26" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding WeeksBack}" Value="26">
                    <Setter Property="Background" Value="{DynamicResource Sanduhr.Brush.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Sanduhr.Brush.Bg}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Ledger scope chips — the section Grid's DataContext IS the
             CcLedgerViewModel, so a plain {Binding Scope} DataTrigger resolves
             directly (same grammar as the Trends pills above). -->
        <Style x:Key="LedgerChipToday" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Scope}" Value="Today">
                    <Setter Property="Background" Value="{DynamicResource Sanduhr.Brush.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Sanduhr.Brush.Bg}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LedgerChipYesterday" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Scope}" Value="Yesterday">
                    <Setter Property="Background" Value="{DynamicResource Sanduhr.Brush.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Sanduhr.Brush.Bg}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LedgerChip7d" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Scope}" Value="7d">
                    <Setter Property="Background" Value="{DynamicResource Sanduhr.Brush.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Sanduhr.Brush.Bg}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LedgerChipAll" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Scope}" Value="All">
                    <Setter Property="Background" Value="{DynamicResource Sanduhr.Brush.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Sanduhr.Brush.Bg}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Fifth chip, day mode only: a calendar day-click unhighlights all
             four scope chips above (Scope becomes "Jul 13", no DataTrigger
             matches) — without this, day mode has no visible indicator. -->
        <Style x:Key="LedgerChipDay" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Background" Value="{DynamicResource Sanduhr.Brush.Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource Sanduhr.Brush.Bg}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDayMode}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- CRITICAL: each section Grid overrides its own DataContext to the
             section VM (Overview/Trends/Ledger), none of which has a Section
             property — a plain {Binding Section} DataTrigger would silently
             never fire and every section would stay Collapsed. The trigger
             must reach the tab VM through the ancestor TabItem. -->
        <Style x:Key="CcSectionMeters" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.Section, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="Meters">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CcSectionOverview" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.Section, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="Overview">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CcSectionTrends" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.Section, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="Trends">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CcSectionSessions" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.Section, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="Sessions">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- An empty list's line (WF35): shown only while its Tag, bound to the list's HasItems, is false. -->
        <Style x:Key="EmptyLine" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource Sanduhr.Brush.TextDim}" />
            <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="False">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The same for a line that carries a link. -->
        <Style x:Key="EmptyLinkLine" TargetType="WrapPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="False">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A link inside Settings ("Claude Code settings…"): accent text, underlined on hover, ringed on keyboard focus. -->
        <Style x:Key="SettingsLinkButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ring" BorderThickness="1" BorderBrush="Transparent" CornerRadius="3" Padding="2,0">
                            <TextBlock x:Name="t" Text="{TemplateBinding Content}" FontSize="11"
                                       Foreground="{DynamicResource Sanduhr.Brush.Accent}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="t" Property="TextDecorations" Value="Underline" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource Sanduhr.Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A collapsible section (Settings v2, slice 3: Desk's Designs and Advanced, the Layout map's fold): a 44 DIP header with a
             disclosure arrow that takes the keyboard and rings on focus (WF38), the content below. Search hits and links inside open
             it (SettingsWindow.RevealInside). -->
        <Style x:Key="SectionExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource Sanduhr.Brush.Text}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton x:Name="HeaderSite" MinHeight="44" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                          HorizontalContentAlignment="Stretch"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Content="{TemplateBinding Header}"
                                          Tag="{TemplateBinding AutomationProperties.HelpText}"
                                          AutomationProperties.Name="{TemplateBinding AutomationProperties.Name}"
                                          AutomationProperties.HelpText="{TemplateBinding AutomationProperties.HelpText}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ring" Background="Transparent" BorderThickness="1" BorderBrush="Transparent"
                                                CornerRadius="4" Padding="2,4">
                                            <DockPanel>
                                                <TextBlock x:Name="arrow" DockPanel.Dock="Left" Text="&#xE76C;" FontSize="10" Margin="0,0,8,0"
                                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                                                <!-- The title and the summary are drawn by this template, so they are part of the toggle
                                                     (TemplatedParent is the toggle) and not extra UIA elements beside it. -->
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{TemplateBinding Content}" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Sanduhr.Brush.Text}" />
                                                    <TextBlock Text="{TemplateBinding Tag}" FontSize="11" Margin="0,2,0,0"
                                                               Foreground="{DynamicResource Sanduhr.Brush.TextDim}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="arrow" Property="Text" Value="&#xE70D;" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource Sanduhr.Brush.Text}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="Body" Margin="18,8,0,0" Visibility="Collapsed" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Title-bar close button — themed text, square red hover (matches the widget). -->
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Sanduhr.Brush.Text}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <!-- A caption button, as in any Windows title bar: clicked, invoked by a screen reader, or Alt+F4; never a
                 Tab stop, so Tab from the page wraps to the search box (WF33). -->
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#C42B1C" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Themed root panel + custom chrome (parity with the widget). The window paints
         its background via DynamicResource Sanduhr.Brush.Bg, so the whole surface —
         including the title bar — re-tints live when the active theme changes. -->
    <Border x:Name="RootBorder"
            CornerRadius="10"
            Background="{DynamicResource Sanduhr.Brush.Bg}"
            BorderBrush="{DynamicResource Sanduhr.Brush.Border}"
            BorderThickness="1">
        <DockPanel LastChildFill="True">

            <!-- Accent gradient strip (theme accent -> fade), mirrors the widget. -->
            <Border DockPanel.Dock="Top" Height="2" CornerRadius="10,10,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="{DynamicResource Sanduhr.Color.Accent}" />
                        <GradientStop Offset="1" Color="{DynamicResource Sanduhr.Color.AccentFade}" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Custom themed title bar: draggable, themed text, themed close. -->
            <Grid x:Name="TitleBar" DockPanel.Dock="Top" Height="34"
                  Background="{DynamicResource Sanduhr.Brush.TitleBg}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="Sanduhr — Settings" VerticalAlignment="Center" Margin="14,0,0,0"
                           HorizontalAlignment="Left"
                           Foreground="{DynamicResource Sanduhr.Brush.Text}" FontSize="12"
                           ToolTip="Drag to move" />
                <Button Style="{StaticResource CloseButton}" Content="&#x2715;"
                        HorizontalAlignment="Right"
                        Click="CloseButton_Click" ToolTip="Close Settings" AutomationProperties.Name="{x:Static core:SettingsNames.CloseSettings}" />
            </Grid>

            <!-- Pages: a TabControl drawn as a grouped sidebar (Settings v2). Each TabItem's Tag is
                 its SettingsPage, which the router (SelectPage) and the search use. The search box
                 sits above the pages; while it has a query, its results replace the page list. -->
            <controls:SidebarTabControl x:Name="Tabs" Background="Transparent" TabStripPlacement="Left"
                        SelectionChanged="Tabs_SelectionChanged">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <!-- One tab group: search (0), the page list (1), Quit (2), the page (3). Tab past the page's
                             last control wraps to search; Quit is never the next stop after page content (WF33). -->
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource Sanduhr.Brush.TitleBg}"
                                    BorderBrush="{DynamicResource Sanduhr.Brush.Border}" BorderThickness="0,0,1,0">
                                <DockPanel Margin="10,12,10,12">
                                    <!-- The foot of the sidebar: Quit Sanduhr, on every page, the tray's quit. -->
                                    <Button x:Name="QuitButton" DockPanel.Dock="Bottom" Style="{StaticResource SidebarQuitButton}"
                                            Margin="0,8,0,0" Padding="10,5" HorizontalAlignment="Stretch"
                                            KeyboardNavigation.TabIndex="2"
                                            Content="Quit Sanduhr" Command="{Binding QuitCommand}"
                                            AutomationProperties.Name="Quit Sanduhr"
                                            AutomationProperties.HelpText="Closes the widget, the Desk and everything else Sanduhr is showing."
                                            ToolTip="Quit Sanduhr" />
                                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8" KeyboardNavigation.TabIndex="0" KeyboardNavigation.TabNavigation="Local">
                                        <TextBox x:Name="SearchBox" Style="{StaticResource Input}"
                                                 Text="{Binding Search.Query, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="Search settings"
                                                 ToolTip="Find a setting by name: tray, archive, CSV, shortcut, theme"
                                                 PreviewKeyDown="SearchBox_PreviewKeyDown" />
                                        <TextBlock Text="Search settings" IsHitTestVisible="False" Margin="9,0,0,0"
                                                   VerticalAlignment="Center" FontSize="12"
                                                   Foreground="{DynamicResource Sanduhr.Brush.TextDim}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Search.IsSearching}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <Grid KeyboardNavigation.TabIndex="1" KeyboardNavigation.TabNavigation="Local">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                                            <ScrollViewer.Style>
                                                <Style TargetType="ScrollViewer">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Search.IsSearching}" Value="True">
                                                            <Setter Property="Visibility" Value="Hidden" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ScrollViewer.Style>
                                            <ScrollViewer.Resources>
                                                <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimThemeScrollBar}" />
                                            </ScrollViewer.Resources>
                                            <StackPanel IsItemsHost="True"
                                                        KeyboardNavigation.TabNavigation="Once"
                                                        KeyboardNavigation.DirectionalNavigation="Cycle" />
                                        </ScrollViewer>
                                        <Grid Visibility="{Binding Search.IsSearching, Converter={StaticResource BoolVis}}">
                                            <ListBox x:Name="SearchResults" ItemsSource="{Binding Search.Results}"
                                                     Background="Transparent" BorderThickness="0"
                                                     AutomationProperties.Name="Search results"
                                                     ItemContainerStyle="{StaticResource SearchResultItem}"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     PreviewKeyDown="SearchResults_PreviewKeyDown"
                                                     PreviewMouseLeftButtonUp="SearchResults_PreviewMouseLeftButtonUp">
                                                <ListBox.Resources>
                                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimThemeScrollBar}" />
                                                </ListBox.Resources>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock x:Name="t" Text="{Binding DisplayTitle}" FontSize="12" TextWrapping="Wrap"
                                                                   Margin="12,0,0,0"
                                                                   Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsPage}" Value="True">
                                                                <Setter TargetName="t" Property="Margin" Value="0,4,0,0" />
                                                                <Setter TargetName="t" Property="FontWeight" Value="SemiBold" />
                                                                <Setter TargetName="t" Property="Foreground" Value="{DynamicResource Sanduhr.Brush.Text}" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <TextBlock x:Name="NoResultsText" Text="No setting by that name." FontSize="11" Margin="4,4,0,0"
                                                       AutomationProperties.LiveSetting="Polite"
                                                       Foreground="{DynamicResource Sanduhr.Brush.TextDim}"
                                                       Visibility="{Binding Search.HasNoResults, Converter={StaticResource BoolVis}}" />
                                        </Grid>
                                    </Grid>
                                </DockPanel>
                            </Border>
                            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Column="1"
                                              ContentSource="SelectedContent" Margin="16,12,16,16"
                                              KeyboardNavigation.TabIndex="3" KeyboardNavigation.TabNavigation="Local" />
                        </Grid>
                    </ControlTemplate>
                </TabControl.Template>


                <!-- General: the tray, startup and the shortcut. Version, What's New and the tour
                     moved to About (Settings v2). -->
                <TabItem Header="General" Tag="General" AutomationProperties.Name="General">
                    <Border Background="{DynamicResource Sanduhr.Brush.Glass}" CornerRadius="8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                            <ScrollViewer.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimThemeScrollBar}" />
                            </ScrollViewer.Resources>
                        <StackPanel Margin="20">
                            <TextBlock Text="General" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Sanduhr.Brush.Text}" Margin="0,0,0,12" />

                            <!-- Tray (W3): which number the tray icon shows, with a live preview. -->
                            <StackPanel views:SettingsAnchor.Id="tray">
                                <TextBlock Text="Tray" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Sanduhr.Brush.Text}" Margin="0,0,0,8" />
                                <Border Background="{DynamicResource Sanduhr.Brush.Bg}" CornerRadius="6"
                                        BorderBrush="{DynamicResource Sanduhr.Brush.Border}" BorderThickness="1"
                                        Padding="10,8" Margin="0,0,0,10" HorizontalAlignment="Left"
                                        ToolTip="What the tray icon shows now">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding General.TrayPreviewImage}" Width="32" Height="32"
                                               Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding General.TrayPreviewText}" VerticalAlignment="Center"
                                                   FontSize="12" Foreground="{DynamicResource Sanduhr.Brush.Text}" />
                                    </StackPanel>
                                </Border>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{x:Static core:SettingsNames.TrayShows}" VerticalAlignment="Center" FontSize="12"
                                               Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" Margin="0,0,8,0" />
                                    <ComboBox Style="{StaticResource ThemedComboBox}" Width="230"
                                              ItemsSource="{Binding General.TrayModeOptions}"
                                              DisplayMemberPath="Title"
                                              SelectedItem="{Binding General.SelectedTrayMode, Mode=TwoWay}"
                                              AutomationProperties.Name="{x:Static core:SettingsNames.TrayShows}" />
                                </StackPanel>
                                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Foreground="{DynamicResource Sanduhr.Brush.TextDim}"
                                           Text="The number on the tray icon. Rotate switches between session and weekly every 8 seconds." />
                            </StackPanel>

                            <Border Height="1" Background="{DynamicResource Sanduhr.Brush.Border}" Margin="0,16,0,16" />

                            <!-- Startup (item 10): off by default; dual mechanism by install type. -->
                            <StackPanel views:SettingsAnchor.Id="startup">
                                <TextBlock Text="Startup" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Sanduhr.Brush.Text}" Margin="0,0,0,8" />

                                <!-- Unpackaged: a real toggle that writes the HKCU Run entry. -->
                                <CheckBox Style="{StaticResource ThemedCheckBox}"
                                          Content="Start Sanduhr when Windows starts"
                                          IsChecked="{Binding General.AutoStartEnabled, Mode=TwoWay}"
                                          Visibility="{Binding General.IsUnpackaged, Converter={StaticResource BoolVis}}" />

                                <!-- Packaged (Store): can't flip the manifest StartupTask without
                                     WinRT, so deep-link to Windows Settings, Startup apps instead. -->
                                <StackPanel Visibility="{Binding General.IsPackaged, Converter={StaticResource BoolVis}}">
                                    <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"
                                               Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}"
                                               Text="This Store install manages auto-start in Windows Settings. Sanduhr is off by default — turn it on under Startup apps." />
                                    <Button Style="{StaticResource FlatButton}" HorizontalAlignment="Left"
                                            Content="Open Windows Startup settings…"
                                            Command="{Binding General.OpenStartupSettingsCommand}" />
                                </StackPanel>

                                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Foreground="{DynamicResource Sanduhr.Brush.TextDim}"
                                           Text="Off by default. When on, Sanduhr launches hidden in the tray at sign-in." />
                            </StackPanel>

                            <Border Height="1" Background="{DynamicResource Sanduhr.Brush.Border}" Margin="0,16,0,16" />

                            <!-- Shortcuts (S1): the global "open Settings" key. -->
                            <StackPanel views:SettingsAnchor.Id="shortcuts">
                                <TextBlock Text="Shortcuts" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Sanduhr.Brush.Text}" Margin="0,0,0,8" />
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="ShortcutKeysButton" Style="{StaticResource ShortcutKeysButton}"
                                            Content="{Binding Shortcuts.KeysText}"
                                            Command="{Binding Shortcuts.StartRecordingCommand}"
                                            ToolTip="{Binding Shortcuts.KeysToolTip}"
                                            AutomationProperties.Name="{Binding Shortcuts.KeysAutomationName}"
                                            LostKeyboardFocus="ShortcutKeys_LostKeyboardFocus" />
                                    <CheckBox Style="{StaticResource ThemedCheckBox}" Content="{x:Static core:SettingsNames.ShortcutToOpenSettings}"
                                              IsChecked="{Binding Shortcuts.IsOn, Mode=TwoWay}"
                                              AutomationProperties.Name="{Binding Shortcuts.SwitchAutomationName}" />
                                </StackPanel>
                                <Button HorizontalAlignment="Left" Margin="0,6,0,0" Cursor="Hand"
                                        Content="{Binding Shortcuts.ResetText}"
                                        Command="{Binding Shortcuts.ResetCommand}"
                                        AutomationProperties.Name="{Binding Shortcuts.ResetAutomationName}"
                                        Visibility="{Binding Shortcuts.ShowReset, Converter={StaticResource BoolVis}}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="ring" BorderThickness="1" BorderBrush="Transparent" CornerRadius="3" Padding="2,0">
                                                <TextBlock x:Name="t" Text="{TemplateBinding Content}" FontSize="11"
                                                           Foreground="{DynamicResource Sanduhr.Brush.Accent}" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="t" Property="TextDecorations" Value="Underline" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource Sanduhr.Brush.Accent}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="{Binding Shortcuts.Note}"
                                           Foreground="{DynamicResource Sanduhr.Brush.PaceMarker}"
                                           Visibility="{Binding Shortcuts.HasNote, Converter={StaticResource BoolVis}}" />
                                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Foreground="{DynamicResource Sanduhr.Brush.TextDim}"
                                           Text="{Binding Shortcuts.Caption}" />
                            </StackPanel>
                        </StackPanel>
                        </ScrollViewer>
                    </Border>
                </TabItem>

                <!-- Accounts (Settings v2, slice 5): the list, Sign in, and Data for this account (WF1, WF27, WF29, WF30, WF32). -->
                <TabItem Header="Accounts" Tag="Accounts" AutomationProperties.Name="Accounts">
                    <Border Background="{DynamicResource Sanduhr.Brush.Glass}" CornerRadius="8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                            <ScrollViewer.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimThemeScrollBar}" />
                            </ScrollViewer.Resources>
                        <StackPanel Margin="16" DataContext="{Binding Accounts}">
                            <StackPanel views:SettingsAnchor.Id="accounts">
                                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"
                                           Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}"
                                           Text="Track multiple Claude accounts in one install. Switch which one is active to send fetches and history to that account. Each account's history is stored in its own file." />
                                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"
                                           Foreground="{DynamicResource Sanduhr.Brush.Accent}"
                                           Visibility="{Binding IsDemo, Converter={StaticResource BoolVis}}"
                                           Text="Demo mode: these are sample accounts. End demo mode from the tray menu to manage your own." />
                                <StackPanel Margin="0,0,0,12" views:SettingsAnchor.Id="follow">
                                    <CheckBox Style="{StaticResource ThemedCheckBox}"
                                              Content="Follow the account I'm using"
                                              IsChecked="{Binding FollowAccount, Mode=TwoWay}"
                                              AutomationProperties.Name="Follow the account I'm using" />
                                    <TextBlock TextWrapping="Wrap" FontSize="10.5" Margin="22,3,0,0"
                                               Foreground="{DynamicResource Sanduhr.Brush.TextDim}"
                                               Text="{x:Static core:SettingsNames.FollowAccountCaption}" />
                                </StackPanel>

                                <Border Background="{DynamicResource Sanduhr.Brush.Bg}" CornerRadius="6" MinHeight="120" MaxHeight="260"
                                        BorderBrush="{DynamicResource Sanduhr.Brush.Border}" BorderThickness="1">
                                    <Grid>
                                        <ListBox x:Name="AccountsList" AutomationProperties.Name="Accounts"
                                                 KeyboardNavigation.TabNavigation="Once"
                                                 ItemsSource="{Binding Accounts}"
                                                 SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                                                 Background="Transparent" BorderThickness="0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 HorizontalContentAlignment="Stretch">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="10,8" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Sanduhr.Brush.Text}" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="row" Background="Transparent"
                                                                        Padding="{TemplateBinding Padding}" CornerRadius="4">
                                                                    <ContentPresenter />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="row" Property="Background" Value="{DynamicResource Sanduhr.Brush.GlassHover}" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="row" Property="Background" Value="{DynamicResource Sanduhr.Brush.GlassHover}" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="18" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Marker}"
                                                                   Foreground="{DynamicResource Sanduhr.Brush.Accent}" FontSize="12"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Label}"
                                                                   Foreground="{DynamicResource Sanduhr.Brush.Text}" FontSize="13"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2" Text="active" FontSize="10"
                                                                   Foreground="{DynamicResource Sanduhr.Brush.Accent}"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding IsActive, Converter={StaticResource BoolVis}}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <!-- Empty hint -->
                                        <TextBlock Text="No accounts yet. Click &quot;Add account…&quot; to sign in."
                                                   Foreground="{DynamicResource Sanduhr.Brush.TextDim}" FontSize="11"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding HasNoAccounts, Converter={StaticResource BoolVis}}" />
                                    </Grid>
                                </Border>
                                <!-- Signed out is a state (Principle 6, WF32): what fills in once there is an account. -->
                                <TextBlock x:Name="SignedOutAccountsLine" Text="{x:Static core:SettingsNames.SignedOutAccountsLine}"
                                           TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"
                                           Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}"
                                           Visibility="{Binding HasNoAccounts, Converter={StaticResource BoolVis}}" />

                                <!-- Per-selection actions -->
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Style="{StaticResource FlatButton}" Content="Switch to"
                                            Command="{Binding SwitchToCommand}" />
                                    <Button Style="{StaticResource FlatButton}" Content="Rename…"
                                            Command="{Binding RenameCommand}" />
                                    <Button Style="{StaticResource FlatButton}" Content="Update sign-in…"
                                            Command="{Binding UpdateSignInCommand}" />
                                </StackPanel>
                                <!-- Why the buttons above are dim until a row is picked (WF29). -->
                                <TextBlock Text="{x:Static core:SettingsNames.PickAnAccount}" TextWrapping="Wrap" FontSize="10.5" Margin="0,8,0,0"
                                           Foreground="{DynamicResource Sanduhr.Brush.TextDim}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding SelectedAccount}" Value="{x:Null}" />
                                                        <Condition Binding="{Binding HasNoAccounts}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <Border Height="1" Background="{DynamicResource Sanduhr.Brush.Border}" Margin="0,16,0,16" />

                            <!-- Sign in (WF30: the first sign-in asks for a Label). -->
                            <StackPanel views:SettingsAnchor.Id="sign-in">
                                <TextBlock Text="{x:Static core:SettingsNames.SignIn}" FontSize="13" FontWeight="SemiBold"
                                           AutomationProperties.HeadingLevel="Level2"
                                           Foreground="{DynamicResource Sanduhr.Brush.Text}" Margin="0,0,0,8" />
                                <Button Style="{StaticResource AccentButton}" Content="Add account…" HorizontalAlignment="Left"
                                        Command="{Binding AddCommand}" Margin="0" />
                            </StackPanel>

                            <!-- Data for this account: the linked folder, the one per-account erase, and Remove (WF1, WF27, WF29). -->
                            <StackPanel views:SettingsAnchor.Id="data" Margin="0,16,0,0"
                                        Visibility="{Binding HasData, Converter={StaticResource BoolVis}}">
                                <Border Height="1" Background="{DynamicResource Sanduhr.Brush.Border}" Margin="0,0,0,16" />
                                <TextBlock Text="{x:Static core:SettingsNames.AccountDataSection}" FontSize="13" FontWeight="SemiBold"
                                           AutomationProperties.HeadingLevel="Level2"
                                           Foreground="{DynamicResource Sanduhr.Brush.Text}" Margin="0,0,0,8" />
                                <TextBlock Text="{x:Static core:SettingsNames.LinkedFolders}" FontSize="9" Margin="0,0,0,4"
                                           Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                                <WrapPanel Margin="0,0,0,12">
                                    <TextBlock Text="{Binding LinkedFolderText}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"
                                               Foreground="{DynamicResource Sanduhr.Brush.Text}" />
                                    <Button Style="{StaticResource SettingsLinkButton}" views:SettingsLinkTo.Link="claudecode#folders"
                                            Content="{x:Static core:SettingsNames.ClaudeCodeLinkTitle}" />
                                </WrapPanel>
                                <Button Style="{StaticResource FlatButton}" HorizontalAlignment="Left" Margin="0,0,0,10"
                                        Content="{x:Static core:SettingsNames.ClearAccountHistory}"
                                        AutomationProperties.Name="{Binding ClearHistoryName}"
                                        Command="{Binding ClearHistoryCommand}"
                                        Foreground="{DynamicResource Sanduhr.Brush.PaceMarker}" />
                                <Button Style="{StaticResource FlatButton}" HorizontalAlignment="Left"
                                        Content="{x:Static core:SettingsNames.RemoveAccount}"
                                        AutomationProperties.Name="{Binding RemoveName}"
                                        AutomationProperties.HelpText="{Binding RemoveCaption}"
                                        Command="{Binding SignOutCommand}"
                                        Foreground="{DynamicResource Sanduhr.Brush.PaceMarker}" />
                                <TextBlock Text="{Binding RemoveCaption}" TextWrapping="Wrap" FontSize="10.5" Margin="0,4,0,0"
                                           Foreground="{DynamicResource Sanduhr.Brush.TextDim}" />
                            </StackPanel>
                        </StackPanel>
                        </ScrollViewer>
                    </Border>
                </TabItem>

                <!-- Alerts tab (WS-B) — thresholds, projection, sounds. -->
                <TabItem Header="Alerts" Tag="Alerts" AutomationProperties.Name="Alerts">
                    <Border Background="{DynamicResource Sanduhr.Brush.Glass}" CornerRadius="8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                            <ScrollViewer.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimThemeScrollBar}" />
                            </ScrollViewer.Resources>
                        <StackPanel Margin="16" DataContext="{Binding Alerts}" views:SettingsAnchor.Id="notifications">
                            <TextBlock Text="Alerts" FontSize="14" FontWeight="SemiBold"
                                       AutomationProperties.HeadingLevel="Level1"
                                       Foreground="{DynamicResource Sanduhr.Brush.Text}" Margin="0,0,0,12" />
                            <views:SectionJumpLinks Page="Alerts" />
                            <TextBlock TextWrapping="Wrap" FontSize="11"
                                       Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" Margin="0,0,0,12"
                                       Text="Get a toast and a soft chime when a tier crosses your thresholds, or when your pace will hit the cap before it resets. Toasts respect Focus Assist. Model-scoped weekly tiers alert silently by default — toast only, no chime." />

                            <CheckBox Content="Enable alerts" IsChecked="{Binding AlertsEnabled}"
                                      Foreground="{DynamicResource Sanduhr.Brush.Text}" Margin="0,0,0,10" />

                            <!-- WF36: with alerts off, everything that only matters for alerts dims and says so. -->
                            <TextBlock x:Name="AlertsOffLine" Text="Alerts are off. Nothing below sends." FontSize="11"
                                       TextWrapping="Wrap" Margin="0,0,0,10" AutomationProperties.LiveSetting="Polite"
                                       Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AlertsEnabled}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <StackPanel x:Name="AlertsDependents" IsEnabled="{Binding AlertsEnabled}">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.45" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                            <Grid Margin="0,0,0,10" views:SettingsAnchor.Id="thresholds">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="2" Text="%" VerticalAlignment="Center" FontSize="12" Margin="4,0,0,0"
                                           Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                                <TextBlock Grid.Column="6" Text="%" VerticalAlignment="Center" FontSize="12" Margin="4,0,0,0"
                                           Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                                <TextBlock Grid.Column="0" Text="Warn at" VerticalAlignment="Center" FontSize="12"
                                           Foreground="{DynamicResource Sanduhr.Brush.Text}" Margin="0,0,8,0" />
                                <TextBox Grid.Column="1" Text="{Binding WarnPct, UpdateSourceTrigger=LostFocus}"
                                         AutomationProperties.Name="Warn at, percent"
                                         FontSize="12" Padding="6,4"
                                         Background="{DynamicResource Sanduhr.Brush.Bg}"
                                         Foreground="{DynamicResource Sanduhr.Brush.Text}"
                                         BorderBrush="{DynamicResource Sanduhr.Brush.Border}"
                                         CaretBrush="{DynamicResource Sanduhr.Brush.Text}" />
                                <TextBlock Grid.Column="4" Text="Urgent at" VerticalAlignment="Center" FontSize="12"
                                           Foreground="{DynamicResource Sanduhr.Brush.Text}" Margin="0,0,8,0" />
                                <TextBox Grid.Column="5" Text="{Binding UrgentPct, UpdateSourceTrigger=LostFocus}"
                                         AutomationProperties.Name="Urgent at, percent"
                                         FontSize="12" Padding="6,4"
                                         Background="{DynamicResource Sanduhr.Brush.Bg}"
                                         Foreground="{DynamicResource Sanduhr.Brush.Text}"
                                         BorderBrush="{DynamicResource Sanduhr.Brush.Border}"
                                         CaretBrush="{DynamicResource Sanduhr.Brush.Text}" />
                            </Grid>

                            <TextBlock Text="{Binding ValidationHint}" FontSize="11"
                                       Foreground="{DynamicResource Sanduhr.Brush.PaceMarker}"
                                       Visibility="{Binding ValidationHint, Converter={StaticResource StrVis}}"
                                       Margin="0,0,0,10" />

                            <CheckBox Content="Projection alerts (on pace to hit the cap before reset)"
                                      IsChecked="{Binding ProjectionEnabled}"
                                      Foreground="{DynamicResource Sanduhr.Brush.Text}" Margin="0,0,0,6" />
                            <CheckBox Content="Reset notifications"
                                      IsChecked="{Binding ResetEnabled}"
                                      Foreground="{DynamicResource Sanduhr.Brush.Text}" Margin="0,0,0,6" />
                            </StackPanel>

                            <!-- Each limit (WF13): warnings and hiding per limit; the card menu writes the same keys. "Show this limit" sends
                                 nothing, so it stays live with alerts off; "Warn for this limit" dims with them (decision 5). -->
                            <StackPanel Margin="0,4,0,14" views:SettingsAnchor.Id="each-limit">
                                <TextBlock Text="{x:Static core:SettingsNames.EachLimitSection}" FontSize="13" FontWeight="SemiBold"
                                           AutomationProperties.HeadingLevel="Level2"
                                           Foreground="{DynamicResource Sanduhr.Brush.Text}" Margin="0,0,0,4" />
                                <TextBlock Text="{x:Static core:SettingsNames.EachLimitCaption}" FontSize="10.5" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Sanduhr.Brush.TextDim}" Margin="0,0,0,8" />
                                <TextBlock x:Name="EachLimitEmpty" Style="{StaticResource EmptyLine}" Text="{Binding LimitsEmptyText}"
                                           Tag="{Binding HasItems, ElementName=EachLimitList}"
                                           views:LiveRegion.Shown="{Binding HasNoLimits}" />
                                <ItemsControl x:Name="EachLimitList" ItemsSource="{Binding Limits}" Focusable="False"
                                              AutomationProperties.Name="{x:Static core:SettingsNames.EachLimitListName}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Label}" FontSize="12" Margin="0,0,0,2"
                                                           Foreground="{DynamicResource Sanduhr.Brush.Text}" />
                                                <WrapPanel>
                                                    <CheckBox Style="{StaticResource ThemedCheckBox}" Margin="0,0,16,0"
                                                              Content="{x:Static core:SettingsNames.WarnForThisLimit}"
                                                              IsChecked="{Binding WarnOn, Mode=TwoWay}"
                                                              IsEnabled="{Binding DataContext.AlertsEnabled, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              AutomationProperties.Name="{Binding WarnName}" />
                                                    <CheckBox Style="{StaticResource ThemedCheckBox}"
                                                              Content="{x:Static core:SettingsNames.ShowThisLimit}"
                                                              IsChecked="{Binding Shown, Mode=TwoWay}"
                                                              AutomationProperties.Name="{Binding ShowName}" />
                                                </WrapPanel>
                                                <TextBlock Text="{x:Static core:SettingsNames.HiddenUntilResetCaption}" FontSize="10.5" TextWrapping="Wrap"
                                                           Margin="22,2,0,0" Foreground="{DynamicResource Sanduhr.Brush.TextDim}"
                                                           Visibility="{Binding HiddenUntilReset, Converter={StaticResource BoolVis}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel x:Name="AlertsSoundDependents" IsEnabled="{Binding AlertsEnabled}">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.45" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                            <CheckBox Content="Sound" IsChecked="{Binding SoundEnabled}" views:SettingsAnchor.Id="sound"
                                      Foreground="{DynamicResource Sanduhr.Brush.Text}" Margin="0,0,0,6" />
                            <CheckBox Content="Chime for model-scoped weekly tiers"
                                      IsChecked="{Binding ScopedChimeEnabled}"
                                      Foreground="{DynamicResource Sanduhr.Brush.Text}" Margin="0,0,0,6" />
                            <CheckBox Content="{x:Static core:SettingsNames.SnakeSoundAtFull}"
                                      IsChecked="{Binding SnakeAtFull}"
                                      Foreground="{DynamicResource Sanduhr.Brush.Text}" Margin="0,0,0,14" />

                            <Button Style="{StaticResource FlatButton}" Content="{x:Static core:SettingsNames.SendTestAlert}"
                                    views:SettingsAnchor.Id="test"
                                    Command="{Binding TestAlertCommand}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </StackPanel>
                        </ScrollViewer>
                    </Border>
                </TabItem>

                <!-- Settings, Privacy (slice 6): what leaves this PC and what Claude can change (WF6, WF10). Slice 7 adds Streamer mode at its top. -->
                <TabItem Header="Privacy" Tag="Privacy" AutomationProperties.Name="Privacy" DataContext="{Binding Privacy}">
                    <views:PrivacyPage />
                </TabItem>

                <!-- Claude Usage (WS-C; Settings v2, slice 5): Meters / Overview / Trends / Sessions over the meter history,
                     the session archive and the live session-log reader.
                     DataContext must live ON the TabItem: the CcSection* visibility triggers resolve
                     DataContext.Section through AncestorType=TabItem (a child-level DataContext never
                     reaches them). -->
                <TabItem Header="Claude Usage" Tag="ClaudeUsage" AutomationProperties.Name="Claude Usage" DataContext="{Binding ClaudeCode}">
                    <Border Background="{DynamicResource Sanduhr.Brush.Glass}" CornerRadius="8" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Sub-nav -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="{x:Static core:SettingsNames.MetersView}" Style="{StaticResource CcNavMeters}"
                                        Command="{Binding SetMetersCommand}" />
                                <Button Content="Overview" Style="{StaticResource CcNavOverview}"
                                        Command="{Binding SetOverviewCommand}" />
                                <Button Content="Trends" Style="{StaticResource CcNavTrends}"
                                        Command="{Binding SetTrendsCommand}" />
                                <Button Content="Sessions" Style="{StaticResource CcNavSessions}"
                                        Command="{Binding SetSessionsCommand}" />
                            </StackPanel>

                            <!-- Meters (Settings v2, slice 5): the 30-day meter history, the History page until now (WF14). Its DataContext is
                                 the HistoryTabViewModel; the window pushes the chart's rows (SettingsWindow.RenderHistory). -->
                            <Grid Grid.Row="1" Style="{StaticResource CcSectionMeters}" DataContext="{Binding Meters}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,12"
                                           Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}"
                                           Text="{x:Static core:SettingsNames.MetersIntro}" />

                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8" views:SettingsAnchor.Id="meters">
                                    <TextBlock Text="Window:" VerticalAlignment="Center" FontSize="12"
                                               Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" Margin="0,0,8,0" />
                                    <Button Content="Week" Style="{StaticResource RangePillWeek}"
                                            Command="{Binding SetWeekCommand}" />
                                    <Button Content="Month" Style="{StaticResource RangePillMonth}"
                                            Command="{Binding SetMonthCommand}" />
                                    <TextBlock Text="Account:" VerticalAlignment="Center" FontSize="12"
                                               Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" Margin="12,0,8,0" />
                                    <ComboBox Style="{StaticResource ThemedComboBox}" Width="170"
                                              VerticalAlignment="Center"
                                              AutomationProperties.Name="Account, meter history"
                                              ItemsSource="{Binding AccountOptions}"
                                              DisplayMemberPath="Display"
                                              SelectedItem="{Binding SelectedOption, Mode=TwoWay}" />
                                </StackPanel>

                                <!-- Legend, only when All accounts is selected. -->
                                <ItemsControl Grid.Row="2" ItemsSource="{Binding Legend}" Margin="0,0,0,4" Focusable="False"
                                              Visibility="{Binding ShowLegend, Converter={StaticResource BoolVis}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,12,2" VerticalAlignment="Center">
                                                <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                                         Fill="{Binding Swatch}" Margin="0,0,5,0" />
                                                <TextBlock Text="{Binding Label}" FontSize="11" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- The chart; with nothing to draw it gives way to a line a screen reader can read (WF32, WF35). -->
                                <Border Grid.Row="3" Background="{DynamicResource Sanduhr.Brush.Bg}" CornerRadius="6" MinHeight="160"
                                        BorderBrush="{DynamicResource Sanduhr.Brush.Border}" BorderThickness="1"
                                        Padding="8" Margin="0,4,0,0">
                                    <Grid>
                                        <views:HistoryChart x:Name="Chart">
                                            <views:HistoryChart.Style>
                                                <Style TargetType="views:HistoryChart">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasEmptyText}" Value="True">
                                                            <Setter Property="Visibility" Value="Hidden" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </views:HistoryChart.Style>
                                        </views:HistoryChart>
                                        <TextBlock x:Name="HistoryEmptyText" Text="{Binding EmptyText}" TextWrapping="Wrap" FontSize="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="12"
                                                   Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}"
                                                   views:LiveRegion.Shown="{Binding HasEmptyText}"
                                                   Visibility="{Binding HasEmptyText, Converter={StaticResource BoolVis}}" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,12,0,0" views:SettingsAnchor.Id="meters-export">
                                    <Button Style="{StaticResource AccentButton}" Content="{x:Static core:SettingsNames.ExportMeterHistory}"
                                            Command="{Binding ExportCsvCommand}" Margin="0" />
                                </StackPanel>
                            </Grid>

                            <!-- Overview -->
                            <Grid Grid.Row="1" Style="{StaticResource CcSectionOverview}"
                                  DataContext="{Binding Overview}" views:SettingsAnchor.Id="overview">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" TextWrapping="Wrap" FontSize="11"
                                           Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" Margin="0,0,0,8"
                                           Text="Claude Code deletes session logs after ~30 days. Sanduhr keeps a local session archive so your trends survive. It is never uploaded, opt-in per folder, and you can erase it any time below." />

                                <TextBlock Grid.Row="1" FontSize="11" Margin="0,0,0,8"
                                           Foreground="{DynamicResource Sanduhr.Brush.PaceMarker}"
                                           Text="{Binding StatusLine}"
                                           Visibility="{Binding StatusLine, Converter={StaticResource StrVis}}" />

                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
                                    <StackPanel Margin="0,0,32,0">
                                        <TextBlock Text="Today" FontSize="9"
                                                   Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                                        <TextBlock Text="{Binding TodayText}" FontSize="22" FontWeight="Bold"
                                                   Foreground="{DynamicResource Sanduhr.Brush.Text}" />
                                        <TextBlock Text="{Binding TodaySplitText}" FontSize="10"
                                                   Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}"
                                                   Visibility="{Binding TodaySplitText, Converter={StaticResource StrVis}}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Last 30 days" FontSize="9"
                                                   Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                                        <TextBlock Text="{Binding MonthText}" FontSize="22" FontWeight="Bold"
                                                   Foreground="{DynamicResource Sanduhr.Brush.Text}" />
                                        <TextBlock Text="{Binding MonthSplitText}" FontSize="10"
                                                   Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}"
                                                   Visibility="{Binding MonthSplitText, Converter={StaticResource StrVis}}" />
                                    </StackPanel>
                                </StackPanel>

                                <views:LocalCcBarStrip x:Name="BarStrip" Grid.Row="3" Height="60" Margin="0,0,0,8" />

                                <views:CcCalendarControl x:Name="CalendarStrip" Grid.Row="4"
                                                         Height="96" Margin="0,0,0,8" />

                                <CheckBox Grid.Row="5" Style="{StaticResource ThemedCheckBox}"
                                          Content="Show project &amp; skill breakdown"
                                          IsChecked="{Binding ShowBreakdowns, Mode=TwoWay}" Margin="0,0,0,8" />

                                <!-- Per-project + per-skill tables side by side. -->
                                <Grid Grid.Row="6"
                                      Visibility="{Binding ShowBreakdowns, Converter={StaticResource BoolVis}}">
                                <Grid.Resources>
                                    <!-- Empty means empty after the first scan, not while "Today" still says Loading. -->
                                    <Style x:Key="OverviewEmptyLine" TargetType="TextBlock" BasedOn="{StaticResource EmptyLine}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasLoaded}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Resources>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <DockPanel Grid.Column="0">
                                    <TextBlock DockPanel.Dock="Top" Text="Top projects (last 30 days)" FontSize="9"
                                               Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" Margin="0,0,0,4" />
                                    <TextBlock x:Name="OverviewProjectsEmpty" DockPanel.Dock="Top" Style="{StaticResource OverviewEmptyLine}"
                                               Margin="0,0,0,4" Text="No projects in the last 30 days."
                                               Tag="{Binding HasItems, ElementName=OverviewProjectsList}" />
                                    <Border Background="{DynamicResource Sanduhr.Brush.Bg}" CornerRadius="6"
                                            BorderBrush="{DynamicResource Sanduhr.Brush.Border}" BorderThickness="1">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                                            <ScrollViewer.Resources>
                                                <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimThemeScrollBar}" />
                                            </ScrollViewer.Resources>
                                            <ItemsControl x:Name="OverviewProjectsList" ItemsSource="{Binding Projects}" Margin="4" AutomationProperties.Name="Top projects (last 30 days)" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="4,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource Sanduhr.Brush.Text}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Tokens}" FontSize="11"
                                                                       Margin="8,0,0,0"
                                                                       Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </DockPanel>

                                <DockPanel Grid.Column="2">
                                    <TextBlock DockPanel.Dock="Top" Text="Top skills (last 30 days)" FontSize="9"
                                               Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" Margin="0,0,0,4" />
                                    <TextBlock x:Name="OverviewSkillsEmpty" DockPanel.Dock="Top" Style="{StaticResource OverviewEmptyLine}"
                                               Margin="0,0,0,4" Text="No skills in the last 30 days."
                                               Tag="{Binding HasItems, ElementName=OverviewSkillsList}" />
                                    <Border Background="{DynamicResource Sanduhr.Brush.Bg}" CornerRadius="6"
                                            BorderBrush="{DynamicResource Sanduhr.Brush.Border}" BorderThickness="1">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                                            <ScrollViewer.Resources>
                                                <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimThemeScrollBar}" />
                                            </ScrollViewer.Resources>
                                            <ItemsControl x:Name="OverviewSkillsList" ItemsSource="{Binding Skills}" Margin="4" AutomationProperties.Name="Top skills (last 30 days)" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="4,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource Sanduhr.Brush.Text}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Tokens}" FontSize="11"
                                                                       Margin="8,0,0,0"
                                                                       Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </DockPanel>
                                </Grid>

                                <!-- Data stewardship (spec: WS-A delete-completeness precedent). -->
                                <StackPanel Grid.Row="7" Margin="0,10,0,0">
                                    <TextBlock Text="{x:Static core:SettingsNames.SessionArchive}" FontSize="9" Margin="0,0,0,4" views:SettingsAnchor.Id="vault"
                                               Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                                    <WrapPanel x:Name="VaultRootsEmpty" Style="{StaticResource EmptyLinkLine}" Margin="0,0,0,4"
                                               Tag="{Binding HasItems, ElementName=VaultRootsList}">
                                        <TextBlock Text="No Claude Code folders found. Add one in " FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Sanduhr.Brush.TextDim}" />
                                        <Button Style="{StaticResource SettingsLinkButton}" Tag="claudecode#folders" Click="OpenSettingsLink_Click"
                                                Content="{Binding DataContext.ClaudeCodeSettingsLink, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </WrapPanel>
                                    <ItemsControl x:Name="VaultRootsList" ItemsSource="{Binding Roots}" AutomationProperties.Name="Session archive folders" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Style="{StaticResource ThemedCheckBox}" Margin="0,0,16,4"
                                                          Content="{Binding Name}"
                                                          IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Style="{StaticResource FlatButton}" Content="{x:Static core:SettingsNames.EraseSessionArchive}"
                                                Command="{Binding EraseArchiveCommand}"
                                                Foreground="{DynamicResource Sanduhr.Brush.PaceMarker}" />
                                        <Button Style="{StaticResource FlatButton}" Content="{x:Static core:SettingsNames.OpenArchiveFolder}"
                                                Command="{Binding OpenVaultFolderCommand}" />
                                    </StackPanel>

                                </StackPanel>
                            </Grid>

                            <!-- Trends -->
                            <Grid Grid.Row="1" Style="{StaticResource CcSectionTrends}" views:SettingsAnchor.Id="trends"
                                  DataContext="{Binding Trends}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Window:" VerticalAlignment="Center" FontSize="12"
                                               Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" Margin="0,0,8,0" />
                                    <Button Content="4 weeks" Style="{StaticResource TrendsPill4}"
                                            Command="{Binding SetWeeksCommand}" CommandParameter="4" />
                                    <Button Content="12 weeks" Style="{StaticResource TrendsPill12}"
                                            Command="{Binding SetWeeksCommand}" CommandParameter="12" />
                                    <Button Content="26 weeks" Style="{StaticResource TrendsPill26}"
                                            Command="{Binding SetWeeksCommand}" CommandParameter="26" />
                                </StackPanel>

                                <TextBlock Grid.Row="1" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"
                                           Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}"
                                           Text="{Binding InfoText}"
                                           Visibility="{Binding InfoText, Converter={StaticResource StrVis}}" />

                                <Border Grid.Row="2" Background="{DynamicResource Sanduhr.Brush.Bg}" CornerRadius="6"
                                        BorderBrush="{DynamicResource Sanduhr.Brush.Border}" BorderThickness="1" Padding="8">
                                    <views:CcTrendsControl x:Name="TrendsChart" />
                                </Border>

                                <DockPanel Grid.Row="3" Margin="0,8,0,0" MaxHeight="120">
                                    <TextBlock DockPanel.Dock="Top" Text="Top projects (window)" FontSize="9"
                                               Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" Margin="0,0,0,4" />
                                    <TextBlock x:Name="TrendsProjectsEmpty" DockPanel.Dock="Top" Style="{StaticResource EmptyLine}"
                                               Text="No projects in this window."
                                               Tag="{Binding HasItems, ElementName=TrendsProjectsList}" />
                                    <ItemsControl x:Name="TrendsProjectsList" ItemsSource="{Binding TopProjects}" AutomationProperties.Name="Top projects (window)" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource Sanduhr.Brush.Text}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Tokens}" FontSize="11" Margin="8,0,0,0"
                                                               Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DockPanel>

                                <TextBlock Grid.Row="4" FontSize="10" Margin="0,8,0,0"
                                           Foreground="{DynamicResource Sanduhr.Brush.TextDim}"
                                           Text="{Binding FooterText}" />
                            </Grid>

                            <!-- Sessions (Ledger). The ListBox OWNS scrolling:
                                 star-sized row, no ancestor ScrollViewer (the
                                 spec's named in-repo trap), recycling
                                 virtualization, pixel scroll. -->
                            <Grid Grid.Row="1" Style="{StaticResource CcSectionSessions}" views:SettingsAnchor.Id="sessions"
                                  DataContext="{Binding Ledger}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}"
                                            Content="{x:Static core:SettingsNames.ExportSessions}" Command="{Binding ExportCsvCommand}" />
                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource ThemedCheckBox}"
                                              Margin="0,0,12,0" VerticalAlignment="Center"
                                              Content="Stack by project"
                                              IsChecked="{Binding GroupByProject, Mode=TwoWay}" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Today" Style="{StaticResource LedgerChipToday}"
                                                Command="{Binding SetScopeCommand}" CommandParameter="Today" />
                                        <Button Content="Yesterday" Style="{StaticResource LedgerChipYesterday}"
                                                Command="{Binding SetScopeCommand}" CommandParameter="Yesterday" />
                                        <Button Content="7 days" Style="{StaticResource LedgerChip7d}"
                                                Command="{Binding SetScopeCommand}" CommandParameter="7d" />
                                        <Button Content="All" Style="{StaticResource LedgerChipAll}"
                                                Command="{Binding SetScopeCommand}" CommandParameter="All" />
                                        <Button Content="{Binding Scope}" ContentStringFormat="{}{0}  ✕"
                                                Style="{StaticResource LedgerChipDay}"
                                                Command="{Binding ClearDayScopeCommand}"
                                                ToolTip="Showing one day — click to go back" />
                                    </StackPanel>
                                </DockPanel>

                                <!-- Sort header row — glyph carries direction, never color alone. -->
                                <Grid Grid.Row="1" Margin="4,0,4,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Style="{StaticResource FlatButton}" HorizontalAlignment="Left"
                                            Content="{Binding LastActiveHeader}" FontSize="10"
                                            Command="{Binding SortByCommand}" CommandParameter="LastActive" />
                                    <Button Grid.Column="1" Style="{StaticResource FlatButton}" HorizontalAlignment="Left"
                                            Content="{Binding ProjectHeader}" FontSize="10"
                                            Command="{Binding SortByCommand}" CommandParameter="Project" />
                                    <TextBlock Grid.Column="2" Text="Models" FontSize="10" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                                    <Button Grid.Column="3" Style="{StaticResource FlatButton}" HorizontalAlignment="Right"
                                            Content="{Binding TokensHeader}" FontSize="10"
                                            Command="{Binding SortByCommand}" CommandParameter="Tokens" />
                                </Grid>

                                <Border Grid.Row="2" Background="{DynamicResource Sanduhr.Brush.Bg}" CornerRadius="6"
                                        BorderBrush="{DynamicResource Sanduhr.Brush.Border}" BorderThickness="1">
                                    <Grid>
                                        <ListBox ItemsSource="{Binding View}" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Sessions"
                                                 HorizontalContentAlignment="Stretch"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 VirtualizingPanel.IsVirtualizing="True"
                                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                                 VirtualizingPanel.ScrollUnit="Pixel">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <VirtualizingStackPanel />
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Focusable" Value="False" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <ContentPresenter />
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay}" Cursor="Hand">
                                                            <ToggleButton.Template>
                                                                <ControlTemplate TargetType="ToggleButton">
                                                                    <Border x:Name="rowBg" Background="Transparent" Padding="8,5">
                                                                        <ContentPresenter />
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="rowBg" Property="Background"
                                                                                    Value="{DynamicResource Sanduhr.Brush.Glass}" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </ToggleButton.Template>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="90" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="150" />
                                                                    <ColumnDefinition Width="110" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding LastActiveText}" FontSize="11"
                                                                           Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                                                                <TextBlock Grid.Column="1" Text="{Binding ProjectText}" FontSize="11"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding CwdTooltip}"
                                                                           Foreground="{DynamicResource Sanduhr.Brush.Text}" />
                                                                <TextBlock Grid.Column="2" Text="{Binding ModelBadge}" FontSize="10"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                                                                <TextBlock Grid.Column="3" Text="{Binding ScopedTokensText}" FontSize="11"
                                                                           HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"
                                                                           Foreground="{DynamicResource Sanduhr.Brush.Text}" />
                                                            </Grid>
                                                        </ToggleButton>
                                                        <Border Padding="16,2,8,8"
                                                                Visibility="{Binding IsExpanded, Converter={StaticResource BoolVis}}">
                                                            <TextBlock Text="{Binding DetailText}" FontSize="10" TextWrapping="Wrap"
                                                                       Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                                                        </Border>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock Text="{Binding EmptyText}" FontSize="11" TextWrapping="Wrap"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"
                                                   Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}"
                                                   Visibility="{Binding EmptyText, Converter={StaticResource StrVis}}" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </TabItem>

                <!-- Publish usage tab: opt-in daily publish to an endpoint the user chooses.
                     Nothing comes back to us. Everything defaults OFF — master toggle, every
                     folder — and the one sentence above the controls says exactly what leaves
                     the machine. 626 Labs is a preset, not the name of the feature. -->
                <TabItem Header="Publish usage" Tag="Publish" AutomationProperties.Name="Publish usage" DataContext="{Binding Publish}">
                    <Border Background="{DynamicResource Sanduhr.Brush.Glass}" CornerRadius="8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                            <ScrollViewer.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimThemeScrollBar}" />
                            </ScrollViewer.Resources>
                        <StackPanel Margin="20">
                            <TextBlock Text="Publish usage" FontSize="14" FontWeight="SemiBold"
                                       AutomationProperties.HeadingLevel="Level1"
                                       Foreground="{DynamicResource Sanduhr.Brush.Text}" Margin="0,0,0,6" />
                            <views:SectionJumpLinks Page="Publish" />
                            <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,12"
                                       Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}"
                                       Text="Nothing about your usage comes back to us. If you want it somewhere, send it to yourself: once a day Sanduhr can post token counts per project name (folder names only, never paths) to an endpoint you choose." />

                            <!-- Destination -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6" views:SettingsAnchor.Id="destination">
                                <TextBlock Text="Preset" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                                <ComboBox Style="{StaticResource ThemedComboBox}" Width="190"
                                          VerticalAlignment="Center"
                                          ItemsSource="{Binding PresetOptions}"
                                          DisplayMemberPath="Display"
                                          SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                                          AutomationProperties.Name="Preset"
                                          ToolTip="Custom endpoint, or the 626 Labs dashboard preset (fills the URL, bearer auth, and the dashboard body format)." />
                                <TextBlock Text="{Binding PresetHint}" FontSize="10.5" VerticalAlignment="Center"
                                           Margin="10,0,0,0" TextWrapping="Wrap" MaxWidth="260"
                                           Foreground="{DynamicResource Sanduhr.Brush.TextDim}"
                                           Visibility="{Binding PresetHint, Converter={StaticResource StrVis}}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <TextBlock Text="Endpoint URL" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                                <TextBox Style="{StaticResource Input}" Width="360"
                                         Text="{Binding EndpointUrl, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         AutomationProperties.Name="Endpoint URL"
                                         ToolTip="Where the daily POST goes. An absolute http(s) URL you control." />
                            </StackPanel>
                            <TextBlock FontSize="10.5" Margin="0,0,0,8"
                                       Foreground="{DynamicResource Sanduhr.Brush.PaceMarker}"
                                       Text="{Binding EndpointError}"
                                       Visibility="{Binding EndpointError, Converter={StaticResource StrVis}}" />

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="Auth" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                                <ComboBox Style="{StaticResource ThemedComboBox}" Width="150"
                                          VerticalAlignment="Center"
                                          ItemsSource="{Binding AuthOptions}"
                                          DisplayMemberPath="Display"
                                          SelectedItem="{Binding SelectedAuth, Mode=TwoWay}"
                                          AutomationProperties.Name="Auth"
                                          ToolTip="How the token rides on the request: Authorization: Bearer, a header you name, or no credential." />
                                <StackPanel Orientation="Horizontal" Margin="10,0,0,0"
                                            Visibility="{Binding ShowHeaderName, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="Header name" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"
                                               Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                                    <TextBox Style="{StaticResource Input}" Width="150"
                                             Text="{Binding AuthHeaderName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             AutomationProperties.Name="Header name"
                                             ToolTip="The header that carries the token, e.g. X-Api-Key." />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="Token" FontSize="9" Margin="0,0,0,4" views:SettingsAnchor.Id="token"
                                       Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Button Style="{StaticResource FlatButton}" Content="Set token…"
                                        Command="{Binding SetTokenCommand}"
                                        AutomationProperties.Name="Set token…"
                                        ToolTip="Paste the token your endpoint expects. Stored in Windows Credential Manager, never in a file." />
                                <Button Style="{StaticResource FlatButton}" Content="Clear token"
                                        Command="{Binding ClearTokenCommand}"
                                        AutomationProperties.Name="Clear token"
                                        ToolTip="Delete the stored token. Publishing stops until a new one is set."
                                        Foreground="{DynamicResource Sanduhr.Brush.PaceMarker}"
                                        Visibility="{Binding HasToken, Converter={StaticResource BoolVis}}" />
                                <TextBlock Text="{Binding TokenStatusText}" FontSize="10.5" VerticalAlignment="Center"
                                           Margin="8,0,0,0"
                                           Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                            </StackPanel>

                            <Border Height="1" Background="{DynamicResource Sanduhr.Brush.Border}" Margin="0,0,0,12" />

                            <!-- What and when -->
                            <TextBlock Text="{x:Static core:SettingsNames.FoldersToShare}" FontSize="9" Margin="0,0,0,4" views:SettingsAnchor.Id="homes"
                                       Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                            <WrapPanel x:Name="PublishHomesEmpty" Style="{StaticResource EmptyLinkLine}" Margin="0,0,0,10"
                                       Tag="{Binding HasItems, ElementName=PublishHomesList}">
                                <TextBlock Text="No Claude Code folders found. Add one in " FontSize="11" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Sanduhr.Brush.TextDim}" />
                                <Button Style="{StaticResource SettingsLinkButton}" Tag="claudecode#folders" Click="OpenSettingsLink_Click"
                                        Content="{Binding DataContext.ClaudeCodeSettingsLink, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </WrapPanel>
                            <ItemsControl x:Name="PublishHomesList" ItemsSource="{Binding Roots}" Margin="0,0,0,10" AutomationProperties.Name="{x:Static core:SettingsNames.FoldersToShare}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{StaticResource ThemedCheckBox}" Margin="0,0,16,4"
                                                  Content="{Binding Name}"
                                                  IsChecked="{Binding IsShared, Mode=TwoWay}"
                                                  ToolTip="Include this Claude Code folder's per-project token counts in the daily publish." />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2" views:SettingsAnchor.Id="schedule">
                                <CheckBox Style="{StaticResource ThemedCheckBox}"
                                          Content="Publish daily at"
                                          IsChecked="{Binding Enabled, Mode=TwoWay}"
                                          VerticalAlignment="Center" Margin="0,0,8,0"
                                          ToolTip="The master switch. Off means nothing is ever sent, whatever else is set here." />
                                <TextBox Style="{StaticResource Input}" Width="64"
                                         Text="{Binding PublishTimeText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         AutomationProperties.Name="Publish time"
                                         ToolTip="24-hour, local time. Publishes the previous day." />
                                <TextBlock Text="(24-hour, local time; publishes the previous day)" FontSize="10.5"
                                           VerticalAlignment="Center" Margin="8,0,0,0"
                                           Foreground="{DynamicResource Sanduhr.Brush.TextDim}" />
                            </StackPanel>
                            <TextBlock FontSize="10.5" Margin="0,0,0,8"
                                       Foreground="{DynamicResource Sanduhr.Brush.PaceMarker}"
                                       Text="{Binding TimeError}"
                                       Visibility="{Binding TimeError, Converter={StaticResource StrVis}}" />

                            <!-- What gets sent (WF28): every field group of the record, and a sample built by the real builder. -->
                            <StackPanel Margin="0,6,0,4" views:SettingsAnchor.Id="sample">
                                <TextBlock Text="{x:Static core:SettingsNames.PublishSampleSection}" FontSize="9" Margin="0,0,0,4"
                                           Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                                <TextBlock Text="{x:Static core:SettingsNames.PublishRecordLine}" TextWrapping="Wrap" FontSize="10.5"
                                           Foreground="{DynamicResource Sanduhr.Brush.TextDim}" Margin="0,0,0,6" />
                                <Button Style="{StaticResource FlatButton}" HorizontalAlignment="Left"
                                        Content="{x:Static core:SettingsNames.ShowASample}"
                                        AutomationProperties.Name="{x:Static core:SettingsNames.ShowASample}"
                                        Command="{Binding ShowSampleCommand}" />
                            </StackPanel>

                            <Border Height="1" Background="{DynamicResource Sanduhr.Brush.Border}" Margin="0,6,0,12" />

                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource AccentButton}" Content="Publish now"
                                        Command="{Binding PublishNowCommand}"
                                        AutomationProperties.Name="Publish now"
                                        ToolTip="Publish yesterday's totals right now, regardless of the schedule." />
                            </StackPanel>
                            <TextBlock TextWrapping="Wrap" FontSize="10.5" Margin="0,8,0,0"
                                       Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}"
                                       Text="{Binding StatusText}" />
                            <TextBlock TextWrapping="Wrap" FontSize="10" Margin="0,10,0,0"
                                       Foreground="{DynamicResource Sanduhr.Brush.TextDim}"
                                       Text="The sanduhr-mcp publish_usage tool queues the same upload through this widget; it never holds the token itself. Re-publishing a day sends that day's record again." />
                        </StackPanel>
                        </ScrollViewer>
                    </Border>
                </TabItem>

                <!-- Settings, Claude Code (slice 4): one card per folder, drawn by its own control. -->
                <TabItem Header="Claude Code" Tag="ClaudeCode" AutomationProperties.Name="Claude Code" DataContext="{Binding ClaudeCodePage}">
                    <views:ClaudeCodePage />
                </TabItem>

                <!-- Settings, Mods & Widgets (slice 4): the one list, drawn by its own control. -->
                <TabItem Header="Mods &amp; Widgets" Tag="Mods" AutomationProperties.Name="Mods &amp; Widgets" DataContext="{Binding ModsPage}">
                    <views:ModsPage />
                </TabItem>

                <!-- Settings, Widget (slice 5): the widget's own options and Just the Desk's way back (WF15, WF24, WF32). -->
                <TabItem Header="Widget" Tag="Widget" AutomationProperties.Name="Widget" DataContext="{Binding WidgetPage}">
                    <views:WidgetPage />
                </TabItem>

                <!-- Themes tab (item 8) — swatch grid + agent-assisted theme creation. -->
                <TabItem Header="Themes" Tag="Themes" AutomationProperties.Name="Themes">
                    <Border x:Name="ThemesRoot" Background="{DynamicResource Sanduhr.Brush.Glass}" CornerRadius="8" Padding="16"
                            DataContext="{Binding Themes}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Swatch grid: the same tiles as the widget, bound to the
                                 SAME Themes collection so the active highlight stays in
                                 sync with the widget. Click a tile to switch live. -->
                            <StackPanel Grid.Row="0">
                                <!-- Theme packs (WF40): where they come from, one click away. -->
                                <WrapPanel Margin="0,0,0,8">
                                    <TextBlock Text="{Binding ThemePacksLine}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"
                                               Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                                    <Button Style="{StaticResource SettingsLinkButton}" Content="{Binding PacksLinkTitle}"
                                            views:SettingsLinkTo.Link="{Binding PacksLink}" Command="{Binding ShowPacksClickedCommand}"
                                            AutomationProperties.Name="{Binding PacksLinkTitle}" />
                                </WrapPanel>
                                <TextBlock Text="Choose a theme" FontSize="11" views:SettingsAnchor.Id="gallery"
                                           FontWeight="SemiBold" Foreground="{DynamicResource Sanduhr.Brush.TextDim}"
                                           Margin="0,0,0,8" />
                            </StackPanel>
                            <Border Grid.Row="1" Background="{DynamicResource Sanduhr.Brush.Bg}" CornerRadius="6"
                                    BorderBrush="{DynamicResource Sanduhr.Brush.Border}" BorderThickness="1"
                                    Padding="5,4">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled" MaxHeight="112">
                                    <ScrollViewer.Resources>
                                        <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimThemeScrollBar}" />
                                    </ScrollViewer.Resources>
                                    <ListBox x:Name="ThemeGallery" Style="{StaticResource ThemeSwatchList}"
                                             ItemsSource="{Binding Themes}" AutomationProperties.Name="Choose a theme" />
                                </ScrollViewer>
                            </Border>

                            <Border Grid.Row="2" Height="1" Background="{DynamicResource Sanduhr.Brush.Border}"
                                    Margin="0,16,0,12" />

                            <!-- Editor: Paste (a theme JSON, lint findings before Save) or Studio
                                 (token rows; the widget itself is the live preview). -->
                            <!-- The editor scrolls inside the flexible row: at a short window the token
                                 list would otherwise push "Save & apply" below the frame, and the grid
                                 itself does not scroll. Installed themes and their buttons stay pinned. -->
                            <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ScrollViewer.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimThemeScrollBar}" />
                                </ScrollViewer.Resources>
                                <StackPanel>
                                <CheckBox Style="{StaticResource ThemedCheckBox}" Margin="0,0,0,8" views:SettingsAnchor.Id="studio"
                                          Content="Studio: edit the tokens, watch the widget re-tint live"
                                          IsChecked="{Binding IsStudioMode, Mode=TwoWay}" />

                                <!-- Paste mode -->
                                <StackPanel Visibility="{Binding IsPasteMode, Converter={StaticResource BoolVis}}" views:SettingsAnchor.Id="paste">
                                    <TextBlock TextWrapping="Wrap" FontSize="11"
                                               Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" Margin="0,0,0,8"
                                               Text="Paste a theme JSON below (or what an AI agent returned), give it a filename, and Save &amp; apply. Use Copy agent prompt to get the schema + design rules for any chat agent. With the MCP server installed, Claude Code can propose a theme directly." />
                                    <Grid Height="100">
                                        <TextBox x:Name="PasteBox"
                                                 Style="{StaticResource Input}"
                                                 Text="{Binding PasteJson, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True" TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 VerticalContentAlignment="Top"
                                                 FontFamily="Cascadia Code, Consolas" />
                                        <TextBlock Text='{}{"name": "Sunset", "bg": "#1a0a1f", ...}'
                                                   Foreground="{DynamicResource Sanduhr.Brush.TextDim}" Margin="8,6"
                                                   IsHitTestVisible="False" FontSize="11"
                                                   FontFamily="Cascadia Code, Consolas">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text.Length, ElementName=PasteBox}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <TextBlock FontSize="10.5" Margin="0,4,0,0" Text="{Binding PasteSummary}"
                                               Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}"
                                               Visibility="{Binding PasteSummary, Converter={StaticResource StrVis}}" />
                                    <ScrollViewer Height="44" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,2,0,0">
                                        <ScrollViewer.Resources>
                                            <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimThemeScrollBar}" />
                                        </ScrollViewer.Resources>
                                        <ItemsControl ItemsSource="{Binding PasteFindings}" ItemTemplate="{StaticResource ThemeFindingTemplate}" />
                                    </ScrollViewer>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="Filename:" VerticalAlignment="Center" FontSize="12"
                                                   Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" Margin="0,0,8,0" />
                                        <TextBox Style="{StaticResource Input}" Width="220"
                                                 Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="Filename" />
                                        <TextBlock Text=".json" VerticalAlignment="Center" FontSize="12"
                                                   Foreground="{DynamicResource Sanduhr.Brush.TextDim}" Margin="6,0,0,0" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Style="{StaticResource AccentButton}" Content="Save &amp; apply"
                                                Command="{Binding SaveAndApplyCommand}" />
                                        <Button Style="{StaticResource FlatButton}" Content="Copy agent prompt"
                                                Command="{Binding CopyAgentPromptCommand}" />
                                        <Button Style="{StaticResource FlatButton}" Content="Open themes folder"
                                                Command="{Binding OpenThemesFolderCommand}" Margin="0" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Studio mode -->
                                <StackPanel DataContext="{Binding Studio}"
                                            Visibility="{Binding DataContext.IsStudioMode, ElementName=ThemesRoot, Converter={StaticResource BoolVis}}">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Start from" VerticalAlignment="Center" FontSize="12"
                                                   Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" Margin="0,0,8,0" />
                                        <ComboBox Grid.Column="1" Style="{StaticResource ThemedComboBox}" MaxWidth="200" HorizontalAlignment="Left"
                                                  ItemsSource="{Binding StartFromOptions}" DisplayMemberPath="Name"
                                                  SelectedItem="{Binding SelectedStart, Mode=TwoWay}"
                                                  AutomationProperties.Name="Start from theme" />
                                        <TextBlock Grid.Column="2" Text="Name" VerticalAlignment="Center" FontSize="12"
                                                   Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" Margin="12,0,8,0" />
                                        <TextBox Grid.Column="3" Style="{StaticResource Input}" Width="120"
                                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="Name of the theme" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Rows}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,10,4" ToolTip="{Binding Job}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="18" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="82" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="14" Height="14" CornerRadius="3"
                                                            Background="{Binding Swatch}"
                                                            BorderBrush="{DynamicResource Sanduhr.Brush.Border}" BorderThickness="1" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="11" Margin="6,0,6,0"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                                                    <TextBox Grid.Column="2" FontFamily="Cascadia Code, Consolas"
                                                             FontSize="11" Padding="4,2"
                                                             Text="{Binding Hex, UpdateSourceTrigger=PropertyChanged}"
                                                             AutomationProperties.Name="{Binding Label}">
                                                        <TextBox.Style>
                                                            <Style TargetType="TextBox" BasedOn="{StaticResource Input}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource Sanduhr.Brush.PaceMarker}" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource Sanduhr.Brush.PaceMarker}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBox.Style>
                                                    </TextBox>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="36" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Glass alpha" FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" ToolTip="Card density over Mica. Lower = airier, higher = more solid." />
                                        <Slider Grid.Column="1" Style="{StaticResource ThemedSlider}" Minimum="0.60" Maximum="1.00"
                                                SmallChange="0.01" LargeChange="0.05" Value="{Binding GlassAlpha, Mode=TwoWay}"
                                                AutomationProperties.Name="Glass alpha" />
                                        <TextBlock Grid.Column="2" Text="{Binding GlassAlphaText}" FontSize="11" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" Foreground="{DynamicResource Sanduhr.Brush.TextDim}" FontFamily="Cascadia Code, Consolas" />
                                        <TextBlock Grid.Column="4" Text="Border alpha" FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" ToolTip="Card border visibility." />
                                        <Slider Grid.Column="5" Style="{StaticResource ThemedSlider}" Minimum="0.10" Maximum="0.80"
                                                SmallChange="0.01" LargeChange="0.05" Value="{Binding BorderAlpha, Mode=TwoWay}"
                                                AutomationProperties.Name="Border alpha" />
                                        <TextBlock Grid.Column="6" Text="{Binding BorderAlphaText}" FontSize="11" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" Foreground="{DynamicResource Sanduhr.Brush.TextDim}" FontFamily="Cascadia Code, Consolas" />
                                    </Grid>
                                    <!-- Theme match: the theme's font (the widget's text; the Desk's while it follows) and its Desk look. -->
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="230" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Static core:SettingsNames.ThemeFontPicker}" FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                                        <ComboBox Grid.Column="1" Style="{StaticResource ThemedComboBox}"
                                                  ItemsSource="{Binding FontChoices}" SelectedItem="{Binding Font, Mode=TwoWay}"
                                                  AutomationProperties.Name="{x:Static core:SettingsNames.ThemeFontPicker}" />
                                    </Grid>
                                    <views:ThemeDeskEditor Margin="0,10,0,0" DataContext="{Binding DeskEditor}" />
                                    <TextBlock FontSize="10.5" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Foreground="{DynamicResource Sanduhr.Brush.TextDim}"
                                               Text="{x:Static core:SettingsNames.ThemeStudioDeskNote}" />
                                    <TextBlock FontSize="10.5" Margin="0,6,0,0" Text="{Binding Summary}"
                                               Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                                    <ScrollViewer Height="58" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,2,0,0">
                                        <ScrollViewer.Resources>
                                            <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimThemeScrollBar}" />
                                        </ScrollViewer.Resources>
                                        <ItemsControl ItemsSource="{Binding Findings}" ItemTemplate="{StaticResource ThemeFindingTemplate}" />
                                    </ScrollViewer>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="{x:Static core:SettingsNames.SaveThemeAs}" VerticalAlignment="Center" FontSize="12"
                                                   Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" Margin="0,0,8,0" />
                                        <TextBox Style="{StaticResource Input}" Width="160"
                                                 Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="{x:Static core:SettingsNames.SaveThemeAs}"
                                                 ToolTip="Lowercase letters, digits, hyphens. Empty = the name, slugged." />
                                        <TextBlock Text=".json" VerticalAlignment="Center" FontSize="12"
                                                   Foreground="{DynamicResource Sanduhr.Brush.TextDim}" Margin="6,0,0,0" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Style="{StaticResource AccentButton}" Content="Save &amp; apply"
                                                Command="{Binding SaveCommand}" />
                                        <Button Style="{StaticResource FlatButton}" Content="Revert"
                                                Command="{Binding RevertCommand}"
                                                ToolTip="Drop the preview and reload the active theme into the rows." />
                                        <Button Style="{StaticResource FlatButton}" Content="Copy JSON"
                                                Command="{Binding CopyJsonCommand}" Margin="0"
                                                ToolTip="The draft as a theme file, for an agent or the themes folder." />
                                    </StackPanel>
                                </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                            <!-- Installed user themes -->
                            <TextBlock Grid.Row="7" Text="Installed user themes" FontSize="11" views:SettingsAnchor.Id="installed"
                                       FontWeight="SemiBold" Foreground="{DynamicResource Sanduhr.Brush.TextDim}"
                                       Margin="0,16,0,6" />

                            <Border Grid.Row="8" Height="72" Background="{DynamicResource Sanduhr.Brush.Bg}" CornerRadius="6"
                                    BorderBrush="{DynamicResource Sanduhr.Brush.Border}" BorderThickness="1">
                                <Grid>
                                    <ListBox x:Name="ThemesList" AutomationProperties.Name="Installed user themes"
                                             ItemsSource="{Binding InstalledThemes}"
                                             SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{DynamicResource Sanduhr.Brush.Text}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                                    <TextBlock Text="No user themes yet. Paste one above or drop a JSON in the themes folder."
                                               Foreground="{DynamicResource Sanduhr.Brush.TextDim}" FontSize="11"
                                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="280"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding HasNoThemes, Converter={StaticResource BoolVis}}" />
                                </Grid>
                            </Border>

                            <!-- List actions -->
                            <StackPanel Grid.Row="9" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Style="{StaticResource FlatButton}" Content="Apply"
                                        Command="{Binding ApplySelectedCommand}" />
                                <Button Style="{StaticResource FlatButton}" Content="Reload"
                                        Command="{Binding ReloadCommand}" />
                                <Button Style="{StaticResource FlatButton}" Content="Delete"
                                        Command="{Binding DeleteCommand}" Foreground="{DynamicResource Sanduhr.Brush.PaceMarker}" Margin="0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </TabItem>

                <!-- Desk (Settings v2, slice 3: the split, WF22, WF8): the switch, Arrange, the map on top, every piece (Show, place, order),
                     Behavior, and the collapsed Designs and Advanced. Fonts, sizes and colors are on Desk Look; Watchers and the Launcher
                     have pages of their own. Every change saves at once and the running Desk follows. -->
                <TabItem Header="Desk" Tag="Desk" AutomationProperties.Name="Desk"
                         DataContext="{Binding Desk}">
                    <Border Background="{DynamicResource Sanduhr.Brush.Glass}" CornerRadius="8">
                        <!-- WF26: the page is as wide as the viewport, so text wraps and the piece rows wrap to two lines below 760 DIP;
                             it is never narrower than a row's first block (490, plus the 2 x 20 margin), and below that it scrolls
                             sideways instead of clipping the Monitor combo. -->
                        <ScrollViewer x:Name="DeskPageScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Focusable="False">
                            <ScrollViewer.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimThemeScrollBar}" />
                            </ScrollViewer.Resources>
                            <Border x:Name="DeskPageContent" MinWidth="530" HorizontalAlignment="Left"
                                    Width="{Binding ViewportWidth, ElementName=DeskPageScroller}">
                                <StackPanel Margin="20">
                                    <TextBlock Text="Desk" FontSize="14" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level1"
                                               Foreground="{DynamicResource Sanduhr.Brush.Text}" Margin="0,0,0,4" />
                                    <TextBlock Text="{x:Static core:SettingsNames.DeskLine}" FontSize="11" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" Margin="0,0,0,12" />
                                    <views:SectionJumpLinks Page="Desk" />

                                    <StackPanel views:SettingsAnchor.Id="desk">
                                        <CheckBox Style="{StaticResource ThemedCheckBox}"
                                                  Content="{x:Static core:SettingsNames.DeskSwitch}"
                                                  IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                  AutomationProperties.Name="{x:Static core:SettingsNames.DeskSwitch}" />
                                        <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                                                   Foreground="{DynamicResource Sanduhr.Brush.TextDim}"
                                                   Text="Off by default. Draws on the desktop behind your windows, on every monitor, and keeps clear of the taskbar. Turn it off here at any time." />
                                    </StackPanel>

                                    <Border Height="1" Background="{DynamicResource Sanduhr.Brush.Border}" Margin="0,16,0,16" />

                                    <StackPanel views:SettingsAnchor.Id="arrange">
                                        <Button Style="{StaticResource FlatButton}" HorizontalAlignment="Left" Padding="12,6"
                                                Content="{x:Static core:SettingsNames.ArrangeDesk}"
                                                Command="{Binding ArrangeCommand}"
                                                IsEnabled="{Binding CanArrange}"
                                                AutomationProperties.Name="{x:Static core:SettingsNames.ArrangeDesk}" />
                                        <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                                                   AutomationProperties.LiveSetting="Polite"
                                                   Foreground="{DynamicResource Sanduhr.Brush.TextDim}"
                                                   Text="{Binding ArrangeNote}" />
                                    </StackPanel>

                                    <Border Height="1" Background="{DynamicResource Sanduhr.Brush.Border}" Margin="0,16,0,16" />

                                    <!-- The Layout map, on top (spec, Desk): a picture of where each piece sits, not a control (WF5). Below 600 DIP of
                                         window height it folds to its 44 DIP header; a fold or unfold by the person holds for the window's life.
                                         The header is a plain string: SectionExpander's toggle draws it. -->
                                    <Expander x:Name="DeskMapFold" Style="{StaticResource SectionExpander}" views:SettingsAnchor.Id="map" IsExpanded="True"
                                              AutomationProperties.Name="{x:Static core:SettingsNames.DeskLayoutMap}"
                                              AutomationProperties.HeadingLevel="Level2"
                                              Header="{x:Static core:SettingsNames.DeskLayoutMap}"
                                              Expanded="DeskMapFold_Toggled" Collapsed="DeskMapFold_Toggled">
                                        <StackPanel>
                                            <views:DeskLayoutMap HorizontalAlignment="Left" />
                                            <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                                                       Foreground="{DynamicResource Sanduhr.Brush.TextDim}"
                                                       Text="{x:Static core:SettingsNames.DeskMapCaption}" />
                                        </StackPanel>
                                    </Expander>

                                    <Border Height="1" Background="{DynamicResource Sanduhr.Brush.Border}" Margin="0,16,0,16" />

                                    <StackPanel views:SettingsAnchor.Id="pieces" IsEnabled="{Binding NotArranging}">
                                        <TextBlock Text="{x:Static core:SettingsNames.PiecesSection}" FontSize="13" FontWeight="SemiBold"
                                                   AutomationProperties.HeadingLevel="Level2"
                                                   Foreground="{DynamicResource Sanduhr.Brush.Text}" Margin="0,0,0,8" />
                                        <views:DeskPiecesPanel />
                                        <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource Sanduhr.Brush.TextDim}"
                                                   Text="Tick a piece to show it at its usual place. Eight places: the four corners, the top and bottom centers, and the middle of each side. Size scales a piece from 60% to 160%. Move up and Move down change the order of the pieces that share a place. Monitor puts a piece on every monitor, on the main one, or on one monitor; a piece on a monitor that is not connected shows on the main one until it is back." />
                                    </StackPanel>

                                    <Border Height="1" Background="{DynamicResource Sanduhr.Brush.Border}" Margin="0,16,0,16" />

                                    <!-- Behavior: clicks, and the sign-in reminder (moved from Alerts: a Desk behavior, WF32). -->
                                    <StackPanel views:SettingsAnchor.Id="desk-clicks">
                                        <TextBlock Text="{x:Static core:SettingsNames.DeskBehavior}" FontSize="13" FontWeight="SemiBold"
                                                   AutomationProperties.HeadingLevel="Level2"
                                                   Foreground="{DynamicResource Sanduhr.Brush.Text}" Margin="0,0,0,8" />
                                        <CheckBox Style="{StaticResource ThemedCheckBox}"
                                                  Content="{x:Static core:SettingsNames.DeskPieceClicksSwitch}"
                                                  IsChecked="{Binding PiecesTakeClicks, Mode=TwoWay}"
                                                  AutomationProperties.Name="{x:Static core:SettingsNames.DeskPieceClicksSwitch}"
                                                  AutomationProperties.HelpText="{x:Static core:DeskPieceClicks.Caption}" />
                                        <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                                                   Foreground="{DynamicResource Sanduhr.Brush.TextDim}"
                                                   Text="{x:Static core:DeskPieceClicks.Caption}" />
                                        <StackPanel views:SettingsAnchor.Id="signin-reminders" Margin="0,12,0,0"
                                                    DataContext="{Binding DataContext.Alerts, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <CheckBox Style="{StaticResource ThemedCheckBox}"
                                                      Content="{x:Static core:SettingsNames.SignInReminders}"
                                                      IsChecked="{Binding DeskSignInReminder, Mode=TwoWay}"
                                                      AutomationProperties.Name="{x:Static core:SettingsNames.SignInReminders}" />
                                            <TextBlock Text="{x:Static core:SignInReminder.Caption}" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"
                                                       Foreground="{DynamicResource Sanduhr.Brush.TextDim}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Border Height="1" Background="{DynamicResource Sanduhr.Brush.Border}" Margin="0,16,0,16" />

                                    <!-- Designs (collapsed): the kept designs, Put my Desk back, and the switch whose changes they undo. -->
                                    <Expander x:Name="DeskDesignsSection" Style="{StaticResource SectionExpander}" views:SettingsAnchor.Id="desk-designs"
                                              AutomationProperties.Name="{x:Static core:SettingsNames.DeskDesigns}"
                                              AutomationProperties.HeadingLevel="Level2"
                                              AutomationProperties.HelpText="{Binding Designs.Summary}"
                                              Header="{x:Static core:SettingsNames.DeskDesigns}">
                                        <StackPanel>
                                            <views:DesignsSettingsPanel DataContext="{Binding Designs}" />
                                            <CheckBox Style="{StaticResource ThemedCheckBox}" Margin="0,14,0,0"
                                                      Content="{x:Static core:SettingsNames.DeskDirectSwitch}"
                                                      IsChecked="{Binding DirectDesign, Mode=TwoWay}"
                                                      AutomationProperties.Name="{x:Static core:SettingsNames.DeskDirectSwitch}" />
                                            <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                                                       Foreground="{DynamicResource Sanduhr.Brush.TextDim}"
                                                       Text="Off by default. With the Sanduhr MCP server installed, Claude Code can propose a whole look for the Desk and the widget theme. Sanduhr shows it on the desktop first, with Apply and Dismiss, and nothing is saved until you choose Apply. Turn this on and a design is applied at once instead. Either way the Desk it replaces is saved first, and Put my Desk back undoes the change." />
                                        </StackPanel>
                                    </Expander>

                                    <Border Height="1" Background="{DynamicResource Sanduhr.Brush.Border}" Margin="0,16,0,16" />

                                    <!-- Advanced (collapsed): Margins and OLED care. -->
                                    <Expander x:Name="DeskAdvancedSection" Style="{StaticResource SectionExpander}" views:SettingsAnchor.Id="desk-advanced"
                                              AutomationProperties.Name="{x:Static core:SettingsNames.DeskAdvanced}"
                                              AutomationProperties.HeadingLevel="Level2"
                                              Header="{x:Static core:SettingsNames.DeskAdvanced}">
                                        <StackPanel>
                                            <StackPanel views:SettingsAnchor.Id="margins" IsEnabled="{Binding NotArranging}">
                                                <TextBlock Text="Margins" FontSize="13" FontWeight="SemiBold"
                                                           AutomationProperties.HeadingLevel="Level3"
                                                           Foreground="{DynamicResource Sanduhr.Brush.Text}" Margin="0,0,0,8" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="230" />
                                                        <ColumnDefinition Width="44" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Text="Left" FontSize="12" VerticalAlignment="Center" Margin="0,0,0,6"
                                                               Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                                                    <Slider Grid.Row="0" Grid.Column="1" x:Name="MarginLeftSlider" Style="{StaticResource ThemedSlider}" Margin="0,0,0,6"
                                                            Minimum="0" Maximum="400" TickFrequency="4" IsSnapToTickEnabled="True" SmallChange="4" LargeChange="20"
                                                            Value="{Binding MarginLeft, Mode=TwoWay}" AutomationProperties.Name="Left margin" />
                                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Value, ElementName=MarginLeftSlider, StringFormat='{}{0:0}'}"
                                                               FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,0,6"
                                                               Foreground="{DynamicResource Sanduhr.Brush.TextDim}" FontFamily="Cascadia Code, Consolas" />
                                                    <TextBlock Grid.Row="1" Text="Right" FontSize="12" VerticalAlignment="Center" Margin="0,0,0,6"
                                                               Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                                                    <Slider Grid.Row="1" Grid.Column="1" x:Name="MarginRightSlider" Style="{StaticResource ThemedSlider}" Margin="0,0,0,6"
                                                            Minimum="0" Maximum="400" TickFrequency="4" IsSnapToTickEnabled="True" SmallChange="4" LargeChange="20"
                                                            Value="{Binding MarginRight, Mode=TwoWay}" AutomationProperties.Name="Right margin" />
                                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Value, ElementName=MarginRightSlider, StringFormat='{}{0:0}'}"
                                                               FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,0,6"
                                                               Foreground="{DynamicResource Sanduhr.Brush.TextDim}" FontFamily="Cascadia Code, Consolas" />
                                                    <TextBlock Grid.Row="2" Text="Top" FontSize="12" VerticalAlignment="Center" Margin="0,0,0,6"
                                                               Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                                                    <Slider Grid.Row="2" Grid.Column="1" x:Name="MarginTopSlider" Style="{StaticResource ThemedSlider}" Margin="0,0,0,6"
                                                            Minimum="0" Maximum="400" TickFrequency="4" IsSnapToTickEnabled="True" SmallChange="4" LargeChange="20"
                                                            Value="{Binding MarginTop, Mode=TwoWay}" AutomationProperties.Name="Top margin" />
                                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Value, ElementName=MarginTopSlider, StringFormat='{}{0:0}'}"
                                                               FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,0,6"
                                                               Foreground="{DynamicResource Sanduhr.Brush.TextDim}" FontFamily="Cascadia Code, Consolas" />
                                                    <TextBlock Grid.Row="3" Text="Bottom" FontSize="12" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                                                    <Slider Grid.Row="3" Grid.Column="1" x:Name="MarginBottomSlider" Style="{StaticResource ThemedSlider}"
                                                            Minimum="0" Maximum="400" TickFrequency="4" IsSnapToTickEnabled="True" SmallChange="4" LargeChange="20"
                                                            Value="{Binding MarginBottom, Mode=TwoWay}" AutomationProperties.Name="Bottom margin" />
                                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Value, ElementName=MarginBottomSlider, StringFormat='{}{0:0}'}"
                                                               FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"
                                                               Foreground="{DynamicResource Sanduhr.Brush.TextDim}" FontFamily="Cascadia Code, Consolas" />
                                                </Grid>
                                                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                                                           Foreground="{DynamicResource Sanduhr.Brush.TextDim}"
                                                           Text="Measured from the screen's edge, inside the taskbar." />
                                            </StackPanel>

                                            <Border Height="1" Background="{DynamicResource Sanduhr.Brush.Border}" Margin="0,16,0,16" />

                                            <views:OledCarePanel views:SettingsAnchor.Id="desk-oled" />
                                        </StackPanel>
                                    </Expander>

                                    <Border Height="1" Background="{DynamicResource Sanduhr.Brush.Border}" Margin="0,16,0,16" />

                                    <views:TrademarkFooter />
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </Border>
                </TabItem>

                <!-- Settings, Desk Look (Settings v2, slice 3): its own control; its sections pick their view models. -->
                <TabItem Header="Desk Look" Tag="DeskLook" AutomationProperties.Name="Desk Look">
                    <views:DeskLookPage />
                </TabItem>

                <!-- Settings, Message (spec 6.2): its own control, which carries its glass, scroller and anchors. -->
                <TabItem Header="Message" Tag="DeskMessage" AutomationProperties.Name="Message" DataContext="{Binding MessagePage}">
                    <views:DeskMessagePage />
                </TabItem>

                <TabItem Header="Now playing" Tag="NowPlaying" AutomationProperties.Name="Now playing" DataContext="{Binding NowPlayingPage}">
                    <Border Background="{DynamicResource Sanduhr.Brush.Glass}" CornerRadius="8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                            <ScrollViewer.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimThemeScrollBar}" />
                            </ScrollViewer.Resources>
                        <StackPanel Margin="20">
                            <TextBlock Text="Now playing" FontSize="14" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level1"
                                       Foreground="{DynamicResource Sanduhr.Brush.Text}" Margin="0,0,0,8" />
                            <views:DeskPieceStatusPanel DataContext="{Binding Piece}" Margin="0,0,0,12" />
                            <views:SectionJumpLinks Page="NowPlaying" />
                            <StackPanel views:SettingsAnchor.Id="np-widget">
                                <CheckBox Style="{StaticResource ThemedCheckBox}"
                                          Content="{x:Static core:SettingsNames.NowPlayingInWidget}" IsChecked="{Binding Widget, Mode=TwoWay}"
                                          AutomationProperties.Name="{x:Static core:SettingsNames.NowPlayingInWidget}" />
                                <CheckBox Style="{StaticResource ThemedCheckBox}" Margin="0,8,0,0"
                                          Content="Keep showing while paused" IsChecked="{Binding KeepPaused, Mode=TwoWay}"
                                          AutomationProperties.Name="Keep showing while paused" />
                                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Foreground="{DynamicResource Sanduhr.Brush.TextDim}"
                                           Text="Title and artist from the Windows media controls (Spotify, browsers and most players). It shows while something plays and fades out 5 seconds after playback stops or pauses; Windows sounds never bring it up. Tick Keep showing while paused to hold it through a pause. A click on the line plays or pauses; Next shows while paused. What is playing stays in memory: Sanduhr never saves or logs it." />
                                <TextBlock Text="{Binding Status}" FontSize="11" Margin="0,8,0,0"
                                           Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                            </StackPanel>
                            <Border Height="1" Background="{DynamicResource Sanduhr.Brush.Border}" Margin="0,16,0,16" />
                            <StackPanel views:SettingsAnchor.Id="np-apps">
                                <TextBlock Text="Apps" FontSize="13" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2"
                                           Foreground="{DynamicResource Sanduhr.Brush.Text}" Margin="0,0,0,8" />
                                <TextBlock x:Name="NowPlayingAppsEmpty" Style="{StaticResource EmptyLine}" Margin="0,0,0,6"
                                           Text="Nothing has played since Sanduhr started."
                                           Tag="{Binding HasItems, ElementName=NowPlayingAppsList}" />
                                <ItemsControl x:Name="NowPlayingAppsList" ItemsSource="{Binding Apps}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Style="{StaticResource ThemedCheckBox}" Margin="0,0,0,6"
                                                      Content="{Binding Name}" IsChecked="{Binding Shown, Mode=TwoWay}"
                                                      AutomationProperties.Name="{Binding Name}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Foreground="{DynamicResource Sanduhr.Brush.TextDim}"
                                           Text="Apps seen playing since Sanduhr started. Untick one to keep it off the widget and the Desk." />
                            </StackPanel>
                            <Border Height="1" Background="{DynamicResource Sanduhr.Brush.Border}" Margin="0,16,0,16" />
                            <StackPanel views:SettingsAnchor.Id="np-bars">
                                <CheckBox Style="{StaticResource ThemedCheckBox}"
                                          Content="Bars beside it on the Desk" IsChecked="{Binding Bars, Mode=TwoWay}"
                                          AutomationProperties.Name="Bars beside it on the Desk" />
                                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Foreground="{DynamicResource Sanduhr.Brush.TextDim}"
                                           Text="The bars follow the loudness of the app that is playing, read from that app's Windows volume mixer level. Windows system sounds are ignored. Sanduhr never records or captures audio, and the bars stop while nothing plays." />
                                <CheckBox Style="{StaticResource ThemedCheckBox}" Margin="0,10,0,0"
                                          Content="{x:Static core:SettingsNames.NowPlayingBarsGradient}" IsChecked="{Binding BarsGradient, Mode=TwoWay}"
                                          IsEnabled="{Binding Bars}"
                                          AutomationProperties.Name="{x:Static core:SettingsNames.NowPlayingBarsGradient}" />
                                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Foreground="{DynamicResource Sanduhr.Brush.TextDim}"
                                           Text="Spreads the ink's colors across the bars and fades each one toward its base. Peak caps hold over the bars and drop; with Windows' animation effects off, the bars move calmly and the caps stay off." />
                            </StackPanel>
                            <Border Height="1" Background="{DynamicResource Sanduhr.Brush.Border}" Margin="0,16,0,16" />
                            <views:NowPlayingLooksPanel views:SettingsAnchor.Id="np-looks" />
                            <Border Height="1" Background="{DynamicResource Sanduhr.Brush.Border}" Margin="0,16,0,16" />
                            <views:TrademarkFooter />
                        </StackPanel>
                        </ScrollViewer>
                    </Border>
                </TabItem>

                <TabItem Header="Weather" Tag="Weather" AutomationProperties.Name="Weather" DataContext="{Binding WeatherPage}">
                    <Border Background="{DynamicResource Sanduhr.Brush.Glass}" CornerRadius="8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                            <ScrollViewer.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimThemeScrollBar}" />
                            </ScrollViewer.Resources>
                        <StackPanel Margin="20">
                            <TextBlock Text="Weather" FontSize="14" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level1"
                                       Foreground="{DynamicResource Sanduhr.Brush.Text}" Margin="0,0,0,8" />
                            <views:DeskPieceStatusPanel DataContext="{Binding Piece}" Margin="0,0,0,12" />
                            <StackPanel views:SettingsAnchor.Id="weather-place">
                                <TextBlock Text="City" FontSize="13" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2"
                                           Foreground="{DynamicResource Sanduhr.Brush.Text}" Margin="0,0,0,8" />
                                <TextBlock Text="{Binding PlaceText}" FontSize="12" Margin="0,0,0,8"
                                           Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Width="230" Style="{StaticResource Input}" Text="{Binding City, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="City" />
                                    <Button Style="{StaticResource AccentButton}" Margin="8,0,0,0" Content="{x:Static core:SettingsNames.WeatherLookUp}"
                                            Command="{Binding LookUpCommand}"
                                            AutomationProperties.Name="{x:Static core:SettingsNames.WeatherLookUp}" />
                                    <Button Style="{StaticResource FlatButton}" Margin="8,0,0,0" Content="Clear"
                                            Command="{Binding ClearCommand}" IsEnabled="{Binding HasPlace}"
                                            AutomationProperties.Name="Clear the city" />
                                </StackPanel>
                                <TextBlock Text="{Binding Note}" FontSize="11" Margin="0,6,0,0"
                                           Foreground="{DynamicResource Sanduhr.Brush.TextDim}" />
                                <ListBox ItemsSource="{Binding Results}" SelectedItem="{Binding Picked, Mode=TwoWay}"
                                         DisplayMemberPath="Label" MaxHeight="140" Margin="0,4,0,0" Width="400" HorizontalAlignment="Left"
                                         Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Sanduhr.Brush.Text}"
                                         AutomationProperties.Name="Places found" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="230" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Static core:SettingsNames.WeatherShowAs}" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                                    <TextBox Grid.Column="1" Style="{StaticResource Input}" MaxLength="24"
                                             Text="{Binding Nickname, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                                             AutomationProperties.Name="{x:Static core:SettingsNames.WeatherShowAs}"
                                             AutomationProperties.HelpText="{x:Static vm:WeatherPageViewModel.NicknameHint}" />
                                </Grid>
                                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="90,4,0,0"
                                           Foreground="{DynamicResource Sanduhr.Brush.TextDim}"
                                           Text="{x:Static vm:WeatherPageViewModel.NicknameHint}" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="230" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Unit" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                                    <ComboBox Grid.Column="1" Style="{StaticResource ThemedComboBox}"
                                              ItemsSource="{x:Static vm:WeatherPageViewModel.Units}"
                                              SelectedItem="{Binding Unit, Mode=TwoWay}" AutomationProperties.Name="Unit" />
                                </Grid>
                                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Foreground="{DynamicResource Sanduhr.Brush.TextDim}"
                                           Text="Look up sends the city you type, and only that, to the Open-Meteo place search. The forecast is asked for with the place coordinates, rounded to about 1 km: no account, no identifier, no location services. It refreshes at most every 30 minutes, only while the Desk shows the weather piece, and stays in memory." />
                            </StackPanel>
                            <Border Height="1" Background="{DynamicResource Sanduhr.Brush.Border}" Margin="0,16,0,16" />
                            <StackPanel views:SettingsAnchor.Id="weather-credit">
                                <TextBlock FontSize="11" TextWrapping="Wrap"><Hyperlink NavigateUri="{Binding CreditUrl}" RequestNavigate="Hyperlink_RequestNavigate"
                                               Foreground="{DynamicResource Sanduhr.Brush.Accent}" AutomationProperties.Name="Weather data by Open-Meteo.com"><Run Text="{Binding Credit, Mode=OneWay}" /></Hyperlink><Run Text=" (CC BY 4.0, " Foreground="{DynamicResource Sanduhr.Brush.TextDim}" /><Hyperlink NavigateUri="{Binding LicenceUrl}" RequestNavigate="Hyperlink_RequestNavigate"
                                               Foreground="{DynamicResource Sanduhr.Brush.Accent}" AutomationProperties.Name="The licence"><Run Text="licence" /></Hyperlink><Run Text="). Place search by GeoNames (CC BY 4.0)." Foreground="{DynamicResource Sanduhr.Brush.TextDim}" /></TextBlock>
                            </StackPanel>
                            <Border Height="1" Background="{DynamicResource Sanduhr.Brush.Border}" Margin="0,16,0,16" />
                            <views:TrademarkFooter />
                        </StackPanel>
                        </ScrollViewer>
                    </Border>
                </TabItem>

                <!-- Settings, Watchers and Launcher (Settings v2, slice 3): features that were sections of the Desk page (WF22). -->
                <TabItem Header="Watchers" Tag="Watchers" AutomationProperties.Name="Watchers" DataContext="{Binding Desk}">
                    <views:WatchersPage />
                </TabItem>

                <TabItem Header="Launcher" Tag="Launcher" AutomationProperties.Name="Launcher" DataContext="{Binding Desk}">
                    <views:LauncherPage />
                </TabItem>

                <!-- About (Settings v2): the version, What's New and the tour, the trademark notice,
                     where Sanduhr keeps its files, and the packages it ships with. -->
                <TabItem Header="About" Tag="About" AutomationProperties.Name="About">
                    <Border Background="{DynamicResource Sanduhr.Brush.Glass}" CornerRadius="8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                            <ScrollViewer.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimThemeScrollBar}" />
                            </ScrollViewer.Resources>
                        <StackPanel Margin="20">
                            <TextBlock Text="About" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Sanduhr.Brush.Text}" Margin="0,0,0,12" />

                            <StackPanel views:SettingsAnchor.Id="version">
                                <TextBlock Text="{Binding AboutVersionLine}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Sanduhr.Brush.Text}" Margin="0,0,0,10" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource FlatButton}" Content="{Binding WhatsNewTitle}"
                                            AutomationProperties.Name="What's New"
                                            ToolTip="What changed in this version and the ones before it"
                                            Command="{Binding ShowWhatsNewCommand}" />
                                    <Button Style="{StaticResource FlatButton}" Content="{Binding TakeTheTourTitle}"
                                            AutomationProperties.Name="Take the tour"
                                            ToolTip="Walks through what Sanduhr does, one step at a time"
                                            Command="{Binding ShowTourCommand}" />
                                </StackPanel>
                                <CheckBox Style="{StaticResource ThemedCheckBox}" Margin="0,10,0,0" DataContext="{Binding AboutVersion}"
                                          Content="{x:Static core:SettingsNames.HideWhatsNewAfterUpdates}"
                                          IsChecked="{Binding HideWhatsNewAfterUpdates, Mode=TwoWay}"
                                          AutomationProperties.Name="{x:Static core:SettingsNames.HideWhatsNewAfterUpdates}" />
                            </StackPanel>

                            <Border Height="1" Background="{DynamicResource Sanduhr.Brush.Border}" Margin="0,16,0,16" />

                            <views:TrademarkFooter views:SettingsAnchor.Id="trademark" />

                            <Border Height="1" Background="{DynamicResource Sanduhr.Brush.Border}" Margin="0,16,0,16" />

                            <StackPanel views:SettingsAnchor.Id="where">
                                <TextBlock Text="{Binding WhereSettingsLiveTitle}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Sanduhr.Brush.Text}" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Settings, history, themes" FontSize="12"
                                               VerticalAlignment="Center" Margin="0,0,12,6"
                                               Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SettingsFolder}" FontSize="11"
                                               FontFamily="Cascadia Code, Consolas" TextWrapping="Wrap"
                                               ToolTip="{Binding SettingsFolder}" VerticalAlignment="Center" Margin="0,0,8,6"
                                               Foreground="{DynamicResource Sanduhr.Brush.Text}" />
                                    <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource FlatButton}" Padding="10,4"
                                            Margin="0,0,0,6" Content="Show in Explorer"
                                            AutomationProperties.Name="Show in Explorer, settings, history and themes"
                                            Command="{Binding ShowInExplorerCommand}" CommandParameter="{Binding SettingsFolder}" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static core:SettingsNames.SessionArchive}" FontSize="12"
                                               VerticalAlignment="Center" Margin="0,0,12,6"
                                               Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                                    <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,6">
                                        <TextBlock Text="{Binding LocalFolder}" FontSize="11"
                                                   FontFamily="Cascadia Code, Consolas" TextWrapping="Wrap"
                                                   ToolTip="{Binding LocalFolder}"
                                                   Foreground="{DynamicResource Sanduhr.Brush.Text}" />
                                        <TextBlock Text="{x:Static core:SettingsNames.NothingArchivedYet}" FontSize="10.5" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource Sanduhr.Brush.TextDim}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEnabled, ElementName=VaultExplorerButton}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <Button x:Name="VaultExplorerButton" Grid.Row="1" Grid.Column="2" Style="{StaticResource FlatButton}" Padding="10,4"
                                            Margin="0,0,0,6" Content="Show in Explorer"
                                            AutomationProperties.Name="Show in Explorer, session archive"
                                            Command="{Binding ShowInExplorerCommand}" CommandParameter="{Binding LocalFolder}" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Claude Code files" FontSize="12"
                                               VerticalAlignment="Center" Margin="0,0,12,6"
                                               Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ClaudeCodeFilesFolder}" FontSize="11"
                                               FontFamily="Cascadia Code, Consolas" TextWrapping="Wrap"
                                               ToolTip="{Binding ClaudeCodeFilesFolder}" VerticalAlignment="Center" Margin="0,0,8,6"
                                               Foreground="{DynamicResource Sanduhr.Brush.Text}" />
                                    <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource FlatButton}" Padding="10,4"
                                            Margin="0,0,0,6" Content="Show in Explorer"
                                            AutomationProperties.Name="Show in Explorer, Claude Code files"
                                            Command="{Binding ShowInExplorerCommand}" CommandParameter="{Binding ClaudeCodeFilesFolder}" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Sign-in keys" FontSize="12"
                                               VerticalAlignment="Center" Margin="0,0,12,6"
                                               Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" FontSize="11" TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               Margin="0,0,0,6"
                                               Text="Windows Credential Manager, under com.626labs.sanduhr"
                                               Foreground="{DynamicResource Sanduhr.Brush.Text}" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Account profiles" FontSize="12"
                                               VerticalAlignment="Center" Margin="0,0,12,0"
                                               Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" FontSize="11" TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               Text="One browser profile per account Sanduhr checks while following, at %APPDATA%\Sanduhr\webview2-&lt;account_ref&gt;. Removing an account or resetting deletes its profile."
                                               Foreground="{DynamicResource Sanduhr.Brush.Text}" />
                                </Grid>
                                <StackPanel views:SettingsAnchor.Id="reset" Margin="0,12,0,0" HorizontalAlignment="Left">
                                    <Button Style="{StaticResource FlatButton}" Padding="10,4" Content="{Binding ResetSanduhrTitle}"
                                            AutomationProperties.Name="{x:Static core:SettingsNames.ResetSanduhr}" AutomationProperties.HelpText="Removes what Sanduhr keeps on this PC. You choose which parts."
                                            Command="{Binding ResetSanduhrCommand}" />
                                </StackPanel>
                            </StackPanel>

                            <Border Height="1" Background="{DynamicResource Sanduhr.Brush.Border}" Margin="0,16,0,16" />

                            <StackPanel views:SettingsAnchor.Id="notices">
                                <TextBlock Text="{Binding ThirdPartyNoticesTitle}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Sanduhr.Brush.Text}" Margin="0,0,0,8" />
                                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"
                                           Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}"
                                           Text="Sanduhr for Windows is built with these packages, each under its own license:" />
                                <ItemsControl ItemsSource="{Binding Packages}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Sanduhr.Brush.Text}" />
                                                <TextBlock Grid.Column="1" Text="{Binding License}" FontSize="11" VerticalAlignment="Center"
                                                           Margin="12,0,12,0" Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                                                <Button Grid.Column="2" Cursor="Hand" Content="Project page"
                                                        ToolTip="{Binding Url}"
                                                        AutomationProperties.Name="{Binding Name, StringFormat='{}{0} project page'}"
                                                        Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding Url}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="ring" BorderThickness="1" BorderBrush="Transparent" CornerRadius="3" Padding="2,0">
                                                                <TextBlock x:Name="t" Text="{TemplateBinding Content}" FontSize="11"
                                                                           Foreground="{DynamicResource Sanduhr.Brush.Accent}" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="t" Property="TextDecorations" Value="Underline" />
                                                                </Trigger>
                                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                                    <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource Sanduhr.Brush.Accent}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,12,0,8"
                                           Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}"
                                           Text="The Desk's weather piece shows data from these services, under their licences:" />
                                <ItemsControl ItemsSource="{Binding DataServices}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Sanduhr.Brush.Text}" />
                                                <TextBlock Grid.Column="1" Text="{Binding License}" FontSize="11" VerticalAlignment="Center"
                                                           Margin="12,0,12,0" Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                                                <Button Grid.Column="2" Cursor="Hand" Content="Project page"
                                                        ToolTip="{Binding Url}"
                                                        AutomationProperties.Name="{Binding Name, StringFormat='{}{0} project page'}"
                                                        Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding Url}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="ring" BorderThickness="1" BorderBrush="Transparent" CornerRadius="3" Padding="2,0">
                                                                <TextBlock x:Name="t" Text="{TemplateBinding Content}" FontSize="11"
                                                                           Foreground="{DynamicResource Sanduhr.Brush.Accent}" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="t" Property="TextDecorations" Value="Underline" />
                                                                </Trigger>
                                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                                    <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource Sanduhr.Brush.Accent}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,12,0,8"
                                           Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}"
                                           Text="The Desk draws in these fonts, which ship inside Sanduhr:" />
                                <ItemsControl ItemsSource="{Binding Fonts}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Name}" FontSize="12"
                                                           Foreground="{DynamicResource Sanduhr.Brush.Text}" />
                                                <TextBlock Text="{Binding Copyright}" FontSize="11" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                                                <TextBlock Text="{Binding License}" FontSize="11" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                        </ScrollViewer>
                    </Border>
                </TabItem>
            </controls:SidebarTabControl>
        </DockPanel>
    </Border>
</Window>
