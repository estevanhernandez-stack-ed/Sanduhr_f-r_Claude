<Window x:Class="Sanduhr.App.Modals.WebView2NotInstalledWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Microsoft WebView2 needed"
        Height="300" Width="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0d0d0d">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Microsoft WebView2 needed"
                   FontSize="18" FontWeight="Bold"
                   Foreground="#17d4fa" />

        <TextBlock Grid.Row="1"
                   Text="The in-app &quot;Sign in to Claude&quot; window uses Microsoft's WebView2 runtime. It's free and made by Microsoft, and most Windows 11 PCs already have it. Install it and try again — or close this and paste a sessionKey by hand instead."
                   TextWrapping="Wrap"
                   FontSize="12"
                   Foreground="#e8e4dc"
                   Opacity="0.85"
                   Margin="0,12,0,0" />

        <TextBlock x:Name="StatusText" Grid.Row="2"
                   Text="Finish the WebView2 install, then click Retry."
                   TextWrapping="Wrap" FontSize="12"
                   Foreground="#17d4fa" VerticalAlignment="Center"
                   Visibility="Collapsed"
                   Margin="0,12,0,0" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="PasteKeyButton" Content="Paste a key instead" Padding="16,8" Margin="0,0,8,0"
                    Background="#1c1c1c" Foreground="#e8e4dc" BorderBrush="#5A6982" BorderThickness="1"
                    Cursor="Hand"
                    Click="OnPasteKeyClick" />
            <Button x:Name="LearnMoreButton" Content="Learn More" Padding="16,8" Margin="0,0,8,0"
                    Background="#1c1c1c" Foreground="#e8e4dc" BorderBrush="#5A6982" BorderThickness="1"
                    Cursor="Hand"
                    Click="OnLearnMoreClick" />
            <Button x:Name="RetryButton" Content="Retry" Padding="16,8" Margin="0,0,8,0"
                    Background="#17d4fa" Foreground="#0d0d0d" BorderThickness="0"
                    FontWeight="Bold" Cursor="Hand" Visibility="Collapsed"
                    Click="OnRetryClick" />
            <Button x:Name="InstallButton" Content="Install Now" Padding="16,8" IsDefault="True"
                    Background="#17d4fa" Foreground="#0d0d0d" BorderThickness="0"
                    FontWeight="Bold" Cursor="Hand"
                    Click="OnInstallClick" />
        </StackPanel>
    </Grid>
</Window>
