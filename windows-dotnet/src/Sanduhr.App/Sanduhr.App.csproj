<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Sanduhr.Core\Sanduhr.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3912.50" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.275">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Auto-update for the GitHub/Velopack channel (Setup.exe + delta). VelopackApp.Build().Run()
         runs FIRST in Program.Main (before WPF) so install/uninstall/restart hooks fire; the
         in-app probe (Updates/UpdateChecker.cs) checks the GitHub release feed best-effort. -->
    <PackageReference Include="Velopack" Version="0.0.1298" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <!-- Window + tray glyph share the shipped Sanduhr.ico (parity with the Python
       build's bundled icon/Sanduhr.ico). Resource = embedded for WPF Window.Icon;
       ApplicationIcon stamps the .exe. -->
  <ItemGroup>
    <Resource Include="Assets\Sanduhr.ico" />
  </ItemGroup>

  <!-- Theme-builder agent prompt: embedded so the Settings "Copy agent prompt"
       button works in a packaged MSIX where the repo docs/ tree is absent.
       Read at runtime via Assembly.GetManifestResourceStream (see AgentPrompt.cs);
       the explicit LogicalName pins the resource id regardless of folder layout. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\AGENT_PROMPT.md">
      <LogicalName>Sanduhr.App.AGENT_PROMPT.md</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\Sanduhr.ico</ApplicationIcon>
    <AssemblyName>Sanduhr</AssemblyName>
    <RootNamespace>Sanduhr.App</RootNamespace>
    <!-- Custom entry point so VelopackApp.Build().Run() executes before WPF starts.
         Setting StartupObject suppresses the WPF-generated Main in App.g.cs (the build
         uses Program.Main instead). See Program.cs. -->
    <StartupObject>Sanduhr.App.Program</StartupObject>
    <!-- v3.4.0: the statusline/MCP snapshot seam (snapshot.json stamped with this
         writer_version), the opt-in vendor-agnostic Publish usage with per-home consent,
         and the publish_usage MCP handoff. v3.3.0 was the Fable release (model-scoped
         weekly limit bars from limits[], email-code sign-in for Google users, scoped-tier
         alert quieting, switch retry). v3.2.0 was the Claude Usage tab + usage vault. MSIX
         requires a 4-part version with the 4th component .0 (Partner Center rejects
         non-zero revisions). Keep these three in lockstep with <Identity Version> in
         Package.appxmanifest. -->
    <Version>3.4.2.0</Version>
    <AssemblyVersion>3.4.2.0</AssemblyVersion>
    <FileVersion>3.4.2.0</FileVersion>
  </PropertyGroup>

  <!-- MCP integration: the widget carries the sanduhr-mcp server build in its own
       output (mcp\) so the in-app installer has a source to copy from on every
       channel. ReferenceOutputAssembly=false keeps this a build-order + payload
       relationship only: the App never links the MCP assembly.

       Two copies exist. After a plain Build (dotnet build, F5) the server's
       framework-dependent output is copied next to the app; that needs a .NET
       runtime on the machine, which a dev box has. On Publish the server is
       published SELF-CONTAINED and single-file into $(PublishDir)mcp\, because
       the Store and Velopack app is self-contained and the user's machine has no
       runtime to run a framework-dependent sanduhr-mcp.exe. Files copied into
       $(OutDir) by a Build-time target never reach the publish output, so the
       publish copy is its own nested publish of the server project. -->
  <ItemGroup>
    <ProjectReference Include="..\Sanduhr.Mcp\Sanduhr.Mcp.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <Target Name="CopyMcpServerOutput" AfterTargets="Build" Condition="'$(_IsPublishing)' != 'true'">
    <MSBuild Projects="..\Sanduhr.Mcp\Sanduhr.Mcp.csproj" Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)" RemoveProperties="RuntimeIdentifier;SelfContained;PublishDir;OutDir;TargetFramework">
      <Output TaskParameter="TargetOutputs" ItemName="_McpTargetPath" />
    </MSBuild>
    <PropertyGroup>
      <_McpBinDir>@(_McpTargetPath->'%(RootDir)%(Directory)')</_McpBinDir>
    </PropertyGroup>
    <ItemGroup>
      <McpServerFiles Include="$(_McpBinDir)*.*" Exclude="$(_McpBinDir)*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(McpServerFiles)"
          DestinationFiles="@(McpServerFiles->'$(OutDir)mcp\%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
  <!-- Publish the server into the app payload. Its ship-shape (self-contained,
       trimmed, single-file) is declared in Sanduhr.Mcp.csproj under a runtime
       identifier, which the outer publish already passes down, so this is a plain
       nested Publish with a PublishDir. PublishReadyToRun is the App's own
       setting and must not leak into the server publish; TargetFramework and
       OutDir must not leak either. -->
  <Target Name="PublishMcpServer" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' != ''">
    <PropertyGroup>
      <_McpPublishDir>$([MSBuild]::EnsureTrailingSlash('$(PublishDir)'))mcp\</_McpPublishDir>
    </PropertyGroup>
    <MSBuild Projects="..\Sanduhr.Mcp\Sanduhr.Mcp.csproj" Targets="Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);PublishDir=$(_McpPublishDir);PublishReadyToRun=false;DebugType=None;DebugSymbols=false;Version=$(Version)"
             RemoveProperties="OutDir;TargetFramework;SelfContained;PublishSingleFile;PublishTrimmed" />
    <Error Condition="!Exists('$(_McpPublishDir)sanduhr-mcp.exe')"
           Text="sanduhr-mcp.exe missing from $(_McpPublishDir): the MCP server did not publish into the app payload." />
    <Message Importance="high" Text="sanduhr-mcp published self-contained into $(_McpPublishDir)" />
  </Target>

</Project>
