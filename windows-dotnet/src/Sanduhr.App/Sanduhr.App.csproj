<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Sanduhr.Core\Sanduhr.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3912.50" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.275">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Auto-update for the GitHub/Velopack channel (Setup.exe + delta). VelopackApp.Build().Run()
         runs FIRST in Program.Main (before WPF) so install/uninstall/restart hooks fire; the
         in-app probe (Updates/UpdateChecker.cs) checks the GitHub release feed best-effort. -->
    <PackageReference Include="Velopack" Version="0.0.1298" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <!-- Window + tray glyph share the shipped Sanduhr.ico (parity with the Python
       build's bundled icon/Sanduhr.ico). Resource = embedded for WPF Window.Icon;
       ApplicationIcon stamps the .exe. -->
  <ItemGroup>
    <Resource Include="Assets\Sanduhr.ico" />
  </ItemGroup>

  <!-- Theme-builder agent prompt: embedded so the Settings "Copy agent prompt"
       button works in a packaged MSIX where the repo docs/ tree is absent.
       Read at runtime via Assembly.GetManifestResourceStream (see AgentPrompt.cs);
       the explicit LogicalName pins the resource id regardless of folder layout. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\AGENT_PROMPT.md">
      <LogicalName>Sanduhr.App.AGENT_PROMPT.md</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\Sanduhr.ico</ApplicationIcon>
    <AssemblyName>Sanduhr</AssemblyName>
    <RootNamespace>Sanduhr.App</RootNamespace>
    <!-- Custom entry point so VelopackApp.Build().Run() executes before WPF starts.
         Setting StartupObject suppresses the WPF-generated Main in App.g.cs (the build
         uses Program.Main instead). See Program.cs. -->
    <StartupObject>Sanduhr.App.Program</StartupObject>
    <!-- v3.3.0: the Fable release — model-scoped weekly limit bars synthesized generically
         from the API's limits[] array (shipped the day before Fable went standard on Max),
         email-code sign-in walkthrough for Google users, scoped-tier alert quieting, switch
         retry. v3.2.0 was the Claude Usage tab + usage vault. MSIX requires a 4-part version
         with the 4th component .0 (Partner Center rejects non-zero revisions). Keep these
         three in lockstep with <Identity Version> in Package.appxmanifest. -->
    <Version>3.3.0.0</Version>
    <AssemblyVersion>3.3.0.0</AssemblyVersion>
    <FileVersion>3.3.0.0</FileVersion>
  </PropertyGroup>

</Project>
