<UserControl x:Class="Sanduhr.App.Desk.DeskReviewBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <!-- The live review's bar (spec, the agent-designed Desk): the design's name, Claude's note, what changed, any font to install
         with its link, and Apply / Dismiss. Themed by resource reference, so it reads in every widget theme, light or dark, and takes
         on the previewed theme. -->
    <UserControl.Resources>
        <Style x:Key="BarButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Sanduhr.Brush.Text}" />
            <Setter Property="Background" Value="{DynamicResource Sanduhr.Brush.Glass}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Sanduhr.Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18,7" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource Sanduhr.Brush.Text}" />
                                <Setter TargetName="bg" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BarPrimary" TargetType="Button" BasedOn="{StaticResource BarButton}">
            <Setter Property="Foreground" Value="{DynamicResource Sanduhr.Brush.Bg}" />
            <Setter Property="Background" Value="{DynamicResource Sanduhr.Brush.Accent}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>
    <Border x:Name="Frame" CornerRadius="14" BorderThickness="1" Padding="24,20,24,18"
            Background="{DynamicResource Sanduhr.Brush.Bg}"
            BorderBrush="{DynamicResource Sanduhr.Brush.Border}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.45" Color="Black" />
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="Heading" FontSize="11" FontWeight="SemiBold" Text="Claude suggests a Desk design"
                       Foreground="{DynamicResource Sanduhr.Brush.TextDim}" />
            <TextBlock x:Name="Title" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0"
                       Foreground="{DynamicResource Sanduhr.Brush.Text}" />
            <TextBlock x:Name="Note" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0"
                       Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
            <TextBlock x:Name="ChangesHeader" FontSize="12" FontWeight="SemiBold" Margin="0,14,0,4" Text="What changed"
                       Foreground="{DynamicResource Sanduhr.Brush.Text}" />
            <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" Focusable="False">
                <ItemsControl x:Name="Changes" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,3"
                                       AutomationProperties.Name="{Binding}"
                                       Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="Footer" FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"
                       Foreground="{DynamicResource Sanduhr.Brush.TextDim}" />
            <StackPanel x:Name="Fonts" Margin="0,10,0,0" Visibility="Collapsed" />
            <StackPanel x:Name="Warnings" Margin="0,8,0,0" Visibility="Collapsed" />
            <TextBlock x:Name="DeskOff" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0"
                       Visibility="Collapsed" Foreground="{DynamicResource Sanduhr.Brush.Accent}" />
            <CheckBox x:Name="OptionBox" Margin="0,12,0,0" IsChecked="True" Visibility="Collapsed" FontSize="12.5"
                      Foreground="{DynamicResource Sanduhr.Brush.Text}" />
            <TextBlock x:Name="Keys" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"
                       AutomationProperties.LiveSetting="Polite"
                       Foreground="{DynamicResource Sanduhr.Brush.TextDim}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="DismissButton" Style="{StaticResource BarButton}" Content="Dismiss" />
                <Button x:Name="EditButton" Style="{StaticResource BarButton}" Content="Edit" Visibility="Collapsed" />
                <Button x:Name="ApplyButton" Style="{StaticResource BarPrimary}" Content="Apply" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
