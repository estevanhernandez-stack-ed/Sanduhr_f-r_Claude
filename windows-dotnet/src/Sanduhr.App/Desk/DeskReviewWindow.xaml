<Window x:Class="Sanduhr.App.Desk.DeskReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:desk="clr-namespace:Sanduhr.App.Desk"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" ShowActivated="True"
        WindowStartupLocation="Manual">
    <!-- The floating bar of the live review: top center of the primary screen, above every window while a design previews. The margin
         leaves room for the bar's shadow. -->
    <Grid>
        <desk:DeskReviewBar x:Name="Bar" Margin="24" />
    </Grid>
</Window>
