<Window x:Class="Sanduhr.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:Sanduhr.App.Views"
        xmlns:vm="clr-namespace:Sanduhr.App.ViewModels"
        xmlns:conv="clr-namespace:Sanduhr.App.Converters"
        mc:Ignorable="d"
        Title="Sanduhr für Claude"
        d:DataContext="{d:DesignInstance vm:WidgetViewModel}"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="Transparent"
        Topmost="{Binding Pinned}"
        Width="420" Height="540"
        MinWidth="360" MinHeight="400"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        Icon="Assets/Sanduhr.ico">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome x:Name="Chrome"
                            CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:StringToVisibilityConverter x:Key="StrVis" />
        <BooleanToVisibilityConverter x:Key="BoolVis" />

        <!-- Flat chrome button: transparent, soft hover. -->
        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Sanduhr.Brush.Text}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="3,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- 6px rounded hover chip so the three chrome buttons read as
                             distinct, intentional pills against the glass title bar. -->
                        <Border x:Name="bg" CornerRadius="6" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
            <Setter Property="Width" Value="46" />
            <Setter Property="FontSize" Value="14" />
            <!-- Close stays as-is: full-height, flush far-right, square red hover. -->
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#C42B1C" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Keyboard: Ctrl+P toggles Deep Work focus mode (parity with widget.py). -->
    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="P" Command="{Binding ToggleFocusCommand}" />
    </Window.InputBindings>

    <!-- Root glass panel. On Win11 22H2+ this rides over Mica (semi-opaque
         obsidian so text stays legible); on older Windows it's the solid
         fallback (App switches the window background + this fill). -->
    <Border x:Name="RootBorder"
            CornerRadius="10"
            Background="{DynamicResource Sanduhr.Brush.GlassChrome}"
            BorderBrush="{DynamicResource Sanduhr.Brush.Border}"
            BorderThickness="1">
        <DockPanel LastChildFill="True">

            <!-- Accent gradient strip -->
            <Border DockPanel.Dock="Top" Height="2" CornerRadius="10,10,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="{DynamicResource Sanduhr.Color.Accent}" />
                        <GradientStop Offset="1" Color="{DynamicResource Sanduhr.Color.AccentFade}" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Title bar -->
            <Grid x:Name="TitleBar" DockPanel.Dock="Top" Height="34"
                  Background="{DynamicResource Sanduhr.Brush.TitleBg}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock Text="Sanduhr für Claude" VerticalAlignment="Center" Margin="12,0,0,0"
                               Foreground="{DynamicResource Sanduhr.Brush.Text}" FontSize="12"
                               ToolTip="Drag to move" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource ChromeButton}" Content="Settings"
                            Command="{Binding OpenSettingsCommand}" ToolTip="Open settings" />
                    <Button Style="{StaticResource ChromeButton}" Content="Refresh"
                            Command="{Binding RefreshCommand}" ToolTip="Refresh usage now" />
                    <Button Command="{Binding TogglePinCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ChromeButton}">
                                <Setter Property="Content" Value="Pin" />
                                <Setter Property="ToolTip" Value="Pin always on top" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Pinned}" Value="True">
                                        <Setter Property="Content" Value="Unpin" />
                                        <Setter Property="ToolTip" Value="Unpin (currently always on top)" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Style="{StaticResource CloseButton}" Content="&#x2715;"
                            Click="CloseButton_Click" ToolTip="Hide to tray" />
                </StackPanel>
            </Grid>

            <!-- Theme swatch area: a wrapping row of discreet name-entries below the
                 title bar. Each entry IS the theme name, rendered in the theme's accent
                 ink and its own font, with a thin accent underline as the only extra
                 color cue (active = bold + fuller underline). Click to switch instantly
                 (live re-tint + persisted to settings.json "theme" + soft chime).
                 Built-ins first, then user drop-ins. Compact: at 420px wide the names
                 wrap to ~2 short rows for the ~10 common themes, so no scrollbar shows.
                 If many user themes push past the cap, the slim themed scrollbar
                 (scoped in below) appears instead of the vanilla WPF one. Uses the
                 shared ThemeSwatchTemplate + the SAME Themes collection as
                 Settings → Themes, so the active highlight stays in sync. -->
            <Border x:Name="ThemesHeader" DockPanel.Dock="Top"
                    Background="{DynamicResource Sanduhr.Brush.TitleBg}"
                    Padding="6,2,4,4">
                <StackPanel>
                    <!-- Thin, full-width "Themes" disclosure header. Clicking toggles
                         the swatch grid below (ToggleThemesCommand → IsThemesExpanded,
                         persisted to settings.json "themes_expanded"). Subtle by design:
                         chevron + label in the muted/dim chrome inks, pointing-hand
                         cursor, faint hover chip. When collapsed it also shows the live
                         theme name ("Themes · Matrix"); that name hides once expanded. -->
                    <Button Command="{Binding ToggleThemesCommand}" Cursor="Hand"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            ToolTip="Show or hide the theme switcher"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="hdr" CornerRadius="5" Background="Transparent" Padding="6,3">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="chev" Text="&#x25B8;" FontSize="9"
                                                   VerticalAlignment="Center" Margin="0,0,6,0"
                                                   Foreground="{DynamicResource Sanduhr.Brush.TextMuted}" />
                                        <TextBlock Text="Themes" FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Sanduhr.Brush.TextDim}" />
                                        <TextBlock x:Name="activeName" VerticalAlignment="Center"
                                                   FontSize="11" Margin="6,0,0,0"
                                                   Foreground="{DynamicResource Sanduhr.Brush.TextMuted}">
                                            <Run Text="·&#160;" /><Run Text="{Binding ActiveThemeName, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="hdr" Property="Background" Value="#16FFFFFF" />
                                    </Trigger>
                                    <!-- Expanded: chevron points down, drop the redundant name. -->
                                    <DataTrigger Binding="{Binding IsThemesExpanded}" Value="True">
                                        <Setter TargetName="chev" Property="Text" Value="&#x25BE;" />
                                        <Setter TargetName="activeName" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Collapsible swatch grid: visibility bound to IsThemesExpanded. -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  MaxHeight="96" Margin="0,2,0,2"
                                  Visibility="{Binding IsThemesExpanded, Converter={StaticResource BoolVis}}">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimThemeScrollBar}" />
                        </ScrollViewer.Resources>
                        <ItemsControl ItemsSource="{Binding Themes}"
                                      ItemTemplate="{StaticResource ThemeSwatchTemplate}"
                                      shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- Footer -->
            <Grid DockPanel.Dock="Bottom" Height="26"
                  Background="{DynamicResource Sanduhr.Brush.FooterBg}">
                <TextBlock Text="{Binding FooterText}" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{DynamicResource Sanduhr.Brush.TextMuted}" FontSize="10" />
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                        Padding="8,2" CornerRadius="6"
                        Background="#22FFFFFF"
                        ToolTip="{Binding PlanTooltip}"
                        Visibility="{Binding HasPlanBadge, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
                    <TextBlock Text="{Binding PlanBadgeName}" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource Sanduhr.Brush.Accent}" />
                </Border>
            </Grid>

            <!-- Tool strip — Focus + Game affordances (port of widget.py's tool
                 strip between the cards and the footer). Docked above the footer.
                 AutomationProperties.Name set so screen readers + MS Store review
                 tooling read them (the v2.0.1 rejection lesson). -->
            <Border DockPanel.Dock="Bottom" Height="28"
                    Background="{DynamicResource Sanduhr.Brush.FooterBg}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Style="{StaticResource ChromeButton}" Content="Focus"
                            Command="{Binding ToggleFocusCommand}"
                            ToolTip="Deep Work focus timer (Ctrl+P)"
                            AutomationProperties.Name="Deep Work focus timer" />
                    <Button Style="{StaticResource ChromeButton}" Content="Game"
                            Command="{Binding StartGameCommand}"
                            ToolTip="Play the cooldown snake"
                            AutomationProperties.Name="Cooldown snake game" />
                </StackPanel>
            </Border>

            <!-- Content host: the cards scroller, the focus-mode hourglass (which
                 replaces the cards while active), and the snake overlay on top. -->
            <Grid x:Name="ContentHost">
            <ScrollViewer x:Name="CardsScroller"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="10,8">
                <StackPanel>
                    <!-- Active-account switcher (widget.py _account_btn parity): a flat
                         clickable label at the top of the content, above status + cards.
                         Shows the active account; ⇆-prefixed when 2+ accounts are
                         configured (the prefix signals a click cycles to the next one,
                         round-robin). Hidden when signed out; a plain non-interactive
                         label with a single account. Tray "Accounts ▸" and Settings →
                         Accounts remain the explicit pick-from-list surfaces. -->
                    <Button x:Name="AccountSwitcher"
                            Command="{Binding CycleAccountCommand}"
                            HorizontalAlignment="Left" Margin="2,2,2,6"
                            Visibility="{Binding AccountSwitcherText, Converter={StaticResource StrVis}}"
                            ToolTip="Active Claude account. Click to switch when multiple are configured (Settings → Accounts to add or remove).">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Foreground" Value="{DynamicResource Sanduhr.Brush.TextDim}" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Padding" Value="6,2" />
                                <Setter Property="FontSize" Value="10" />
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bg" CornerRadius="5"
                                                    Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}">
                                                <TextBlock Text="{Binding AccountSwitcherText}"
                                                           Foreground="{TemplateBinding Foreground}" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <!-- Subtle hover only when a click actually cycles. -->
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                                                        <Condition Binding="{Binding AccountSwitcherClickable}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter TargetName="bg" Property="Background" Value="#22FFFFFF" />
                                                </MultiDataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AccountSwitcherClickable}" Value="True">
                                        <Setter Property="Cursor" Value="Hand" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="2,2,2,6"
                               Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" FontSize="12"
                               Visibility="{Binding StatusText, Converter={StaticResource StrVis}}" />

                    <!-- Empty-state: first-run "Sign in to Claude" prompt (item 6).
                         Shown when there's no active account; the headline feature's
                         front door. The 626 cyan->magenta pairing on the accent. -->
                    <Border Margin="2,10,2,8" Padding="18,20" CornerRadius="10"
                            Background="{DynamicResource Sanduhr.Brush.CardGlass}"
                            BorderBrush="{DynamicResource Sanduhr.Brush.Border}"
                            BorderThickness="1"
                            Visibility="{Binding ShowSignInPrompt, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="14" Height="14" CornerRadius="7" Margin="0,0,0,12">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Offset="0" Color="#17d4fa" />
                                        <GradientStop Offset="1" Color="#f22f89" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <TextBlock Text="Track your Claude usage"
                                       FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Sanduhr.Brush.Text}" />
                            <TextBlock Text="Sign in once in a secure window. Sanduhr reads your usage automatically — no DevTools, no copy-paste."
                                       FontSize="11" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="280"
                                       Margin="0,6,0,16"
                                       Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                            <Button Command="{Binding SignInCommand}" Cursor="Hand"
                                    HorizontalAlignment="Center" Padding="22,9" FontSize="13" FontWeight="SemiBold"
                                    Foreground="#0d0d0d" BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bg" CornerRadius="8" Padding="{TemplateBinding Padding}"
                                                Background="{DynamicResource Sanduhr.Brush.Accent}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bg" Property="Opacity" Value="0.88" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                Sign in to Claude
                            </Button>
                            <Button Command="{Binding PasteKeyCommand}" Cursor="Hand" Content="Paste a key instead"
                                    HorizontalAlignment="Center" Margin="0,12,0,0"
                                    Background="Transparent" BorderThickness="0" FontSize="11"
                                    Foreground="{DynamicResource Sanduhr.Brush.TextDim}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <TextBlock Text="{TemplateBinding Content}"
                                                   TextDecorations="Underline"
                                                   Foreground="{TemplateBinding Foreground}" />
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>

                    <ItemsControl x:Name="TiersHost" ItemsSource="{Binding Tiers}"
                                  AllowDrop="True" Drop="Tiers_Drop">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <views:TierCard />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

                <!-- Focus mode: replaces the cards while active (hidden otherwise). -->
                <views:FocusTimer x:Name="FocusView" Visibility="Collapsed" />

                <!-- Cooldown snake: overlays everything while playing. -->
                <views:CooldownGame x:Name="GameView" Visibility="Collapsed" />
            </Grid>
        </DockPanel>
    </Border>
</Window>
