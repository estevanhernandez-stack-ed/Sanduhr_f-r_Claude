<Window x:Class="Sanduhr.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:Sanduhr.App.Views"
        xmlns:vm="clr-namespace:Sanduhr.App.ViewModels"
        xmlns:conv="clr-namespace:Sanduhr.App.Converters"
        mc:Ignorable="d"
        Title="Sanduhr für Claude"
        d:DataContext="{d:DesignInstance vm:WidgetViewModel}"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="Transparent"
        Topmost="{Binding Pinned}"
        Width="420" Height="540"
        MinWidth="360" MinHeight="400"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        Icon="Assets/Sanduhr.ico">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome x:Name="Chrome"
                            CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:StringToVisibilityConverter x:Key="StrVis" />
        <BooleanToVisibilityConverter x:Key="BoolVis" />

        <!-- Flat chrome button: transparent, soft hover. -->
        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Sanduhr.Brush.Text}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="3,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- 6px rounded hover chip so the three chrome buttons read as
                             distinct, intentional pills against the glass title bar. -->
                        <Border x:Name="bg" CornerRadius="6" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
            <Setter Property="Width" Value="46" />
            <Setter Property="FontSize" Value="14" />
            <!-- Close stays as-is: full-height, flush far-right, square red hover. -->
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#C42B1C" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bottom-strip icon button: a single glyph that lifts (translate up) and gets
             a soft rounded hover chip on mouse-over. Icon-only, so every instance MUST
             carry both AutomationProperties.Name and ToolTip (MS Store accessibility),
             and IsHitTestVisibleInChrome=True or WindowChrome treats the click as a drag. -->
        <Style x:Key="IconStripButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="FontFamily" Value="Segoe UI Emoji" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource Sanduhr.Brush.Text}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="0" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="chip" CornerRadius="6" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chip" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 To="-3" Duration="0:0:0.10" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 To="0" Duration="0:0:0.10" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Keyboard: Ctrl+P toggles Deep Work focus mode (parity with widget.py). -->
    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="P" Command="{Binding ToggleFocusCommand}" />
        <KeyBinding Modifiers="Control" Key="D" Command="{Binding ToggleCompactCommand}" />
    </Window.InputBindings>

    <!-- Root glass panel. On Win11 22H2+ this rides over Mica (semi-opaque
         obsidian so text stays legible); on older Windows it's the solid
         fallback (App switches the window background + this fill). -->
    <Border x:Name="RootBorder"
            CornerRadius="10"
            Background="{DynamicResource Sanduhr.Brush.GlassChrome}"
            BorderBrush="{DynamicResource Sanduhr.Brush.Border}"
            BorderThickness="1">
        <DockPanel LastChildFill="True">

            <!-- Accent gradient strip -->
            <Border DockPanel.Dock="Top" Height="2" CornerRadius="10,10,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="{DynamicResource Sanduhr.Color.Accent}" />
                        <GradientStop Offset="1" Color="{DynamicResource Sanduhr.Color.AccentFade}" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Title bar -->
            <Grid x:Name="TitleBar" DockPanel.Dock="Top" Height="34"
                  Background="{DynamicResource Sanduhr.Brush.TitleBg}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock Text="Sanduhr für Claude" VerticalAlignment="Center" Margin="12,0,0,0"
                               Foreground="{DynamicResource Sanduhr.Brush.Text}" FontSize="12"
                               ToolTip="Drag to move" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- Settings / Refresh / Pin moved to the bottom icon strip; only the
                         close (tray-hide) affordance stays in the title bar. -->
                    <Button Style="{StaticResource CloseButton}" Content="&#x2715;"
                            Click="CloseButton_Click" ToolTip="Hide to tray" />
                </StackPanel>
            </Grid>

            <!-- Footer -->
            <Grid DockPanel.Dock="Bottom" Height="26"
                  Background="{DynamicResource Sanduhr.Brush.FooterBg}">
                <TextBlock Text="{Binding FooterText}" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{DynamicResource Sanduhr.Brush.TextMuted}" FontSize="10" />
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                        Padding="8,2" CornerRadius="6"
                        Background="#22FFFFFF"
                        ToolTip="{Binding PlanTooltip}"
                        Visibility="{Binding HasPlanBadge, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
                    <TextBlock Text="{Binding PlanBadgeName}" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource Sanduhr.Brush.Accent}" />
                </Border>
            </Grid>

            <!-- Bottom icon strip — the consolidated toolbar (Theme, Settings, Graph,
                 Compact, Focus, Snake, Refresh, Pin). Quiet (dim) at rest, brightens on
                 hover; each icon also lifts on its own hover (IconStripButton). Docked
                 above the footer. Theme opens the swatch flyout; Graph/Pin swap on state.
                 Every icon carries AutomationProperties.Name + ToolTip (MS Store) and
                 IsHitTestVisibleInChrome (via the shared style). -->
            <Border x:Name="BottomIconStrip" DockPanel.Dock="Bottom" Height="34"
                    Background="{DynamicResource Sanduhr.Brush.FooterBg}"
                    Opacity="0.6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.14" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.6" Duration="0:0:0.14" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="ThemeIconButton" Style="{StaticResource IconStripButton}"
                            Content="🎨"
                            PreviewMouseLeftButtonDown="ThemeIconButton_PreviewMouseLeftButtonDown"
                            Click="ThemeIconButton_Click"
                            ToolTip="{Binding ActiveThemeName, StringFormat='Theme: {0} (click to switch)'}"
                            AutomationProperties.Name="Theme switcher" />
                    <Popup x:Name="ThemePopup" PlacementTarget="{Binding ElementName=ThemeIconButton}"
                           Placement="Top" StaysOpen="False" AllowsTransparency="True"
                           IsOpen="{Binding IsThemesExpanded, Mode=TwoWay}">
                        <Border CornerRadius="10" Background="{DynamicResource Sanduhr.Brush.GlassChrome}"
                                BorderBrush="{DynamicResource Sanduhr.Brush.Border}" BorderThickness="1"
                                Padding="6" Width="264" Margin="0,0,0,6">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          MaxHeight="200">
                                <ScrollViewer.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimThemeScrollBar}" />
                                </ScrollViewer.Resources>
                                <ItemsControl ItemsSource="{Binding Themes}"
                                              ItemTemplate="{StaticResource ThemeSwatchTemplate}"
                                              shell:WindowChrome.IsHitTestVisibleInChrome="True">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Popup>

                    <Button Style="{StaticResource IconStripButton}" Content="⚙"
                            Command="{Binding OpenSettingsCommand}"
                            ToolTip="Settings" AutomationProperties.Name="Settings" />

                    <Button Command="{Binding CycleSparklineStyleCommand}"
                            AutomationProperties.Name="Cycle graph style">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconStripButton}">
                                <Setter Property="Content" Value="📊" />
                                <Setter Property="ToolTip" Value="Graph: classic line (click to cycle)" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SparklineStyle}" Value="Horizon">
                                        <Setter Property="Content" Value="📈" />
                                        <Setter Property="ToolTip" Value="Graph: horizon bands (click to cycle)" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Style="{StaticResource IconStripButton}" Content="↕"
                            Command="{Binding ToggleCompactCommand}"
                            ToolTip="Compact mode (Ctrl+D)" AutomationProperties.Name="Compact mode" />

                    <Button Style="{StaticResource IconStripButton}" Content="⏳"
                            Command="{Binding ToggleFocusCommand}"
                            ToolTip="Deep Work focus timer (Ctrl+P)"
                            AutomationProperties.Name="Deep Work focus timer" />

                    <Button Style="{StaticResource IconStripButton}" Content="🐍"
                            Command="{Binding StartGameCommand}"
                            ToolTip="Cooldown snake game" AutomationProperties.Name="Cooldown snake game" />

                    <Button Style="{StaticResource IconStripButton}" Content="🔄"
                            Command="{Binding RefreshCommand}"
                            ToolTip="Refresh usage now" AutomationProperties.Name="Refresh usage" />

                    <Button Command="{Binding TogglePinCommand}"
                            AutomationProperties.Name="Pin on top">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconStripButton}">
                                <Setter Property="Content" Value="📌" />
                                <Setter Property="ToolTip" Value="Pin always on top" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Pinned}" Value="True">
                                        <Setter Property="ToolTip" Value="Unpin (currently always on top)" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Content host: the cards scroller, the focus-mode hourglass (which
                 replaces the cards while active), and the snake overlay on top. -->
            <Grid x:Name="ContentHost">
            <ScrollViewer x:Name="CardsScroller"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="10,8">
                <StackPanel>
                    <!-- Active-account switcher (widget.py _account_btn parity): a flat
                         clickable label at the top of the content, above status + cards.
                         Shows the active account; ⇆-prefixed when 2+ accounts are
                         configured (the prefix signals a click cycles to the next one,
                         round-robin). Hidden when signed out; a plain non-interactive
                         label with a single account. Tray "Accounts ▸" and Settings →
                         Accounts remain the explicit pick-from-list surfaces. -->
                    <Button x:Name="AccountSwitcher"
                            Command="{Binding CycleAccountCommand}"
                            HorizontalAlignment="Left" Margin="2,2,2,6"
                            Visibility="{Binding AccountSwitcherText, Converter={StaticResource StrVis}}"
                            ToolTip="Active Claude account. Click to switch when multiple are configured (Settings → Accounts to add or remove).">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Foreground" Value="{DynamicResource Sanduhr.Brush.TextDim}" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Padding" Value="6,2" />
                                <Setter Property="FontSize" Value="10" />
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bg" CornerRadius="5"
                                                    Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}">
                                                <TextBlock Text="{Binding AccountSwitcherText}"
                                                           Foreground="{TemplateBinding Foreground}" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <!-- Subtle hover only when a click actually cycles. -->
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                                                        <Condition Binding="{Binding AccountSwitcherClickable}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter TargetName="bg" Property="Background" Value="#22FFFFFF" />
                                                </MultiDataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AccountSwitcherClickable}" Value="True">
                                        <Setter Property="Cursor" Value="Hand" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="2,2,2,6"
                               Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" FontSize="12"
                               Visibility="{Binding StatusText, Converter={StaticResource StrVis}}" />

                    <!-- Empty-state: first-run "Sign in to Claude" prompt (item 6).
                         Shown when there's no active account; the headline feature's
                         front door. The 626 cyan->magenta pairing on the accent. -->
                    <Border Margin="2,10,2,8" Padding="18,20" CornerRadius="10"
                            Background="{DynamicResource Sanduhr.Brush.CardGlass}"
                            BorderBrush="{DynamicResource Sanduhr.Brush.Border}"
                            BorderThickness="1"
                            Visibility="{Binding ShowSignInPrompt, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="14" Height="14" CornerRadius="7" Margin="0,0,0,12">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Offset="0" Color="#17d4fa" />
                                        <GradientStop Offset="1" Color="#f22f89" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <TextBlock Text="{Binding PromptHeadline}"
                                       FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Sanduhr.Brush.Text}" />
                            <TextBlock Text="{Binding PromptSubtitle}"
                                       FontSize="11" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="280"
                                       Margin="0,6,0,16"
                                       Foreground="{DynamicResource Sanduhr.Brush.TextSecondary}" />
                            <Button Command="{Binding PrimaryAuthCommand}" Content="{Binding PromptPrimaryLabel}" Cursor="Hand"
                                    HorizontalAlignment="Center" Padding="22,9" FontSize="13" FontWeight="SemiBold"
                                    Foreground="#0d0d0d" BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bg" CornerRadius="8" Padding="{TemplateBinding Padding}"
                                                Background="{DynamicResource Sanduhr.Brush.Accent}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bg" Property="Opacity" Value="0.88" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Command="{Binding PasteKeyCommand}" Cursor="Hand" Content="Paste a key instead"
                                    HorizontalAlignment="Center" Margin="0,12,0,0"
                                    Background="Transparent" BorderThickness="0" FontSize="11"
                                    Foreground="{DynamicResource Sanduhr.Brush.TextDim}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <TextBlock Text="{TemplateBinding Content}"
                                                   TextDecorations="Underline"
                                                   Foreground="{TemplateBinding Foreground}" />
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>

                    <ItemsControl x:Name="TiersHost" ItemsSource="{Binding Tiers}"
                                  AllowDrop="True" Drop="Tiers_Drop">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <views:TierCard />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

                <!-- Focus mode: replaces the cards while active (hidden otherwise). -->
                <views:FocusTimer x:Name="FocusView" Visibility="Collapsed" />

                <!-- Cooldown snake: overlays everything while playing. -->
                <views:CooldownGame x:Name="GameView" Visibility="Collapsed" />
            </Grid>
        </DockPanel>
    </Border>
</Window>
