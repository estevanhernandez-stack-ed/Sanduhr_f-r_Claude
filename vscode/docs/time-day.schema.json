{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sanduhr.dev/schemas/time-day.v1.json",
  "title": "Sanduhr Time day file, v1",
  "description": "days/<date>.json as the merger emits it. All durations are integer milliseconds.",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "date", "machine", "generatedAt", "totals", "projects", "caveats"],
  "properties": {
    "v": { "const": 1 },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "Local calendar date." },
    "machine": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "totals": { "$ref": "#/definitions/totals" },
    "projects": { "type": "array", "items": { "$ref": "#/definitions/project" } },
    "caveats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unreadableTranscriptLines", "readerVersion", "claudeCodeVersions"],
      "properties": {
        "unreadableTranscriptLines": { "type": "integer", "minimum": 0 },
        "readerVersion": { "type": "string", "minLength": 1 },
        "claudeCodeVersions": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "definitions": {
    "ms": { "type": "integer", "minimum": 0 },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["youMs", "claudeMs", "bothMs", "totalMs", "agentMs", "linesYou", "linesClaude"],
      "properties": {
        "youMs": { "$ref": "#/definitions/ms" },
        "claudeMs": { "$ref": "#/definitions/ms" },
        "bothMs": { "$ref": "#/definitions/ms" },
        "totalMs": { "$ref": "#/definitions/ms" },
        "agentMs": { "$ref": "#/definitions/ms" },
        "linesYou": { "type": "integer", "minimum": 0 },
        "linesClaude": { "type": "integer", "minimum": 0 }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key", "realName", "alias", "masked",
        "youMs", "claudeMs", "bothMs", "totalMs", "agentMs",
        "linesYou", "linesClaude", "languages"
      ],
      "properties": {
        "key": { "type": "string", "pattern": "^([0-9a-f]{16}|none)$" },
        "realName": { "type": "string", "minLength": 1 },
        "alias": { "type": ["string", "null"] },
        "masked": { "type": "boolean" },
        "youMs": { "$ref": "#/definitions/ms" },
        "claudeMs": { "$ref": "#/definitions/ms" },
        "bothMs": { "$ref": "#/definitions/ms" },
        "totalMs": { "$ref": "#/definitions/ms" },
        "agentMs": { "$ref": "#/definitions/ms" },
        "linesYou": { "type": "integer", "minimum": 0 },
        "linesClaude": { "type": "integer", "minimum": 0 },
        "languages": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "ms"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "ms": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  }
}
